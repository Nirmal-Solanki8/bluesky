<%- include('layouts/header') %>

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
  <div>
    <h1 class="font-serif text-white display-6 fw-bold mb-1">Client Reviews & Testimonials</h1>
    <p class="text-muted small mb-0">Manage high-net-worth client endorsements, star ratings & public visibility</p>
  </div>
</div>

<!-- Add Testimonial Card -->
<div class="admin-card mb-4">
  <div class="admin-card-header">
    <h3 class="admin-card-title mb-0">
      <i class="bi bi-plus-circle-fill text-gold me-2"></i> Add Client Endorsement
    </h3>
  </div>

  <form action="/admin/testimonials" method="POST">
    <div class="row g-3 mb-3">
      <div class="col-md-5">
        <label class="luxury-label">Client Name *</label>
        <input type="text" name="clientName" class="admin-input" placeholder="e.g. Rajesh & Meena Shah" required>
      </div>

      <div class="col-md-4">
        <label class="luxury-label">Designation / Role</label>
        <input type="text" name="designation" class="admin-input" placeholder="Private Villa Owner" value="Private Villa Owner">
      </div>

      <div class="col-md-3">
        <label class="luxury-label">Location (City / Area)</label>
        <input type="text" name="location" class="admin-input" placeholder="Katargam, Surat">
      </div>
    </div>

    <div class="row g-3 mb-3 align-items-center">
      <div class="col-md-4">
        <label class="luxury-label">Star Rating (1 to 5)</label>
        <select name="rating" class="admin-select">
          <option value="5" selected>⭐⭐⭐⭐⭐ (5 Stars - Luxury Standard)</option>
          <option value="4">⭐⭐⭐⭐ (4 Stars)</option>
          <option value="3">⭐⭐⭐ (3 Stars)</option>
          <option value="2">⭐⭐ (2 Stars)</option>
          <option value="1">⭐ (1 Star)</option>
        </select>
      </div>

      <div class="col-md-8 pt-md-4">
        <label class="d-flex align-items-center gap-2 text-white small fw-bold cursor-pointer">
          <input type="checkbox" name="isApproved" checked class="form-check-input" style="background-color: rgba(8,11,16,0.8); border-color: #D4AF37;">
          <span>Show Publicly on Website Testimonials Section (Approved)</span>
        </label>
      </div>
    </div>

    <div class="mb-4">
      <label class="luxury-label">Client Review / Testimonial Text *</label>
      <textarea name="review" rows="3" class="admin-textarea" placeholder="Detailed feedback regarding architectural design, construction speed, monolithic RCC quality, water filtration, and turnover care..." required></textarea>
    </div>

    <button type="submit" class="admin-btn-gold">
      <i class="bi bi-check2-circle"></i> Save Client Review
    </button>
  </form>
</div>

<!-- Testimonials Table in Dark Glass Panel -->
<div class="admin-card">
  <div class="admin-card-header">
    <h3 class="admin-card-title mb-0">
      <i class="bi bi-chat-quote text-gold me-2"></i> Client Reviews (<%= (typeof testimonials !== 'undefined' && testimonials) ? testimonials.length : 0 %>)
    </h3>
  </div>

  <div class="admin-table-responsive">
    <table class="admin-table">
      <thead>
        <tr>
          <th>Client</th>
          <th>Designation</th>
          <th>Location</th>
          <th>Rating</th>
          <th>Review</th>
          <th>Status</th>
          <th class="text-end">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if (testimonials && testimonials.length > 0) { %>
          <% testimonials.forEach(t => { %>
            <tr>
              <td>
                <strong class="text-white"><%= t.clientName %></strong>
              </td>
              <td class="text-muted small"><%= t.designation %></td>
              <td>
                <span class="text-muted small"><i class="bi bi-geo-alt text-gold me-1"></i><%= t.location || '-' %></span>
              </td>
              <td class="text-gold">
                <% for (let i = 0; i < t.rating; i++) { %>
                  <i class="bi bi-star-fill small"></i>
                <% } %>
              </td>
              <td class="text-muted small" style="max-width: 300px; line-height: 1.5;">
                "<%= t.review %>"
              </td>
              <td>
                <% if (t.isApproved) { %>
                  <span class="admin-badge badge-completed">Approved</span>
                <% } else { %>
                  <span class="admin-badge badge-pending">Pending</span>
                <% } %>
              </td>
              <td class="text-end">
                <div class="d-inline-flex gap-2">
                  <a href="/admin/testimonials/<%= t._id %>/edit" class="btn btn-sm btn-outline-warning" style="border-radius: var(--admin-radius-pill); font-size: 0.78rem;">
                    <i class="bi bi-pencil"></i> Edit
                  </a>
                  <form action="/admin/testimonials/<%= t._id %>/delete" method="POST" onsubmit="return confirm('Delete this testimonial?');" style="display: inline;">
                    <button type="submit" class="btn btn-sm btn-outline-danger" style="border-radius: var(--admin-radius-pill); font-size: 0.78rem;">
                      <i class="bi bi-trash"></i>
                    </button>
                  </form>
                </div>
              </td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr>
            <td colspan="7" class="text-center py-4 text-muted">
              No client reviews added yet. Use the form above to add your first customer review!
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<%- include('layouts/footer') %>
