<%- include('layouts/header') %>

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
  <div>
    <h1 class="font-serif text-white display-6 fw-bold mb-1">Company & Brand Settings</h1>
    <p class="text-muted small mb-0">Update executive contact channels, Surat studio address, company statistics, and brand identity</p>
  </div>
</div>

<div class="admin-card" style="max-width: 980px;">
  <form action="/admin/settings" method="POST">
    
    <!-- 1. Brand Identity -->
    <div class="d-flex align-items-center gap-2 mb-3 pb-2 border-bottom border-secondary border-opacity-25">
      <i class="bi bi-building text-gold fs-5"></i>
      <h4 class="font-serif text-white mb-0" style="font-size: 1.15rem;">Brand Identity & Tagline</h4>
    </div>

    <div class="row g-3 mb-4">
      <div class="col-md-6">
        <label class="luxury-label">Company Legal Name *</label>
        <input type="text" name="companyName" class="admin-input" value="<%= settings.companyName %>" required>
      </div>

      <div class="col-md-6">
        <label class="luxury-label">Primary Executive Email *</label>
        <input type="email" name="email" class="admin-input" value="<%= settings.email %>" required>
      </div>

      <div class="col-12">
        <label class="luxury-label">Brand Philosophy & Hero Tagline</label>
        <input type="text" name="tagline" class="admin-input" value="<%= settings.tagline %>">
      </div>
    </div>

    <!-- 2. Studio Contact & Address -->
    <div class="d-flex align-items-center gap-2 mb-3 pb-2 border-bottom border-secondary border-opacity-25">
      <i class="bi bi-geo-alt text-gold fs-5"></i>
      <h4 class="font-serif text-white mb-0" style="font-size: 1.15rem;">Surat Studio & Direct Concierge Numbers</h4>
    </div>

    <div class="row g-3 mb-4">
      <div class="col-md-6">
        <label class="luxury-label">Direct Studio Phone *</label>
        <input type="text" name="phone" class="admin-input" value="<%= settings.phone %>" required>
      </div>

      <div class="col-md-6">
        <label class="luxury-label">WhatsApp Concierge Mobile *</label>
        <input type="text" name="whatsapp" class="admin-input" value="<%= settings.whatsapp %>" required>
      </div>

      <div class="col-12">
        <label class="luxury-label">Registered Corporate Studio Address</label>
        <textarea name="address" rows="2" class="admin-textarea"><%= settings.address %></textarea>
      </div>
    </div>

    <!-- 3. Experience & Live Metrics -->
    <div class="d-flex align-items-center gap-2 mb-3 pb-2 border-bottom border-secondary border-opacity-25">
      <i class="bi bi-graph-up-arrow text-gold fs-5"></i>
      <h4 class="font-serif text-white mb-0" style="font-size: 1.15rem;">Verified Experience & Statistics</h4>
    </div>

    <div class="row g-3 mb-4">
      <div class="col-6 col-md-3">
        <label class="luxury-label">Years of Mastery (Auto)</label>
        <input type="number" name="experienceYears" class="admin-input" value="<%= settings.experienceYears || (new Date().getFullYear() - 2008) %>">
        <span class="text-gold small d-block mt-1" style="font-size: 0.72rem;">
          <i class="bi bi-magic me-1"></i> Auto-Increments yearly (Est. 2008 = <%= new Date().getFullYear() - 2008 %>+ yrs)
        </span>
      </div>

      <div class="col-6 col-md-3">
        <label class="luxury-label">Pools Built</label>
        <input type="number" name="poolsBuilt" class="admin-input" value="<%= settings.poolsBuilt || 720 %>">
      </div>

      <div class="col-6 col-md-3">
        <label class="luxury-label">Happy Clients</label>
        <input type="number" name="happyClients" class="admin-input" value="<%= settings.happyClients || 680 %>">
      </div>

      <div class="col-6 col-md-3">
        <label class="luxury-label">Active AMC Contracts</label>
        <input type="number" name="maintenanceContracts" class="admin-input" value="<%= settings.maintenanceContracts || 120 %>">
      </div>
    </div>

    <!-- 4. Social Handles -->
    <div class="d-flex align-items-center gap-2 mb-3 pb-2 border-bottom border-secondary border-opacity-25">
      <i class="bi bi-share text-gold fs-5"></i>
      <h4 class="font-serif text-white mb-0" style="font-size: 1.15rem;">Social Media & Channels</h4>
    </div>

    <div class="row g-3 mb-4">
      <div class="col-md-4">
        <label class="luxury-label">Instagram Profile URL</label>
        <input type="text" name="instagram" class="admin-input" value="<%= settings.instagram || '#' %>">
      </div>

      <div class="col-md-4">
        <label class="luxury-label">Facebook Profile URL</label>
        <input type="text" name="facebook" class="admin-input" value="<%= settings.facebook || '#' %>">
      </div>

      <div class="col-md-4">
        <label class="luxury-label">LinkedIn Company URL</label>
        <input type="text" name="linkedin" class="admin-input" value="<%= settings.linkedin || '#' %>">
      </div>
    </div>

    <button type="submit" class="admin-btn-gold">
      <i class="bi bi-save2"></i> Update Brand Settings
    </button>
  </form>
</div>

<!-- 5. Executive Admin Security & Change Password Card -->
<div class="admin-card mt-4" style="max-width: 980px;">
  <div class="d-flex align-items-center gap-2 mb-3 pb-2 border-bottom border-secondary border-opacity-25">
    <i class="bi bi-shield-lock-fill text-gold fs-5"></i>
    <div>
      <h4 class="font-serif text-white mb-0" style="font-size: 1.15rem;">Admin Account Security & Password</h4>
      <p class="text-muted small mb-0">Update executive login credentials, admin name, or change your secret password</p>
    </div>
  </div>

  <form action="/admin/settings/password" method="POST">
    <!-- Admin Name & Email -->
    <div class="row g-3 mb-4">
      <div class="col-md-6">
        <label class="luxury-label">Executive Admin Name *</label>
        <input type="text" name="name" class="admin-input" value="<%= (typeof adminUser !== 'undefined' && adminUser && adminUser.name) ? adminUser.name : (admin ? admin.name : 'Pritesh (Principal)') %>" required>
      </div>

      <div class="col-md-6">
        <label class="luxury-label">Login Email Address *</label>
        <input type="email" name="email" class="admin-input" value="<%= (typeof adminUser !== 'undefined' && adminUser && adminUser.email) ? adminUser.email : (admin ? admin.email : 'pritesh029@gmail.com') %>" required>
      </div>
    </div>

    <!-- Password Change Group -->
    <div class="p-3 p-md-4 rounded-3 mb-4" style="background: rgba(8, 11, 16, 0.6); border: 1px solid rgba(212, 175, 55, 0.2);">
      <div class="d-flex align-items-center gap-2 text-gold fw-semibold small mb-3">
        <i class="bi bi-key-fill"></i>
        <span>Change Admin Password (Leave blank if keeping current password)</span>
      </div>

      <div class="row g-3">
        <div class="col-md-4">
          <label class="luxury-label">Current Password</label>
          <input type="password" name="currentPassword" class="admin-input" placeholder="Enter current password" autocomplete="current-password">
        </div>

        <div class="col-md-4">
          <label class="luxury-label">New Password (Min 6 chars)</label>
          <input type="password" name="newPassword" class="admin-input" placeholder="Enter new password" autocomplete="new-password">
        </div>

        <div class="col-md-4">
          <label class="luxury-label">Confirm New Password</label>
          <input type="password" name="confirmPassword" class="admin-input" placeholder="Confirm new password" autocomplete="new-password">
        </div>
      </div>
    </div>

    <button type="submit" class="admin-btn-gold">
      <i class="bi bi-shield-check"></i> Save Security & Password
    </button>
  </form>
</div>

<%- include('layouts/footer') %>
