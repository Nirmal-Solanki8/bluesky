<%- include('layouts/header') %>

<div class="page-title-box">
  <div>
    <h1>Website Settings & Business Info</h1>
    <p style="color: var(--admin-text-muted); font-size: 0.9rem;">Update contact numbers, office address, statistics, tagline, and social media handles</p>
  </div>
</div>

<div class="admin-form-card" style="max-width: 960px;">
  <form action="/admin/settings" method="POST">
    <!-- Basic Company Info -->
    <h3 style="margin-bottom: 20px; font-size: 1.15rem; color: #0f172a; border-bottom: 1px solid var(--admin-border); padding-bottom: 10px;">
      <i class="fa-solid fa-building" style="color: #0284c7; margin-right: 8px;"></i> Company Identity & Tagline
    </h3>

    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
      <div class="admin-form-group">
        <label>Company Name *</label>
        <input type="text" name="companyName" class="admin-form-control" value="<%= settings.companyName %>" required>
      </div>

      <div class="admin-form-group">
        <label>Primary Email Address *</label>
        <input type="email" name="email" class="admin-form-control" value="<%= settings.email %>" required>
      </div>
    </div>

    <div class="admin-form-group">
      <label>Hero Tagline / Slogan</label>
      <input type="text" name="tagline" class="admin-form-control" value="<%= settings.tagline %>">
    </div>

    <!-- Contact & Address -->
    <h3 style="margin: 30px 0 20px; font-size: 1.15rem; color: #0f172a; border-bottom: 1px solid var(--admin-border); padding-bottom: 10px;">
      <i class="fa-solid fa-phone" style="color: #10b981; margin-right: 8px;"></i> Contact Numbers & Office Address
    </h3>

    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
      <div class="admin-form-group">
        <label>Direct Phone / Call Number *</label>
        <input type="text" name="phone" class="admin-form-control" value="<%= settings.phone %>" required>
      </div>

      <div class="admin-form-group">
        <label>WhatsApp Number *</label>
        <input type="text" name="whatsapp" class="admin-form-control" value="<%= settings.whatsapp %>" required>
      </div>
    </div>

    <div class="admin-form-group">
      <label>Full Office / Studio Address</label>
      <textarea name="address" rows="2" class="admin-form-control"><%= settings.address %></textarea>
    </div>

    <!-- Counters & Experience Statistics -->
    <h3 style="margin: 30px 0 20px; font-size: 1.15rem; color: #0f172a; border-bottom: 1px solid var(--admin-border); padding-bottom: 10px;">
      <i class="fa-solid fa-chart-line" style="color: #f59e0b; margin-right: 8px;"></i> Experience & Counters (Shown on Home & About)
    </h3>

    <div style="display: grid; grid-template-columns: 1fr 1fr 1fr 1fr; gap: 15px;">
      <div class="admin-form-group">
        <label>Years of Exp.</label>
        <input type="number" name="experienceYears" class="admin-form-control" value="<%= settings.experienceYears || 16 %>">
      </div>

      <div class="admin-form-group">
        <label>Pools Built</label>
        <input type="number" name="poolsBuilt" class="admin-form-control" value="<%= settings.poolsBuilt || 650 %>">
      </div>

      <div class="admin-form-group">
        <label>Happy Clients</label>
        <input type="number" name="happyClients" class="admin-form-control" value="<%= settings.happyClients || 580 %>">
      </div>

      <div class="admin-form-group">
        <label>AMC Contracts</label>
        <input type="number" name="maintenanceContracts" class="admin-form-control" value="<%= settings.maintenanceContracts || 120 %>">
      </div>
    </div>

    <!-- Social Media Links -->
    <h3 style="margin: 30px 0 20px; font-size: 1.15rem; color: #0f172a; border-bottom: 1px solid var(--admin-border); padding-bottom: 10px;">
      <i class="fa-solid fa-share-nodes" style="color: #6366f1; margin-right: 8px;"></i> Social Media Links
    </h3>

    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
      <div class="admin-form-group">
        <label>Facebook URL</label>
        <input type="text" name="facebook" class="admin-form-control" value="<%= settings.facebook || '#' %>">
      </div>

      <div class="admin-form-group">
        <label>Instagram URL</label>
        <input type="text" name="instagram" class="admin-form-control" value="<%= settings.instagram || '#' %>">
      </div>

      <div class="admin-form-group">
        <label>LinkedIn URL</label>
        <input type="text" name="linkedin" class="admin-form-control" value="<%= settings.linkedin || '#' %>">
      </div>

      <div class="admin-form-group">
        <label>YouTube URL</label>
        <input type="text" name="youtube" class="admin-form-control" value="<%= settings.youtube || '#' %>">
      </div>
    </div>

    <div style="margin-top: 25px;">
      <button type="submit" class="btn-sm btn-admin-primary" style="padding: 12px 28px; font-size: 1rem;">
        <i class="fa-solid fa-floppy-disk"></i> Save Settings
      </button>
    </div>
  </form>
</div>

<%- include('layouts/footer') %>
