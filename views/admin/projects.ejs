<%- include('layouts/header') %>

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
  <div>
    <h1 class="font-serif text-white display-6 fw-bold mb-1">Portfolio & Project Gallery</h1>
    <p class="text-muted small mb-0">Showcase completed 5-star swimming pools, infinity horizons & residential estates</p>
  </div>
</div>

<!-- Add Project Card with Drag-and-Drop Image Preview -->
<div class="admin-card mb-4">
  <div class="admin-card-header">
    <h3 class="admin-card-title mb-0">
      <i class="bi bi-plus-circle-fill text-gold me-2"></i> Add Completed Pool Project
    </h3>
  </div>

  <form action="/admin/projects" method="POST" enctype="multipart/form-data">
    <div class="row g-3 mb-3">
      <div class="col-md-6">
        <label class="luxury-label">Project Title *</label>
        <input type="text" name="title" class="admin-input" placeholder="e.g. The Grand Azure Horizon Pool" required>
      </div>

      <div class="col-md-6">
        <label class="luxury-label">Architectural Category *</label>
        <select name="category" class="admin-select" required>
          <% categories.forEach(cat => { %>
            <option value="<%= cat %>"><%= cat %></option>
          <% }) %>
        </select>
      </div>
    </div>

    <div class="row g-3 mb-3">
      <div class="col-md-4">
        <label class="luxury-label">Location (City, State) *</label>
        <input type="text" name="location" class="admin-input" placeholder="e.g. Dumas Road, Surat" required>
      </div>

      <div class="col-md-4">
        <label class="luxury-label">Client / Property Name</label>
        <input type="text" name="clientName" class="admin-input" placeholder="Private Luxury Villa Estate">
      </div>

      <div class="col-md-4">
        <label class="luxury-label">Completion Year</label>
        <input type="text" name="completionYear" class="admin-input" placeholder="2024" value="2024">
      </div>
    </div>

    <div class="mb-3">
      <label class="luxury-label">Dimensions / Specifications</label>
      <input type="text" name="dimensions" class="admin-input" placeholder="e.g. 45ft x 20ft x 4.5ft (M-30 RCC Monolithic)">
    </div>

    <div class="mb-4">
      <label class="luxury-label">Architectural Highlights / Scope</label>
      <textarea name="description" rows="2" class="admin-textarea" placeholder="Monolithic RCC structure, infinity horizon overflow, Italian variable speed pumps, RGBW smart lighting..."></textarea>
    </div>

    <!-- Drag-and-Drop File Upload Zone with Instant Preview -->
    <div class="mb-4">
      <label class="luxury-label mb-2">High-Resolution Project Cover Imagery</label>
      
      <div class="admin-dropzone" id="projectDropzone">
        <input type="file" name="coverImage" id="projFileInput" class="admin-dropzone-input" accept="image/*">
        <div class="dropzone-icon">
          <i class="bi bi-cloud-arrow-up"></i>
        </div>
        <div class="dropzone-title">Drag & Drop Pool Photo Here, or Browse</div>
        <div class="dropzone-sub">Supports WebP, JPG, PNG up to 10MB</div>
        
        <div class="dropzone-preview-container" id="dropzonePreview">
          <img id="newProjectPreview" src="/images/infinity-pool.jpg" alt="Preview Image">
        </div>
      </div>

      <div class="mt-2 text-center text-muted small">
        <span>— Or Paste Online Photo URL —</span>
      </div>
      <div class="mt-2">
        <input type="url" name="imageUrl" id="projUrlInput" class="admin-input" placeholder="https://images.unsplash.com/photo-pool...">
      </div>
    </div>

    <div class="d-flex align-items-center gap-2 mb-4">
      <input type="checkbox" name="isFeatured" id="isFeatured" checked class="form-check-input" style="background-color: rgba(8,11,16,0.8); border-color: #D4AF37;">
      <label for="isFeatured" class="text-white small fw-bold cursor-pointer">Feature on Homepage Masterpiece Portfolio</label>
    </div>

    <button type="submit" class="admin-btn-gold">
      <i class="bi bi-check2-circle"></i> Save to Project Showcase
    </button>
  </form>
</div>

<!-- Existing Projects Table in Dark Glass Panel -->
<div class="admin-card">
  <div class="admin-card-header">
    <h3 class="admin-card-title mb-0">
      <i class="bi bi-images text-gold me-2"></i> Showcase Masterpieces (<%= projects ? projects.length : 0 %>)
    </h3>
  </div>

  <div class="admin-table-responsive">
    <table class="admin-table">
      <thead>
        <tr>
          <th>Preview</th>
          <th>Title</th>
          <th>Category</th>
          <th>Location</th>
          <th>Dimensions</th>
          <th>Year</th>
          <th>Featured</th>
          <th class="text-end">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if (projects && projects.length > 0) { %>
          <% projects.forEach(p => { %>
            <tr>
              <td>
                <img src="<%= p.coverImage || '/images/infinity-pool.jpg' %>" alt="<%= p.title %>"
                  style="width: 75px; height: 50px; object-fit: cover; border-radius: 6px; border: 1px solid rgba(212,175,55,0.3);"
                  onerror="this.src='/images/infinity-pool.jpg'">
              </td>
              <td>
                <strong class="text-white"><%= p.title %></strong>
              </td>
              <td>
                <span class="admin-badge badge-azure"><%= p.category %></span>
              </td>
              <td class="text-muted small"><%= p.location %></td>
              <td>
                <span class="blueprint-badge py-0 px-2 small"><%= p.dimensions || '-' %></span>
              </td>
              <td class="text-muted small"><%= p.completionYear %></td>
              <td>
                <% if (p.isFeatured) { %>
                  <span class="admin-badge badge-gold"><i class="bi bi-star-fill"></i> Featured</span>
                <% } else { %>
                  <span class="text-muted small">Standard</span>
                <% } %>
              </td>
              <td class="text-end">
                <div class="d-inline-flex gap-2">
                  <a href="/admin/projects/<%= p._id %>/edit" class="btn btn-sm btn-outline-warning" style="border-radius: var(--admin-radius-pill); font-size: 0.78rem;">
                    <i class="bi bi-pencil"></i> Edit
                  </a>
                  <form action="/admin/projects/<%= p._id %>/delete" method="POST" onsubmit="return confirm('Are you sure you want to delete this project?');" style="display: inline;">
                    <button type="submit" class="btn btn-sm btn-outline-danger" style="border-radius: var(--admin-radius-pill); font-size: 0.78rem;">
                      <i class="bi bi-trash"></i>
                    </button>
                  </form>
                </div>
              </td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr>
            <td colspan="8" class="text-center py-4 text-muted">
              No projects added yet. Use the upload panel above to showcase your first pool project.
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<script>
  // Drag and drop / URL live preview
  const projFileInput = document.getElementById('projFileInput');
  const projUrlInput = document.getElementById('projUrlInput');
  const newProjectPreview = document.getElementById('newProjectPreview');
  const dropzonePreview = document.getElementById('dropzonePreview');

  if (projFileInput) {
    projFileInput.addEventListener('change', function(e) {
      const file = e.target.files[0];
      if (file) {
        const reader = new FileReader();
        reader.onload = function(evt) {
          if (newProjectPreview) newProjectPreview.src = evt.target.result;
          if (dropzonePreview) dropzonePreview.style.display = 'block';
        };
        reader.readAsDataURL(file);
      }
    });
  }

  if (projUrlInput) {
    projUrlInput.addEventListener('input', function(e) {
      const url = e.target.value.trim();
      if (url && (url.startsWith('http://') || url.startsWith('https://'))) {
        if (newProjectPreview) newProjectPreview.src = url;
        if (dropzonePreview) dropzonePreview.style.display = 'block';
      }
    });
  }
</script>

<%- include('layouts/footer') %>
