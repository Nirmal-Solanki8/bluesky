<%- include('layouts/header') %>

<div class="page-title-box">
  <div>
    <h1>Portfolio & Project Gallery</h1>
    <p style="color: var(--admin-text-muted); font-size: 0.9rem;">Showcase your completed swimming pool construction projects</p>
  </div>
</div>

<!-- Add Project Form -->
<div class="admin-form-card">
  <h3 style="margin-bottom: 20px; font-size: 1.15rem; color: #0f172a;"><i class="fa-solid fa-plus-circle" style="color: #0284c7;"></i> Add Completed Pool Project</h3>
  
  <form action="/admin/projects" method="POST" enctype="multipart/form-data">
    <div class="admin-grid-2">
      <div class="admin-form-group">
        <label>Project Title *</label>
        <input type="text" name="title" class="admin-form-control" placeholder="e.g. The Grand Azure Horizon Pool" required>
      </div>

      <div class="admin-form-group">
        <label>Category *</label>
        <select name="category" class="admin-form-control" required>
          <% categories.forEach(cat => { %>
            <option value="<%= cat %>"><%= cat %></option>
          <% }) %>
        </select>
      </div>
    </div>

    <div class="admin-grid-3">
      <div class="admin-form-group">
        <label>Location (City/State) *</label>
        <input type="text" name="location" class="admin-form-control" placeholder="e.g. Dumas Road, Surat" required>
      </div>

      <div class="admin-form-group">
        <label>Client Name / Property</label>
        <input type="text" name="clientName" class="admin-form-control" placeholder="Private Luxury Villa">
      </div>

      <div class="admin-form-group">
        <label>Completion Year</label>
        <input type="text" name="completionYear" class="admin-form-control" placeholder="2024" value="2024">
      </div>
    </div>

    <div class="admin-form-group">
      <label>Dimensions / Size (Length x Width x Depth)</label>
      <input type="text" name="dimensions" class="admin-form-control" placeholder="e.g. 45ft x 20ft x 4.5ft">
    </div>

    <div class="admin-form-group">
      <label>Project Highlights / Description</label>
      <textarea name="description" rows="2" class="admin-form-control" placeholder="Monolithic RCC structure, infinity horizon overflow, smart RGBW lighting..."></textarea>
    </div>

    <!-- Cover Image Upload & URL with Live Preview -->
    <div style="background: #f8fafc; border: 1px solid var(--admin-border); border-radius: 8px; padding: 18px; margin-bottom: 20px;">
      <label style="font-weight: 600; font-size: 0.9rem; margin-bottom: 10px; display: block;">Cover Photo (Pool Image)</label>
      <div style="display: flex; gap: 20px; align-items: center; margin-bottom: 15px;">
        <img id="newProjectPreview" src="/images/infinity-pool.jpg" alt="Preview" style="width: 100px; height: 65px; object-fit: cover; border-radius: 8px; border: 1px solid #cbd5e1;">
        <div style="font-size: 0.85rem; color: #64748b;" id="previewText">
          Select an image file from your device or paste an online image URL below.
        </div>
      </div>

      <div class="admin-grid-equal-2">
        <div>
          <label style="font-size: 0.85rem; color: #475569;">Upload From Computer</label>
          <input type="file" name="coverImage" id="projFileInput" class="admin-form-control" accept="image/*">
        </div>
        <div>
          <label style="font-size: 0.85rem; color: #475569;">Or Paste Image URL</label>
          <input type="url" name="imageUrl" id="projUrlInput" class="admin-form-control" placeholder="https://images.unsplash.com/...">
        </div>
      </div>
    </div>

    <div style="display: flex; gap: 30px; margin-bottom: 20px; align-items: center;">
      <label style="display: flex; align-items: center; gap: 8px; cursor: pointer; font-weight: 600;">
        <input type="checkbox" name="isFeatured" checked style="width: 18px; height: 18px;">
        <span>Feature on Home Page & Highlights</span>
      </label>
    </div>

    <button type="submit" class="btn-sm btn-admin-primary" style="padding: 10px 22px; font-size: 0.92rem;">
      <i class="fa-solid fa-cloud-arrow-up"></i> Save to Portfolio
    </button>
  </form>
</div>

<!-- Existing Projects Table -->
<div class="card-table">
  <div class="card-header">
    <h3>Existing Portfolio Projects (<%= projects ? projects.length : 0 %>)</h3>
  </div>

  <div class="table-responsive">
    <table>
      <thead>
        <tr>
          <th>Photo</th>
          <th>Title</th>
          <th>Category</th>
          <th>Location</th>
          <th>Size</th>
          <th>Year</th>
          <th>Featured</th>
          <th>Action</th>
        </tr>
      </thead>
      <tbody>
        <% if (projects && projects.length > 0) { %>
          <% projects.forEach(p => { %>
            <tr>
              <td>
                <img src="<%= p.coverImage || '/images/infinity-pool.jpg' %>" alt="<%= p.title %>" style="width: 80px; height: 55px; object-fit: cover; border-radius: 6px;" onerror="this.src='/images/infinity-pool.jpg'">
              </td>
              <td><strong><%= p.title %></strong></td>
              <td><span class="badge" style="background: #e0f2fe; color: #0369a1;"><%= p.category %></span></td>
              <td><%= p.location %></td>
              <td><small style="color: #64748b;"><%= p.dimensions || '-' %></small></td>
              <td><%= p.completionYear %></td>
              <td><%= p.isFeatured ? '⭐ Yes' : 'No' %></td>
              <td>
                <div class="action-btns">
                  <a href="/admin/projects/<%= p._id %>/edit" class="btn-sm btn-admin-warning">
                    <i class="fa-solid fa-pen-to-square"></i> Edit
                  </a>
                  <form action="/admin/projects/<%= p._id %>/delete" method="POST" onsubmit="return confirm('Delete this project?');" style="display: inline;">
                    <button type="submit" class="btn-sm btn-admin-danger">
                      <i class="fa-solid fa-trash"></i> Delete
                    </button>
                  </form>
                </div>
              </td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr>
            <td colspan="8" style="text-align: center; padding: 30px; color: #64748b;">
              No projects added yet. Use the form above to add your first swimming pool project.
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<script>
  // Preview image
  const projFileInput = document.getElementById('projFileInput');
  const projUrlInput = document.getElementById('projUrlInput');
  const newProjectPreview = document.getElementById('newProjectPreview');
  const previewText = document.getElementById('previewText');

  if (projFileInput) {
    projFileInput.addEventListener('change', function(e) {
      const file = e.target.files[0];
      if (file) {
        const reader = new FileReader();
        reader.onload = function(evt) {
          newProjectPreview.src = evt.target.result;
          if (previewText) previewText.textContent = 'Selected: ' + file.name;
        };
        reader.readAsDataURL(file);
      }
    });
  }

  if (projUrlInput) {
    projUrlInput.addEventListener('input', function(e) {
      const url = e.target.value.trim();
      if (url && (url.startsWith('http://') || url.startsWith('https://'))) {
        newProjectPreview.src = url;
        if (previewText) previewText.textContent = 'URL: ' + url;
      }
    });
  }
</script>

<%- include('layouts/footer') %>
