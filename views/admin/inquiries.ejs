<%- include('layouts/header') %>

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
  <div>
    <h1 class="font-serif text-white display-6 fw-bold mb-1">Quotations & Lead Management</h1>
    <p class="text-muted small mb-0">Review incoming architectural inquiries, manage contact statuses, and track closed deals</p>
  </div>
  
  <!-- Filter Pills -->
  <div class="d-flex gap-2 flex-wrap">
    <a href="/admin/inquiries" class="luxury-filter-btn <%= typeof statusFilter === 'undefined' || statusFilter === 'All' ? 'active' : '' %>" style="padding: 6px 16px; font-size: 0.82rem;">
      All Leads (<%= inquiries ? inquiries.length : 0 %>)
    </a>
    <a href="/admin/inquiries?status=New" class="luxury-filter-btn <%= typeof statusFilter !== 'undefined' && statusFilter === 'New' ? 'active' : '' %>" style="padding: 6px 16px; font-size: 0.82rem;">
      Pending Only
    </a>
    <a href="/admin/inquiries?status=Contacted" class="luxury-filter-btn <%= typeof statusFilter !== 'undefined' && statusFilter === 'Contacted' ? 'active' : '' %>" style="padding: 6px 16px; font-size: 0.82rem;">
      Contacted
    </a>
    <a href="/admin/inquiries?status=Deal Closed" class="luxury-filter-btn <%= typeof statusFilter !== 'undefined' && statusFilter === 'Deal Closed' ? 'active' : '' %>" style="padding: 6px 16px; font-size: 0.82rem;">
      Closed
    </a>
  </div>
</div>

<div class="admin-card">
  <div class="admin-table-responsive">
    <table class="admin-table">
      <thead>
        <tr>
          <th>Date & Time</th>
          <th>Lead Details</th>
          <th>Classification</th>
          <th>Project Vision</th>
          <th>Status Management</th>
          <th class="text-end">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if (inquiries && inquiries.length > 0) { %>
          <% inquiries.forEach(inq => { %>
            <% const cleanPhone = (inq.phone || '').replace(/[^0-9]/g, ''); %>
            <tr>
              <td class="text-muted small" style="white-space: nowrap;">
                <strong class="text-white"><%= new Date(inq.createdAt).toLocaleDateString() %></strong><br>
                <span><%= new Date(inq.createdAt).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) %></span>
              </td>

              <td>
                <div class="text-white fw-bold"><%= inq.name %></div>
                <div class="d-flex gap-2 my-1">
                  <a href="tel:<%= inq.phone %>" class="admin-badge badge-azure text-decoration-none">
                    <i class="bi bi-telephone"></i> <%= inq.phone %>
                  </a>
                  <a href="https://wa.me/91<%= cleanPhone %>?text=Hello%20<%= encodeURIComponent(inq.name) %>,%20thank%20you%20for%20contacting%20Blue%20Sky%20International%20regarding%20your%20pool%20project%20(<%= encodeURIComponent(inq.poolType || '') %>)."
                    target="_blank" class="admin-badge text-decoration-none" style="background: rgba(37, 211, 102, 0.2); color: #25D366; border: 1px solid rgba(37,211,102,0.4);">
                    <i class="bi bi-whatsapp"></i> Chat
                  </a>
                </div>
                <% if (inq.email) { %>
                  <div class="text-muted small"><i class="bi bi-envelope"></i> <%= inq.email %></div>
                <% } %>
                <div class="text-muted small"><i class="bi bi-geo-alt text-gold"></i> <%= inq.city || 'Surat / Gujarat' %></div>
              </td>

              <td>
                <span class="blueprint-badge blueprint-badge-gold mb-1"><%= inq.poolType || 'Residential Pool' %></span>
                <% if (inq.poolDimensions) { %>
                  <div class="text-muted small"><strong>Size:</strong> <%= inq.poolDimensions %></div>
                <% } %>
                <% if (inq.budget) { %>
                  <div class="text-gold small"><strong>Budget:</strong> <%= inq.budget %></div>
                <% } %>
              </td>

              <td style="max-width: 260px;">
                <p class="text-muted small mb-1" style="line-height: 1.5;"><%= inq.message %></p>
                <% if (inq.adminNotes) { %>
                  <div class="p-2 rounded small mt-1" style="background: rgba(212, 175, 55, 0.12); border-left: 3px solid #D4AF37; color: #F5E6BE;">
                    <strong>Note:</strong> <%= inq.adminNotes %>
                  </div>
                <% } %>
              </td>

              <td style="min-width: 200px;">
                <form action="/admin/inquiries/<%= inq._id %>/status" method="POST" class="d-flex flex-column gap-2">
                  <select name="status" class="admin-select py-1 small">
                    <option value="New" <%= inq.status === 'New' ? 'selected' : '' %>>🟡 Pending (New)</option>
                    <option value="Contacted" <%= inq.status === 'Contacted' ? 'selected' : '' %>>🔵 Contacted</option>
                    <option value="Quotation Sent" <%= inq.status === 'Quotation Sent' ? 'selected' : '' %>>🟣 Quotation Sent</option>
                    <option value="Deal Closed" <%= inq.status === 'Deal Closed' ? 'selected' : '' %>>🟢 Deal Closed</option>
                    <option value="Cancelled" <%= inq.status === 'Cancelled' ? 'selected' : '' %>>⚪ Cancelled</option>
                  </select>
                  <input type="text" name="adminNotes" value="<%= inq.adminNotes || '' %>"
                    placeholder="Executive follow-up note..." class="admin-input py-1 small">
                  <button type="submit" class="admin-btn-gold py-1 px-3 small align-self-start">
                    <i class="bi bi-save"></i> Save Status
                  </button>
                </form>
              </td>

              <td class="text-end">
                <form action="/admin/inquiries/<%= inq._id %>/delete" method="POST"
                  onsubmit="return confirm('Permanently delete this customer lead?');">
                  <button type="submit" class="btn btn-sm btn-outline-danger" style="border-radius: var(--admin-radius-pill);" title="Delete Lead">
                    <i class="bi bi-trash"></i>
                  </button>
                </form>
              </td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr>
            <td colspan="6" class="text-center py-5 text-muted">
              <i class="bi bi-inbox fs-1 d-block mb-2 text-muted"></i>
              No quotation requests found for this filter.
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<%- include('layouts/footer') %>