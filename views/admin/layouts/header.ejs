<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | Bluesky International Admin</title>
  <link rel="stylesheet" href="/css/admin.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
</head>
<body>

<div class="admin-wrapper">
  <!-- Sidebar -->
  <%- include('sidebar') %>

  <!-- Main Content Wrapper -->
  <div class="admin-main">
    <!-- Topbar -->
    <header class="admin-topbar">
      <div style="font-weight: 700; font-size: 1.15rem; color: #0f172a; display: flex; align-items: center; gap: 12px;">
        <button type="button" class="admin-mobile-toggle" id="adminSidebarToggle" aria-label="Toggle Navigation">
          <i class="fa-solid fa-bars"></i>
        </button>
        <i class="fa-solid fa-water-ladder" style="color: #0284c7;"></i>
        <span>Bluesky International Admin</span>
      </div>

      <div class="user-profile">
        <span class="user-badge"><i class="fa-solid fa-user-check"></i> <%= admin ? admin.name : 'Pritesh' %></span>
        <a href="/admin/logout" class="logout-btn">
          <i class="fa-solid fa-right-from-bracket"></i> Logout
        </a>
      </div>
    </header>

    <!-- Page Content Container -->
    <div class="admin-content">
      <% if (locals.success_msg && success_msg.length > 0) { %>
        <div style="background: #d1fae5; color: #065f46; padding: 14px 18px; border-radius: 8px; margin-bottom: 22px; border-left: 4px solid #10b981; font-weight: 600;">
          <i class="fa-solid fa-circle-check"></i> <%= success_msg %>
        </div>
      <% } %>
      <% if (locals.error_msg && error_msg.length > 0) { %>
        <div style="background: #fee2e2; color: #991b1b; padding: 14px 18px; border-radius: 8px; margin-bottom: 22px; border-left: 4px solid #ef4444; font-weight: 600;">
          <i class="fa-solid fa-triangle-exclamation"></i> <%= error_msg %>
        </div>
      <% } %>
