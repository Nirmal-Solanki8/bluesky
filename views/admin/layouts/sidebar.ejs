<aside class="admin-sidebar">
  <div class="sidebar-brand">
    <a href="/admin/dashboard" class="d-inline-block">
      <img src="/images/logo.svg" alt="Blue Sky International" style="height: 38px; width: auto;" decoding="async">
    </a>
  </div>

  <ul class="sidebar-menu">
    <li class="sidebar-item">
      <a href="/admin/dashboard" class="sidebar-link <%= typeof activeMenu !== 'undefined' && activeMenu === 'dashboard' ? 'active' : '' %>">
        <i class="bi bi-speedometer2"></i>
        <span>Dashboard</span>
      </a>
    </li>
    <li class="sidebar-item">
      <a href="/admin/products" class="sidebar-link <%= typeof activeMenu !== 'undefined' && activeMenu === 'products' ? 'active' : '' %>">
        <i class="bi bi-box-seam"></i>
        <span>Pool Equipment</span>
      </a>
    </li>
    <li class="sidebar-item">
      <a href="/admin/projects" class="sidebar-link <%= typeof activeMenu !== 'undefined' && activeMenu === 'projects' ? 'active' : '' %>">
        <i class="bi bi-images"></i>
        <span>Projects Showcase</span>
      </a>
    </li>
    <li class="sidebar-item">
      <a href="/admin/services" class="sidebar-link <%= typeof activeMenu !== 'undefined' && activeMenu === 'services' ? 'active' : '' %>">
        <i class="bi bi-tools"></i>
        <span>Turnkey Services</span>
      </a>
    </li>
    <li class="sidebar-item">
      <a href="/admin/testimonials" class="sidebar-link <%= typeof activeMenu !== 'undefined' && activeMenu === 'testimonials' ? 'active' : '' %>">
        <i class="bi bi-chat-quote"></i>
        <span>Client Reviews</span>
      </a>
    </li>
    <li class="sidebar-item">
      <a href="/admin/inquiries" class="sidebar-link <%= typeof activeMenu !== 'undefined' && activeMenu === 'inquiries' ? 'active' : '' %>">
        <i class="bi bi-envelope-paper"></i>
        <span>Inquiries & Leads</span>
      </a>
    </li>
    <li class="sidebar-item">
      <a href="/admin/settings" class="sidebar-link <%= typeof activeMenu !== 'undefined' && activeMenu === 'settings' ? 'active' : '' %>">
        <i class="bi bi-sliders"></i>
        <span>Company Settings</span>
      </a>
    </li>
    <li class="sidebar-item mt-4 pt-3 border-top border-secondary border-opacity-25">
      <a href="/" target="_blank" class="sidebar-link text-gold">
        <i class="bi bi-box-arrow-up-right"></i>
        <span>View Live Site</span>
      </a>
    </li>
  </ul>

  <div class="sidebar-footer">
    <div style="font-size: 0.78rem; color: #94a3b8; text-transform: uppercase; letter-spacing: 0.8px; margin-bottom: 4px;">Logged in as:</div>
    <div style="font-weight: 700; color: #fff; font-size: 0.92rem;">
      <%= typeof admin !== 'undefined' && admin ? admin.name : 'Pritesh (Principal)' %>
    </div>
    <div style="font-size: 0.8rem; color: #38bdf8;">
      <%= typeof admin !== 'undefined' && admin ? admin.email : 'pritesh029@gmail.com' %>
    </div>
  </div>
</aside>