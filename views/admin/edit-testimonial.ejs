<%- include('layouts/header') %>

<div class="page-title-box">
  <div>
    <h1>Edit Client Review</h1>
    <p style="color: var(--admin-text-muted); font-size: 0.9rem;">Update customer review text, rating and approval visibility</p>
  </div>
  <div>
    <a href="/admin/testimonials" class="btn-sm btn-admin-secondary" style="padding: 9px 16px;">
      <i class="fa-solid fa-arrow-left"></i> Back to Reviews
    </a>
  </div>
</div>

<div class="admin-form-card" style="max-width: 800px;">
  <h3 style="margin-bottom: 25px; font-size: 1.2rem; color: #0f172a;">
    <i class="fa-solid fa-pen-to-square" style="color: #f59e0b;"></i> Edit: <%= testimonial.clientName %>
  </h3>

  <form action="/admin/testimonials/<%= testimonial._id %>/edit" method="POST">
    <div class="admin-grid-3">
      <div class="admin-form-group">
        <label>Client Name *</label>
        <input type="text" name="clientName" class="admin-form-control" value="<%= testimonial.clientName %>" required>
      </div>

      <div class="admin-form-group">
        <label>Designation / Role</label>
        <input type="text" name="designation" class="admin-form-control" value="<%= testimonial.designation || 'Villa Owner' %>">
      </div>

      <div class="admin-form-group">
        <label>Location (City/Area)</label>
        <input type="text" name="location" class="admin-form-control" value="<%= testimonial.location || '' %>">
      </div>
    </div>

    <div class="admin-grid-equal-2">
      <div class="admin-form-group">
        <label>Star Rating (1 to 5)</label>
        <select name="rating" class="admin-form-control">
          <option value="5" <%= testimonial.rating === 5 ? 'selected' : '' %>>⭐⭐⭐⭐⭐ (5 Stars)</option>
          <option value="4" <%= testimonial.rating === 4 ? 'selected' : '' %>>⭐⭐⭐⭐ (4 Stars)</option>
          <option value="3" <%= testimonial.rating === 3 ? 'selected' : '' %>>⭐⭐⭐ (3 Stars)</option>
          <option value="2" <%= testimonial.rating === 2 ? 'selected' : '' %>>⭐⭐ (2 Stars)</option>
          <option value="1" <%= testimonial.rating === 1 ? 'selected' : '' %>>⭐ (1 Star)</option>
        </select>
      </div>

      <div class="admin-form-group" style="padding-top: 28px;">
        <label style="display: flex; align-items: center; gap: 8px; cursor: pointer; font-weight: 600;">
          <input type="checkbox" name="isApproved" <%= testimonial.isApproved ? 'checked' : '' %> style="width: 18px; height: 18px;">
          <span>Show publicly on website (Approved)</span>
        </label>
      </div>
    </div>

    <div class="admin-form-group">
      <label>Review / Testimonial Text *</label>
      <textarea name="review" rows="4" class="admin-form-control" required><%= testimonial.review %></textarea>
    </div>

    <div style="display: flex; gap: 15px; margin-top: 20px;">
      <button type="submit" class="btn-sm btn-admin-primary" style="padding: 10px 24px; font-size: 0.95rem;">
        <i class="fa-solid fa-floppy-disk"></i> Save Review Changes
      </button>
      <a href="/admin/testimonials" class="btn-sm btn-admin-secondary" style="padding: 10px 20px; font-size: 0.95rem;">
        Cancel
      </a>
    </div>
  </form>
</div>

<%- include('layouts/footer') %>
