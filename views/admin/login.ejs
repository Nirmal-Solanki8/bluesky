<!DOCTYPE html>
<html lang="en" data-theme="dark" data-bs-theme="dark">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | Blue Sky International Executive Portal</title>

  <!-- Google Fonts: Cinzel & Plus Jakarta Sans -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <!-- Bootstrap 5 CSS & Icons CDN -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

  <!-- Executive Dark Admin Stylesheet -->
  <link rel="stylesheet" href="/css/admin.css?v=2.2">
</head>

<body style="background: radial-gradient(circle at 50% 20%, #10233D 0%, #080B10 75%); min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 24px;">

  <div class="glass-card p-4 p-md-5" style="width: 100%; max-width: 440px; background: rgba(15, 23, 42, 0.88); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px); border: 1px solid rgba(212, 175, 55, 0.35); border-top: 3px solid #D4AF37; box-shadow: 0 25px 60px rgba(0, 0, 0, 0.8), 0 0 35px rgba(212, 175, 55, 0.15); border-radius: 20px;">
    
    <div class="text-center mb-4">
      <img src="/images/logo.svg" alt="Blue Sky International" style="height: 48px; width: auto; margin-bottom: 16px; filter: drop-shadow(0 2px 10px rgba(212, 175, 55, 0.35));" decoding="async">
      <div style="font-size: 0.78rem; font-weight: 700; text-transform: uppercase; letter-spacing: 1.5px; color: #D4AF37;">Executive Control Center</div>
      <p class="text-muted small mt-1 mb-0">Authorized Staff & Architectural Management</p>
    </div>

    <% if (locals.error_msg && error_msg.length > 0) { %>
      <div class="alert alert-danger d-flex align-items-center gap-2 p-3 rounded-3 mb-4"
        style="background: rgba(239, 68, 68, 0.15); border: 1px solid rgba(239, 68, 68, 0.4); color: #F87171; font-size: 0.88rem;">
        <i class="bi bi-exclamation-triangle-fill"></i>
        <div><%= error_msg %></div>
      </div>
    <% } %>

    <% if (locals.success_msg && success_msg.length > 0) { %>
      <div class="alert alert-success d-flex align-items-center gap-2 p-3 rounded-3 mb-4"
        style="background: rgba(16, 185, 129, 0.15); border: 1px solid rgba(16, 185, 129, 0.4); color: #34D399; font-size: 0.88rem;">
        <i class="bi bi-check-circle-fill"></i>
        <div><%= success_msg %></div>
      </div>
    <% } %>

    <form action="/admin/login" method="POST">
      <div class="mb-3">
        <label class="d-block text-white small fw-bold mb-2 text-uppercase" style="letter-spacing: 0.8px;">Executive Email</label>
        <div class="input-group">
          <span class="input-group-text" style="background: rgba(8, 11, 16, 0.9); border: 1px solid rgba(212, 175, 55, 0.3); border-right: none; color: #D4AF37;">
            <i class="bi bi-envelope"></i>
          </span>
          <input type="email" name="email" class="admin-input" style="border-left: none;" value="pritesh029@gmail.com"
            placeholder="pritesh029@gmail.com" required autocomplete="email">
        </div>
      </div>

      <div class="mb-4">
        <label class="d-block text-white small fw-bold mb-2 text-uppercase" style="letter-spacing: 0.8px;">Secret Passcode</label>
        <div class="input-group">
          <span class="input-group-text" style="background: rgba(8, 11, 16, 0.9); border: 1px solid rgba(212, 175, 55, 0.3); border-right: none; color: #D4AF37;">
            <i class="bi bi-shield-lock"></i>
          </span>
          <input type="password" name="password" class="admin-input" style="border-left: none;" placeholder="••••••••" required autocomplete="current-password">
        </div>
      </div>

      <button type="submit" class="admin-btn-gold w-100 justify-content-center py-3" style="font-size: 0.95rem;">
        <i class="bi bi-box-arrow-in-right"></i> Authorize & Enter Dashboard
      </button>
    </form>

    <div class="text-center mt-4 pt-3 border-top border-secondary border-opacity-25">
      <a href="/" class="text-muted small text-decoration-none hover-gold d-inline-flex align-items-center gap-1">
        <i class="bi bi-arrow-left"></i> Return to Live Client Website
      </a>
    </div>

  </div>

</body>
</html>