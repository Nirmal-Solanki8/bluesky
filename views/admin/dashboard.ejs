<%- include('layouts/header') %>

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
  <div>
    <h1 class="font-serif text-white display-6 fw-bold mb-1">Executive Dashboard</h1>
    <p class="text-muted small mb-0">Overview of client inquiries, active pool projects, and equipment catalog</p>
  </div>
  <div>
    <a href="/admin/inquiries" class="admin-btn-gold">
      <i class="bi bi-file-earmark-text"></i> Review Inquiries
    </a>
  </div>
</div>

<!-- Modern KPI Stats Cards with Glowing Top Gold Borders -->
<div class="admin-stats-grid">
  
  <a href="/admin/inquiries" class="text-decoration-none">
    <div class="admin-stat-card">
      <div class="stat-icon-wrap" style="color: #F87171; background: rgba(239, 68, 68, 0.15); border-color: rgba(239, 68, 68, 0.3);">
        <i class="bi bi-bell-fill"></i>
      </div>
      <div class="stat-value text-white"><%= newInquiries %></div>
      <div class="stat-label">Pending Inquiries</div>
    </div>
  </a>

  <a href="/admin/products" class="text-decoration-none">
    <div class="admin-stat-card">
      <div class="stat-icon-wrap">
        <i class="bi bi-box-seam"></i>
      </div>
      <div class="stat-value text-white"><%= totalProducts %></div>
      <div class="stat-label">Equipment Items</div>
    </div>
  </a>

  <a href="/admin/projects" class="text-decoration-none">
    <div class="admin-stat-card">
      <div class="stat-icon-wrap" style="color: #38BDF8; background: rgba(2, 132, 199, 0.15); border-color: rgba(2, 132, 199, 0.3);">
        <i class="bi bi-images"></i>
      </div>
      <div class="stat-value text-white"><%= totalProjects %></div>
      <div class="stat-label">Showcase Projects</div>
    </div>
  </a>

  <a href="/admin/services" class="text-decoration-none">
    <div class="admin-stat-card">
      <div class="stat-icon-wrap" style="color: #34D399; background: rgba(16, 185, 129, 0.15); border-color: rgba(16, 185, 129, 0.3);">
        <i class="bi bi-tools"></i>
      </div>
      <div class="stat-value text-white"><%= totalServices %></div>
      <div class="stat-label">Turnkey Services</div>
    </div>
  </a>

  <a href="/admin/testimonials" class="text-decoration-none">
    <div class="admin-stat-card">
      <div class="stat-icon-wrap">
        <i class="bi bi-star-fill"></i>
      </div>
      <div class="stat-value text-white"><%= totalTestimonials %></div>
      <div class="stat-label">Client Endorsements</div>
    </div>
  </a>

</div>

<!-- Recent Inquiries Table in Dark Glass Panel -->
<div class="admin-card">
  <div class="admin-card-header">
    <h3 class="admin-card-title mb-0">
      <i class="bi bi-clock-history text-gold me-2"></i> Recent Quotation Requests & Leads
    </h3>
    <a href="/admin/inquiries" class="text-gold text-decoration-none small fw-bold">
      View All Leads &rarr;
    </a>
  </div>

  <div class="admin-table-responsive">
    <table class="admin-table">
      <thead>
        <tr>
          <th>Date</th>
          <th>Client Name</th>
          <th>Phone Contact</th>
          <th>Classification</th>
          <th>Location</th>
          <th>Status</th>
          <th class="text-end">Action</th>
        </tr>
      </thead>
      <tbody>
        <% if (recentInquiries && recentInquiries.length > 0) { %>
          <% recentInquiries.forEach(inq => { %>
            <tr>
              <td class="text-muted small">
                <%= new Date(inq.createdAt).toLocaleDateString() %>
              </td>
              <td>
                <strong class="text-white"><%= inq.name %></strong>
                <% if (inq.email) { %>
                  <div class="text-muted small"><%= inq.email %></div>
                <% } %>
              </td>
              <td>
                <a href="tel:<%= inq.phone %>" class="text-gold text-decoration-none fw-semibold">
                  <%= inq.phone %>
                </a>
              </td>
              <td>
                <span class="blueprint-badge py-0 px-2 small"><%= inq.poolType %></span>
              </td>
              <td>
                <span class="text-muted small"><%= inq.city || 'N/A' %></span>
              </td>
              <td>
                <% if (inq.status === 'New') { %>
                  <span class="admin-badge badge-pending">Pending</span>
                <% } else if (inq.status === 'Deal Closed' || inq.status === 'Completed') { %>
                  <span class="admin-badge badge-completed">Completed</span>
                <% } else { %>
                  <span class="admin-badge badge-azure"><%= inq.status %></span>
                <% } %>
              </td>
              <td class="text-end">
                <a href="/admin/inquiries" class="btn btn-sm btn-outline-light" style="border-radius: var(--admin-radius-pill); font-size: 0.78rem; padding: 4px 14px;">
                  Inspect
                </a>
              </td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr>
            <td colspan="7" class="text-center py-4 text-muted">
              No recent customer inquiries received yet. Submit an inquiry through the live website!
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<%- include('layouts/footer') %>