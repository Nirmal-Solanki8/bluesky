<%- include('layouts/header') %>

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
  <div>
    <h1 class="font-serif text-white display-6 fw-bold mb-1">Pool Products & Equipment</h1>
    <p class="text-muted small mb-0">Manage variable speed pumps, bio-filtration media, underwater RGBW LEDs & equipment catalog</p>
  </div>
</div>

<!-- Add Product Card with Drag-and-Drop Dropzone -->
<div class="admin-card mb-4">
  <div class="admin-card-header">
    <h3 class="admin-card-title mb-0">
      <i class="bi bi-plus-circle-fill text-gold me-2"></i> Add Architectural Hardware Product
    </h3>
  </div>

  <form action="/admin/products" method="POST" enctype="multipart/form-data">
    <div class="row g-3 mb-3">
      <div class="col-md-6">
        <label class="luxury-label">Product Name *</label>
        <input type="text" name="name" class="admin-input" placeholder="e.g. Commercial Deep Bed Sand Filter (Bobbin Wound)" required>
      </div>

      <div class="col-md-6">
        <label class="luxury-label">Product Category *</label>
        <select name="category" class="admin-select" required>
          <% if (typeof categories !== 'undefined' && categories.length > 0) { %>
            <% categories.forEach(cat => { %>
              <option value="<%= cat %>"><%= cat %></option>
            <% }) %>
          <% } else { %>
            <option value="Pool Filtration & Pumps">Pool Filtration & Pumps</option>
            <option value="Underwater LED Lights">Underwater LED Lights</option>
            <option value="Pool Tiles & Mosaics">Pool Tiles & Mosaics</option>
          <% } %>
        </select>
      </div>
    </div>

    <div class="row g-3 mb-3">
      <div class="col-md-6">
        <label class="luxury-label">Price (₹ INR - Optional)</label>
        <input type="number" name="price" class="admin-input" placeholder="Leave blank for 'Quote on Request'">
      </div>

      <div class="col-md-6">
        <label class="luxury-label">Manufacturer / Brand</label>
        <input type="text" name="brand" class="admin-input" placeholder="Blue Sky International" value="Blue Sky International">
      </div>
    </div>

    <div class="mb-3">
      <label class="luxury-label">Brief Specification / Short Description *</label>
      <input type="text" name="shortDescription" class="admin-input" placeholder="Technical summary shown on cards..." required>
    </div>

    <div class="mb-4">
      <label class="luxury-label">Comprehensive Engineering Specifications *</label>
      <textarea name="description" rows="3" class="admin-textarea" placeholder="Flow rates, bar pressure ratings, fiberglass reinforced shell, power consumption..." required></textarea>
    </div>

    <!-- Drag-and-Drop Image Upload Zone with Instant Preview -->
    <div class="mb-4">
      <label class="luxury-label mb-2">Product Photo</label>
      
      <div class="admin-dropzone" id="productDropzone">
        <input type="file" name="image" id="prodFileInput" class="admin-dropzone-input" accept="image/*">
        <div class="dropzone-icon">
          <i class="bi bi-cloud-arrow-up"></i>
        </div>
        <div class="dropzone-title">Drag & Drop Product Image Here, or Browse</div>
        <div class="dropzone-sub">Supports WebP, JPG, PNG up to 10MB</div>
        
        <div class="dropzone-preview-container" id="prodDropzonePreview">
          <img id="newProdPreview" src="/images/resort-pool.jpg" alt="Preview Image">
        </div>
      </div>

      <div class="mt-2 text-center text-muted small">
        <span>— Or Paste Online Photo URL —</span>
      </div>
      <div class="mt-2">
        <input type="url" name="imageUrl" id="prodUrlInput" class="admin-input" placeholder="https://images.unsplash.com/photo-pool-filter...">
      </div>
    </div>

    <div class="d-flex align-items-center gap-4 mb-4 flex-wrap">
      <label class="d-flex align-items-center gap-2 text-white small fw-bold cursor-pointer">
        <input type="checkbox" name="inStock" checked class="form-check-input" style="background-color: rgba(8,11,16,0.8); border-color: #D4AF37;">
        <span>In Stock & Ready for Dispatch</span>
      </label>
      <label class="d-flex align-items-center gap-2 text-white small fw-bold cursor-pointer">
        <input type="checkbox" name="isFeatured" checked class="form-check-input" style="background-color: rgba(8,11,16,0.8); border-color: #D4AF37;">
        <span>Feature on Catalog Homepage</span>
      </label>
    </div>

    <button type="submit" class="admin-btn-gold">
      <i class="bi bi-check2-circle"></i> Save to Equipment Catalog
    </button>
  </form>
</div>

<!-- Products Table in Dark Glass Panel -->
<div class="admin-card">
  <div class="admin-card-header">
    <h3 class="admin-card-title mb-0">
      <i class="bi bi-box-seam text-gold me-2"></i> Equipment Catalog (<%= (typeof products !== 'undefined' && products) ? products.length : 0 %>)
    </h3>
  </div>

  <div class="admin-table-responsive">
    <table class="admin-table">
      <thead>
        <tr>
          <th>Preview</th>
          <th>Product Name</th>
          <th>Category</th>
          <th>Price</th>
          <th>Availability</th>
          <th>Featured</th>
          <th class="text-end">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if (typeof products !== 'undefined' && products && products.length > 0) { %>
          <% products.forEach(prod => { %>
            <tr>
              <td>
                <img src="<%= prod.image || '/images/resort-pool.jpg' %>" alt="<%= prod.name %>"
                  style="width: 70px; height: 50px; object-fit: cover; border-radius: 6px; border: 1px solid rgba(212,175,55,0.3);"
                  onerror="this.src='/images/resort-pool.jpg'">
              </td>
              <td>
                <strong class="text-white"><%= prod.name %></strong>
                <div class="text-muted small"><%= prod.brand || 'Blue Sky International' %></div>
              </td>
              <td>
                <span class="admin-badge badge-azure"><%= prod.category %></span>
              </td>
              <td class="text-gold fw-bold">
                <%= (prod.price && Number(prod.price) > 0) ? '₹' + Number(prod.price).toLocaleString('en-IN') : 'Quote on Request' %>
              </td>
              <td>
                <span class="admin-badge <%= prod.inStock ? 'badge-completed' : 'badge-pending' %>">
                  <%= prod.inStock ? 'In Stock' : 'Out of Stock' %>
                </span>
              </td>
              <td>
                <% if (prod.isFeatured) { %>
                  <span class="admin-badge badge-gold"><i class="bi bi-star-fill"></i> Yes</span>
                <% } else { %>
                  <span class="text-muted small">No</span>
                <% } %>
              </td>
              <td class="text-end">
                <div class="d-inline-flex gap-2">
                  <a href="/admin/products/<%= prod._id %>/edit" class="btn btn-sm btn-outline-warning" style="border-radius: var(--admin-radius-pill); font-size: 0.78rem;">
                    <i class="bi bi-pencil"></i> Edit
                  </a>
                  <form action="/admin/products/<%= prod._id %>/delete" method="POST" onsubmit="return confirm('Delete this product?');" style="display: inline;">
                    <button type="submit" class="btn btn-sm btn-outline-danger" style="border-radius: var(--admin-radius-pill); font-size: 0.78rem;">
                      <i class="bi bi-trash"></i>
                    </button>
                  </form>
                </div>
              </td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr>
            <td colspan="7" class="text-center py-4 text-muted">
              No products found in the catalog. Add equipment using the form above!
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<script>
  const prodFileInput = document.getElementById('prodFileInput');
  const prodUrlInput = document.getElementById('prodUrlInput');
  const newProdPreview = document.getElementById('newProdPreview');
  const prodDropzonePreview = document.getElementById('prodDropzonePreview');

  if (prodFileInput) {
    prodFileInput.addEventListener('change', function(e) {
      const file = e.target.files[0];
      if (file) {
        const reader = new FileReader();
        reader.onload = function(evt) {
          if (newProdPreview) newProdPreview.src = evt.target.result;
          if (prodDropzonePreview) prodDropzonePreview.style.display = 'block';
        };
        reader.readAsDataURL(file);
      }
    });
  }

  if (prodUrlInput) {
    prodUrlInput.addEventListener('input', function(e) {
      const url = e.target.value.trim();
      if (url && (url.startsWith('http://') || url.startsWith('https://'))) {
        if (newProdPreview) newProdPreview.src = url;
        if (prodDropzonePreview) prodDropzonePreview.style.display = 'block';
      }
    });
  }
</script>

<%- include('layouts/footer') %>
