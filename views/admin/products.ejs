<%- include('layouts/header') %>

<div class="page-title-box">
  <div>
    <h1>Pool Products & Equipment</h1>
    <p style="color: var(--admin-text-muted); font-size: 0.9rem;">Manage swimming pool pumps, filtration systems, LED lights, heating & accessories</p>
  </div>
</div>

<!-- Add Product Form -->
<div class="admin-form-card">
  <h3 style="margin-bottom: 20px; font-size: 1.15rem; color: #0f172a;">
    <i class="fa-solid fa-plus-circle" style="color: #0284c7;"></i> Add New Product
  </h3>
  
  <form action="/admin/products" method="POST" enctype="multipart/form-data">
    <div class="admin-grid-2">
      <div class="admin-form-group">
        <label>Product Name *</label>
        <input type="text" name="name" class="admin-form-control" placeholder="e.g. Commercial Deep Bed Sand Filter" required>
      </div>

      <div class="admin-form-group">
        <label>Category *</label>
        <select name="category" class="admin-form-control" required>
          <% if (typeof categories !== 'undefined' && categories.length > 0) { %>
            <% categories.forEach(cat => { %>
              <option value="<%= cat %>"><%= cat %></option>
            <% }) %>
          <% } %>
        </select>
      </div>
    </div>

    <div class="admin-grid-equal-2">
      <div class="admin-form-group">
        <label>Price (₹ INR - Optional)</label>
        <input type="number" name="price" class="admin-form-control" placeholder="Price in INR (Leave blank for 'Quote on Request')">
      </div>

      <div class="admin-form-group">
        <label>Brand / Manufacturer</label>
        <input type="text" name="brand" class="admin-form-control" placeholder="Bluesky International" value="Bluesky International">
      </div>
    </div>

    <div class="admin-form-group">
      <label>Short Description (Shown on catalog card) *</label>
      <input type="text" name="shortDescription" class="admin-form-control" placeholder="Brief technical summary..." required>
    </div>

    <div class="admin-form-group">
      <label>Full Detailed Description *</label>
      <textarea name="description" rows="3" class="admin-form-control" placeholder="Detailed product specifications, flow rates, pressure ratings, materials..." required></textarea>
    </div>

    <!-- Product Image Upload & URL with Live Preview -->
    <div style="background: #f8fafc; border: 1px solid var(--admin-border); border-radius: 8px; padding: 18px; margin-bottom: 20px;">
      <label style="font-weight: 600; font-size: 0.9rem; margin-bottom: 10px; display: block;">Product Photo</label>
      <div style="display: flex; gap: 20px; align-items: center; margin-bottom: 15px;">
        <img id="newProdPreview" src="/images/resort-pool.jpg" alt="Preview" style="width: 100px; height: 65px; object-fit: cover; border-radius: 8px; border: 1px solid #cbd5e1;">
        <div style="font-size: 0.85rem; color: #64748b;" id="prodPreviewText">
          Select an image file from your device or paste an online image URL below.
        </div>
      </div>

      <div class="admin-grid-equal-2">
        <div>
          <label style="font-size: 0.85rem; color: #475569;">Upload From Computer</label>
          <input type="file" name="image" id="prodFileInput" class="admin-form-control" accept="image/*">
        </div>
        <div>
          <label style="font-size: 0.85rem; color: #475569;">Or Paste Image URL</label>
          <input type="url" name="imageUrl" id="prodUrlInput" class="admin-form-control" placeholder="https://images.unsplash.com/...">
        </div>
      </div>
    </div>

    <div style="display: flex; gap: 30px; margin-bottom: 20px; align-items: center; flex-wrap: wrap;">
      <label style="display: flex; align-items: center; gap: 8px; cursor: pointer; font-weight: 600;">
        <input type="checkbox" name="inStock" checked style="width: 18px; height: 18px;">
        <span>In Stock</span>
      </label>
      <label style="display: flex; align-items: center; gap: 8px; cursor: pointer; font-weight: 600;">
        <input type="checkbox" name="isFeatured" checked style="width: 18px; height: 18px;">
        <span>Featured on Home Page</span>
      </label>
    </div>

    <button type="submit" class="btn-sm btn-admin-primary" style="padding: 10px 22px; font-size: 0.92rem;">
      <i class="fa-solid fa-cloud-arrow-up"></i> Save Product
    </button>
  </form>
</div>

<!-- Products Table -->
<div class="card-table">
  <div class="card-header">
    <h3>All Pool Products (<%= (typeof products !== 'undefined' && products) ? products.length : 0 %>)</h3>
  </div>

  <div class="table-responsive">
    <table>
      <thead>
        <tr>
          <th>Photo</th>
          <th>Product Name</th>
          <th>Category</th>
          <th>Price</th>
          <th>Stock</th>
          <th>Featured</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if (typeof products !== 'undefined' && products && products.length > 0) { %>
          <% products.forEach(prod => { %>
            <tr>
              <td>
                <img src="<%= prod.image || '/images/resort-pool.jpg' %>" alt="<%= prod.name %>" style="width: 70px; height: 50px; object-fit: cover; border-radius: 6px;" onerror="this.src='/images/resort-pool.jpg'">
              </td>
              <td>
                <strong><%= prod.name %></strong>
                <div style="font-size: 0.8rem; color: #64748b;"><%= prod.brand || 'Bluesky International' %></div>
              </td>
              <td>
                <span class="badge badge-info"><%= prod.category %></span>
              </td>
              <td style="font-weight: 600;">
                <%= (prod.price && Number(prod.price) > 0) ? '₹' + Number(prod.price).toLocaleString('en-IN') : 'Quote on Request' %>
              </td>
              <td>
                <span class="badge <%= prod.inStock ? 'badge-success' : 'badge-danger' %>">
                  <%= prod.inStock ? 'In Stock' : 'Out of Stock' %>
                </span>
              </td>
              <td><%= prod.isFeatured ? '⭐ Yes' : 'No' %></td>
              <td>
                <div class="action-btns">
                  <a href="/admin/products/<%= prod._id %>/edit" class="btn-sm btn-admin-warning">
                    <i class="fa-solid fa-pen-to-square"></i> Edit
                  </a>
                  <form action="/admin/products/<%= prod._id %>/delete" method="POST" onsubmit="return confirm('Are you sure you want to delete this product?');" style="display: inline;">
                    <button type="submit" class="btn-sm btn-admin-danger">
                      <i class="fa-solid fa-trash"></i> Delete
                    </button>
                  </form>
                </div>
              </td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr>
            <td colspan="7" style="text-align: center; padding: 35px; color: #64748b;">
              No products found. Add your first swimming pool product using the form above!
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<script>
  // Preview image
  const prodFileInput = document.getElementById('prodFileInput');
  const prodUrlInput = document.getElementById('prodUrlInput');
  const newProdPreview = document.getElementById('newProdPreview');
  const prodPreviewText = document.getElementById('prodPreviewText');

  if (prodFileInput) {
    prodFileInput.addEventListener('change', function(e) {
      const file = e.target.files[0];
      if (file) {
        const reader = new FileReader();
        reader.onload = function(evt) {
          newProdPreview.src = evt.target.result;
          if (prodPreviewText) prodPreviewText.textContent = 'Selected: ' + file.name;
        };
        reader.readAsDataURL(file);
      }
    });
  }

  if (prodUrlInput) {
    prodUrlInput.addEventListener('input', function(e) {
      const url = e.target.value.trim();
      if (url && (url.startsWith('http://') || url.startsWith('https://'))) {
        newProdPreview.src = url;
        if (prodPreviewText) prodPreviewText.textContent = 'URL: ' + url;
      }
    });
  }
</script>

<%- include('layouts/footer') %>
