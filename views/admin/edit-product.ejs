<%- include('layouts/header') %>

<div class="page-title-box">
  <div>
    <h1>Edit Product</h1>
    <p style="color: var(--admin-text-muted); font-size: 0.9rem;">Modify product specifications, pricing, stock and images</p>
  </div>
  <div>
    <a href="/admin/products" class="btn-sm btn-admin-secondary" style="padding: 9px 16px;">
      <i class="fa-solid fa-arrow-left"></i> Back to Products
    </a>
  </div>
</div>

<div class="admin-form-card" style="max-width: 900px;">
  <h3 style="margin-bottom: 25px; font-size: 1.2rem; color: #0f172a;">
    <i class="fa-solid fa-pen-to-square" style="color: #f59e0b;"></i> Edit: <%= product.name %>
  </h3>

  <form action="/admin/products/<%= product._id %>/edit" method="POST" enctype="multipart/form-data">
    <div class="admin-grid-2">
      <div class="admin-form-group">
        <label>Product Name *</label>
        <input type="text" name="name" class="admin-form-control" value="<%= product.name %>" required>
      </div>

      <div class="admin-form-group">
        <label>Category *</label>
        <select name="category" class="admin-form-control" required>
          <% if (product.category && !categories.some(cat => cat.toLowerCase() === product.category.toLowerCase())) { %>
            <option value="<%= product.category %>" selected><%= product.category %></option>
          <% } %>
          <% categories.forEach(cat => { %>
            <option value="<%= cat %>" <%= (product.category && product.category.toLowerCase() === cat.toLowerCase()) ? 'selected' : '' %>><%= cat %></option>
          <% }) %>
        </select>
      </div>
    </div>

    <div class="admin-grid-equal-2">
      <div class="admin-form-group">
        <label>Price (₹ INR - Optional)</label>
        <input type="number" name="price" class="admin-form-control" value="<%= product.price || '' %>">
      </div>

      <div class="admin-form-group">
        <label>Brand / Manufacturer</label>
        <input type="text" name="brand" class="admin-form-control" value="<%= product.brand || 'Bluesky International' %>">
      </div>
    </div>

    <div class="admin-form-group">
      <label>Short Description *</label>
      <input type="text" name="shortDescription" class="admin-form-control" value="<%= product.shortDescription %>" required>
    </div>

    <div class="admin-form-group">
      <label>Full Detailed Description *</label>
      <textarea name="description" rows="4" class="admin-form-control" required><%= product.description %></textarea>
    </div>

    <!-- Current Image and New Image Upload with Live Preview -->
    <div style="background: #f8fafc; border: 1px solid var(--admin-border); border-radius: 8px; padding: 18px; margin-bottom: 20px;">
      <label style="font-weight: 600; font-size: 0.9rem; margin-bottom: 10px; display: block;">Product Image</label>
      <div style="display: flex; gap: 20px; align-items: center; margin-bottom: 15px;">
        <img id="productPreviewImg" src="<%= product.image %>" alt="<%= product.name %>" style="width: 100px; height: 75px; object-fit: cover; border-radius: 8px; border: 1px solid #cbd5e1;" onerror="this.src='https://images.unsplash.com/photo-1584464491033-06628f3a6b7b?w=120'">
        <div style="font-size: 0.85rem; color: #64748b;">
          Current image path: <code id="currentImgLabel"><%= product.image %></code><br>
          Upload a new file below or provide an image link to replace it with instant preview.
        </div>
      </div>

      <div class="admin-grid-equal-2">
        <div>
          <label style="font-size: 0.85rem; color: #475569;">Upload New File</label>
          <input type="file" name="image" id="productFileInput" class="admin-form-control" accept="image/*">
        </div>
        <div>
          <label style="font-size: 0.85rem; color: #475569;">Or New Image URL</label>
          <input type="url" name="imageUrl" id="productUrlInput" class="admin-form-control" placeholder="https://..." value="<%= product.image && product.image.startsWith('http') ? product.image : '' %>">
        </div>
      </div>
    </div>

    <div style="display: flex; gap: 30px; margin-bottom: 25px; flex-wrap: wrap;">
      <label style="display: flex; align-items: center; gap: 8px; cursor: pointer; font-weight: 600;">
        <input type="checkbox" name="inStock" <%= product.inStock ? 'checked' : '' %> style="width: 18px; height: 18px;">
        <span>Product In Stock</span>
      </label>
      <label style="display: flex; align-items: center; gap: 8px; cursor: pointer; font-weight: 600;">
        <input type="checkbox" name="isFeatured" <%= product.isFeatured ? 'checked' : '' %> style="width: 18px; height: 18px;">
        <span>Featured on Home Page</span>
      </label>
    </div>

    <div style="display: flex; gap: 15px;">
      <button type="submit" class="btn-sm btn-admin-primary" style="padding: 10px 24px; font-size: 0.95rem;">
        <i class="fa-solid fa-floppy-disk"></i> Save Changes
      </button>
      <a href="/admin/products" class="btn-sm btn-admin-secondary" style="padding: 10px 20px; font-size: 0.95rem;">
        Cancel
      </a>
    </div>
  </form>
</div>

<script>
  // Preview image
  const fileInput = document.getElementById('productFileInput');
  const urlInput = document.getElementById('productUrlInput');
  const previewImg = document.getElementById('productPreviewImg');
  const currentImgLabel = document.getElementById('currentImgLabel');

  if (fileInput) {
    fileInput.addEventListener('change', function(e) {
      const file = e.target.files[0];
      if (file) {
        const reader = new FileReader();
        reader.onload = function(evt) {
          previewImg.src = evt.target.result;
          if (currentImgLabel) currentImgLabel.textContent = file.name + ' (Selected)';
        };
        reader.readAsDataURL(file);
      }
    });
  }

  if (urlInput) {
    urlInput.addEventListener('input', function(e) {
      const url = e.target.value.trim();
      if (url && (url.startsWith('http://') || url.startsWith('https://'))) {
        previewImg.src = url;
        if (currentImgLabel) currentImgLabel.textContent = url;
      }
    });
  }
</script>

<%- include('layouts/footer') %>
