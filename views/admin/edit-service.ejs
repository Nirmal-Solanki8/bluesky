<%- include('layouts/header') %>

<div class="page-title-box">
  <div>
    <h1>Edit Pool Service</h1>
    <p style="color: var(--admin-text-muted); font-size: 0.9rem;">Modify service description, key technical features, order and service imagery</p>
  </div>
  <div>
    <a href="/admin/services" class="btn-sm btn-admin-secondary" style="padding: 9px 16px;">
      <i class="fa-solid fa-arrow-left"></i> Back to Services
    </a>
  </div>
</div>

<div class="admin-form-card" style="max-width: 900px;">
  <h3 style="margin-bottom: 25px; font-size: 1.2rem; color: #0f172a;">
    <i class="fa-solid fa-pen-to-square" style="color: #f59e0b;"></i> Edit: <%= service.title %>
  </h3>

  <form action="/admin/services/<%= service._id %>/edit" method="POST" enctype="multipart/form-data">
    <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 20px;">
      <div class="admin-form-group">
        <label>Service Title *</label>
        <input type="text" name="title" class="admin-form-control" value="<%= service.title %>" required>
      </div>

      <div class="admin-form-group">
        <label>Display Order</label>
        <input type="number" name="order" class="admin-form-control" value="<%= service.order || 0 %>">
      </div>
    </div>

    <div class="admin-form-group">
      <label>Short Description (Shown on Home Cards) *</label>
      <input type="text" name="shortDescription" class="admin-form-control" value="<%= service.shortDescription %>" required>
    </div>

    <div class="admin-form-group">
      <label>Full Detailed Description *</label>
      <textarea name="fullDescription" rows="4" class="admin-form-control" required><%= service.fullDescription %></textarea>
    </div>

    <div class="admin-form-group">
      <label>Key Features (Comma separated)</label>
      <input type="text" name="features" class="admin-form-control" value="<%= service.features ? service.features.join(', ') : '' %>" placeholder="Leakproof RCC, Vanishing Edge, Glass Walls">
    </div>

    <!-- Current Image and New Image Upload with Live Preview -->
    <div style="background: #f8fafc; border: 1px solid var(--admin-border); border-radius: 8px; padding: 18px; margin-bottom: 25px;">
      <label style="font-weight: 600; font-size: 0.9rem; margin-bottom: 10px; display: block;">Service Image</label>
      <div style="display: flex; gap: 20px; align-items: center; margin-bottom: 15px;">
        <img id="serviceEditPreview" src="<%= service.image || '/images/infinity-pool.jpg' %>" alt="<%= service.title %>" style="width: 110px; height: 75px; object-fit: cover; border-radius: 8px; border: 1px solid #cbd5e1;" onerror="this.src='/images/infinity-pool.jpg'">
        <div style="font-size: 0.85rem; color: #64748b;">
          Current image: <code id="serviceCurrentImgLabel"><%= service.image %></code><br>
          Select a file or enter an image link below to replace with live preview.
        </div>
      </div>

      <div class="admin-grid-equal-2">
        <div>
          <label style="font-size: 0.85rem; color: #475569;">Upload New Photo</label>
          <input type="file" name="image" id="serviceEditFileInput" class="admin-form-control" accept="image/*">
        </div>
        <div>
          <label style="font-size: 0.85rem; color: #475569;">Or Image URL</label>
          <input type="url" name="imageUrl" id="serviceEditUrlInput" class="admin-form-control" placeholder="https://..." value="<%= service.image && service.image.startsWith('http') ? service.image : '' %>">
        </div>
      </div>
    </div>

    <div style="display: flex; gap: 15px;">
      <button type="submit" class="btn-sm btn-admin-primary" style="padding: 10px 24px; font-size: 0.95rem;">
        <i class="fa-solid fa-floppy-disk"></i> Save Service Changes
      </button>
      <a href="/admin/services" class="btn-sm btn-admin-secondary" style="padding: 10px 20px; font-size: 0.95rem;">
        Cancel
      </a>
    </div>
  </form>
</div>

<script>
  // Preview image
  const serviceEditFileInput = document.getElementById('serviceEditFileInput');
  const serviceEditUrlInput = document.getElementById('serviceEditUrlInput');
  const serviceEditPreview = document.getElementById('serviceEditPreview');
  const serviceCurrentImgLabel = document.getElementById('serviceCurrentImgLabel');

  if (serviceEditFileInput) {
    serviceEditFileInput.addEventListener('change', function(e) {
      const file = e.target.files[0];
      if (file) {
        const reader = new FileReader();
        reader.onload = function(evt) {
          serviceEditPreview.src = evt.target.result;
          if (serviceCurrentImgLabel) serviceCurrentImgLabel.textContent = file.name + ' (Selected)';
        };
        reader.readAsDataURL(file);
      }
    });
  }

  if (serviceEditUrlInput) {
    serviceEditUrlInput.addEventListener('input', function(e) {
      const url = e.target.value.trim();
      if (url && (url.startsWith('http://') || url.startsWith('https://'))) {
        serviceEditPreview.src = url;
        if (serviceCurrentImgLabel) serviceCurrentImgLabel.textContent = url;
      }
    });
  }
</script>

<%- include('layouts/footer') %>
