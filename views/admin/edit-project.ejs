<%- include('layouts/header') %>

<div class="page-title-box">
  <div>
    <h1>Edit Project Portfolio</h1>
    <p style="color: var(--admin-text-muted); font-size: 0.9rem;">Update project details, category, images and client showcase information</p>
  </div>
  <div>
    <a href="/admin/projects" class="btn-sm btn-admin-secondary" style="padding: 9px 16px;">
      <i class="fa-solid fa-arrow-left"></i> Back to Projects
    </a>
  </div>
</div>

<div class="admin-form-card" style="max-width: 900px;">
  <h3 style="margin-bottom: 25px; font-size: 1.2rem; color: #0f172a;">
    <i class="fa-solid fa-pen-to-square" style="color: #f59e0b;"></i> Edit: <%= project.title %>
  </h3>

  <form action="/admin/projects/<%= project._id %>/edit" method="POST" enctype="multipart/form-data">
    <div class="admin-grid-2">
      <div class="admin-form-group">
        <label>Project Title *</label>
        <input type="text" name="title" class="admin-form-control" value="<%= project.title %>" required>
      </div>

      <div class="admin-form-group">
        <label>Category *</label>
        <select name="category" class="admin-form-control" required>
          <% if (project.category && !categories.some(cat => cat.toLowerCase() === project.category.toLowerCase())) { %>
            <option value="<%= project.category %>" selected><%= project.category %></option>
          <% } %>
          <% categories.forEach(cat => { %>
            <option value="<%= cat %>" <%= (project.category && project.category.toLowerCase() === cat.toLowerCase()) ? 'selected' : '' %>><%= cat %></option>
          <% }) %>
        </select>
      </div>
    </div>

    <div class="admin-grid-3">
      <div class="admin-form-group">
        <label>Location (City/State) *</label>
        <input type="text" name="location" class="admin-form-control" value="<%= project.location %>" required>
      </div>

      <div class="admin-form-group">
        <label>Client Name / Property</label>
        <input type="text" name="clientName" class="admin-form-control" value="<%= project.clientName || '' %>">
      </div>

      <div class="admin-form-group">
        <label>Completion Year</label>
        <input type="text" name="completionYear" class="admin-form-control" value="<%= project.completionYear || '2024' %>">
      </div>
    </div>

    <div class="admin-form-group">
      <label>Dimensions / Size (Length x Width x Depth)</label>
      <input type="text" name="dimensions" class="admin-form-control" value="<%= project.dimensions || '' %>" placeholder="e.g. 45ft x 20ft x 4.5ft">
    </div>

    <div class="admin-form-group">
      <label>Project Description</label>
      <textarea name="description" rows="3" class="admin-form-control" placeholder="Key highlights, hydraulic systems, infinity edge, overflow channel..."><%= project.description || '' %></textarea>
    </div>

    <!-- Current Image and New Image Upload with Live Preview -->
    <div style="background: #f8fafc; border: 1px solid var(--admin-border); border-radius: 8px; padding: 18px; margin-bottom: 20px;">
      <label style="font-weight: 600; font-size: 0.9rem; margin-bottom: 10px; display: block;">Cover Photo (Pool Image)</label>
      <div style="display: flex; gap: 20px; align-items: center; margin-bottom: 15px;">
        <img id="projEditPreview" src="<%= project.coverImage || '/images/infinity-pool.jpg' %>" alt="<%= project.title %>" style="width: 120px; height: 80px; object-fit: cover; border-radius: 8px; border: 1px solid #cbd5e1;" onerror="this.src='/images/infinity-pool.jpg'">
        <div style="font-size: 0.85rem; color: #64748b;">
          Current image: <code id="projCurrentImgLabel"><%= project.coverImage %></code><br>
          Upload a file or enter an image link to replace with live preview.
        </div>
      </div>

      <div class="admin-grid-equal-2">
        <div>
          <label style="font-size: 0.85rem; color: #475569;">Upload New Cover Image</label>
          <input type="file" name="coverImage" id="projEditFileInput" class="admin-form-control" accept="image/*">
        </div>
        <div>
          <label style="font-size: 0.85rem; color: #475569;">Or New Image URL</label>
          <input type="url" name="imageUrl" id="projEditUrlInput" class="admin-form-control" placeholder="https://..." value="<%= project.coverImage && project.coverImage.startsWith('http') ? project.coverImage : '' %>">
        </div>
      </div>
    </div>

    <div style="margin-bottom: 25px;">
      <label style="display: flex; align-items: center; gap: 8px; cursor: pointer; font-weight: 600;">
        <input type="checkbox" name="isFeatured" <%= project.isFeatured ? 'checked' : '' %> style="width: 18px; height: 18px;">
        <span>Feature on Home Page & Highlight Section</span>
      </label>
    </div>

    <div style="display: flex; gap: 15px;">
      <button type="submit" class="btn-sm btn-admin-primary" style="padding: 10px 24px; font-size: 0.95rem;">
        <i class="fa-solid fa-floppy-disk"></i> Save Project Changes
      </button>
      <a href="/admin/projects" class="btn-sm btn-admin-secondary" style="padding: 10px 20px; font-size: 0.95rem;">
        Cancel
      </a>
    </div>
  </form>
</div>

<script>
  // Preview image
  const projEditFileInput = document.getElementById('projEditFileInput');
  const projEditUrlInput = document.getElementById('projEditUrlInput');
  const projEditPreview = document.getElementById('projEditPreview');
  const projCurrentImgLabel = document.getElementById('projCurrentImgLabel');

  if (projEditFileInput) {
    projEditFileInput.addEventListener('change', function(e) {
      const file = e.target.files[0];
      if (file) {
        const reader = new FileReader();
        reader.onload = function(evt) {
          projEditPreview.src = evt.target.result;
          if (projCurrentImgLabel) projCurrentImgLabel.textContent = file.name + ' (Selected)';
        };
        reader.readAsDataURL(file);
      }
    });
  }

  if (projEditUrlInput) {
    projEditUrlInput.addEventListener('input', function(e) {
      const url = e.target.value.trim();
      if (url && (url.startsWith('http://') || url.startsWith('https://'))) {
        projEditPreview.src = url;
        if (projCurrentImgLabel) projCurrentImgLabel.textContent = url;
      }
    });
  }
</script>

<%- include('layouts/footer') %>
