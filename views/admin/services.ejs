<%- include('layouts/header') %>

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
  <div>
    <h1 class="font-serif text-white display-6 fw-bold mb-1">Turnkey Pool Services</h1>
    <p class="text-muted small mb-0">Manage monolithic civil RCC construction, hydrotherapy spas & maintenance AMC offerings</p>
  </div>
</div>

<!-- Add Service Card with Drag-and-Drop Image Preview -->
<div class="admin-card mb-4">
  <div class="admin-card-header">
    <h3 class="admin-card-title mb-0">
      <i class="bi bi-plus-circle-fill text-gold me-2"></i> Add Turnkey Capability Service
    </h3>
  </div>

  <form action="/admin/services" method="POST" enctype="multipart/form-data">
    <div class="row g-3 mb-3">
      <div class="col-md-8">
        <label class="luxury-label">Service Title *</label>
        <input type="text" name="title" class="admin-input" placeholder="e.g. Monolithic RCC Swimming Pools" required>
      </div>

      <div class="col-md-4">
        <label class="luxury-label">Display Order</label>
        <input type="number" name="order" class="admin-input" placeholder="1" value="0">
      </div>
    </div>

    <div class="mb-3">
      <label class="luxury-label">Short Summary (Shown on homepage bento cards) *</label>
      <input type="text" name="shortDescription" class="admin-input" placeholder="Bespoke turnkey RCC construction, structural leakproofing & FINA engineering" required>
    </div>

    <div class="mb-3">
      <label class="luxury-label">Full Technical Scope & Engineering Description *</label>
      <textarea name="fullDescription" rows="3" class="admin-textarea" placeholder="Comprehensive description of excavation, shuttering, dual rebar cage, waterproofing..." required></textarea>
    </div>

    <div class="mb-3">
      <label class="luxury-label">Key Highlights / Features (Comma separated)</label>
      <input type="text" name="features" class="admin-input" placeholder="M-30 Concrete, 72h Ponding Test, Variable Speed Pumps, RGBW LED Illumination">
    </div>

    <!-- Drag-and-Drop File Upload Zone -->
    <div class="mb-4">
      <label class="luxury-label mb-2">Service Cover Imagery</label>
      <div class="admin-dropzone" id="serviceDropzone">
        <input type="file" name="image" id="srvFileInput" class="admin-dropzone-input" accept="image/*">
        <div class="dropzone-icon"><i class="bi bi-cloud-arrow-up"></i></div>
        <div class="dropzone-title">Drag & Drop Service Photo Here, or Browse</div>
        <div class="dropzone-sub">Supports WebP, JPG, PNG up to 10MB</div>
        <div class="dropzone-preview-container" id="srvDropzonePreview">
          <img id="newSrvPreview" src="/images/private-pool-hero.webp" alt="Preview Image">
        </div>
      </div>
      <div class="mt-2 text-center text-muted small">
        <span>— Or Paste Online Photo URL —</span>
      </div>
      <div class="mt-2">
        <input type="url" name="imageUrl" id="srvUrlInput" class="admin-input" placeholder="https://images.unsplash.com/photo-pool...">
      </div>
    </div>

    <button type="submit" class="admin-btn-gold">
      <i class="bi bi-check2-circle"></i> Save Turnkey Service
    </button>
  </form>
</div>

<!-- Services Table in Dark Glass Panel -->
<div class="admin-card">
  <div class="admin-card-header">
    <h3 class="admin-card-title mb-0">
      <i class="bi bi-tools text-gold me-2"></i> Active Turnkey Services (<%= services.length %>)
    </h3>
  </div>

  <div class="admin-table-responsive">
    <table class="admin-table">
      <thead>
        <tr>
          <th>Preview</th>
          <th>Service Title</th>
          <th>Summary</th>
          <th>Technical Features</th>
          <th class="text-end">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if (services && services.length > 0) { %>
          <% services.forEach(s => { %>
            <tr>
              <td>
                <img src="<%= s.image || '/images/infinity-pool.jpg' %>" alt="<%= s.title %>"
                  style="width: 75px; height: 50px; object-fit: cover; border-radius: 6px; border: 1px solid rgba(212,175,55,0.3);"
                  onerror="this.src='/images/infinity-pool.jpg'">
              </td>
              <td>
                <strong class="text-white"><%= s.title %></strong>
              </td>
              <td class="text-muted small" style="max-width: 280px; line-height: 1.5;">
                <%= s.shortDescription %>
              </td>
              <td>
                <% if (s.features && s.features.length > 0) { %>
                  <div class="d-flex flex-wrap gap-1">
                    <% s.features.forEach(feat => { %>
                      <span class="blueprint-badge py-0 px-2 small"><%= feat %></span>
                    <% }) %>
                  </div>
                <% } else { %>
                  <span class="text-muted small">-</span>
                <% } %>
              </td>
              <td class="text-end">
                <div class="d-inline-flex gap-2">
                  <a href="/admin/services/<%= s._id %>/edit" class="btn btn-sm btn-outline-warning" style="border-radius: var(--admin-radius-pill); font-size: 0.78rem;">
                    <i class="bi bi-pencil"></i> Edit
                  </a>
                  <form action="/admin/services/<%= s._id %>/delete" method="POST" onsubmit="return confirm('Delete this service?');" style="display: inline;">
                    <button type="submit" class="btn btn-sm btn-outline-danger" style="border-radius: var(--admin-radius-pill); font-size: 0.78rem;">
                      <i class="bi bi-trash"></i>
                    </button>
                  </form>
                </div>
              </td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr>
            <td colspan="5" class="text-center py-4 text-muted">
              No services registered. Add a turnkey pool service using the form above.
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<script>
  const srvFileInput = document.getElementById('srvFileInput');
  const srvUrlInput = document.getElementById('srvUrlInput');
  const newSrvPreview = document.getElementById('newSrvPreview');
  const srvDropzonePreview = document.getElementById('srvDropzonePreview');

  if (srvFileInput) {
    srvFileInput.addEventListener('change', function(e) {
      const file = e.target.files[0];
      if (file) {
        const reader = new FileReader();
        reader.onload = function(evt) {
          if (newSrvPreview) newSrvPreview.src = evt.target.result;
          if (srvDropzonePreview) srvDropzonePreview.style.display = 'block';
        };
        reader.readAsDataURL(file);
      }
    });
  }

  if (srvUrlInput) {
    srvUrlInput.addEventListener('input', function(e) {
      const url = e.target.value.trim();
      if (url && (url.startsWith('http://') || url.startsWith('https://'))) {
        if (newSrvPreview) newSrvPreview.src = url;
        if (srvDropzonePreview) srvDropzonePreview.style.display = 'block';
      }
    });
  }
</script>

<%- include('layouts/footer') %>
