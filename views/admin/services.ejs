<%- include('layouts/header') %>

<div class="page-title-box">
  <div>
    <h1>Manage Pool Services</h1>
    <p style="color: var(--admin-text-muted); font-size: 0.9rem;">Add or remove pool construction and maintenance services</p>
  </div>
</div>

<!-- Add Service Form -->
<div class="admin-form-card">
  <h3 style="margin-bottom: 20px; font-size: 1.15rem; color: #0f172a;"><i class="fa-solid fa-plus-circle" style="color: #0284c7;"></i> Add New Swimming Pool Service</h3>
  
  <form action="/admin/services" method="POST" enctype="multipart/form-data">
    <div class="admin-grid-2">
      <div class="admin-form-group">
        <label>Service Title *</label>
        <input type="text" name="title" class="admin-form-control" placeholder="Service Title" required>
      </div>

      <div class="admin-form-group">
        <label>Display Order</label>
        <input type="number" name="order" class="admin-form-control" placeholder="1" value="0">
      </div>
    </div>

    <div class="admin-form-group">
      <label>Short Description (Shown on Home Cards) *</label>
      <input type="text" name="shortDescription" class="admin-form-control" placeholder="Brief summary of the service" required>
    </div>

    <div class="admin-form-group">
      <label>Full Description *</label>
      <textarea name="fullDescription" rows="3" class="admin-form-control" placeholder="Detailed technical description of this service..." required></textarea>
    </div>

    <div class="admin-form-group">
      <label>Key Features (Comma separated)</label>
      <input type="text" name="features" class="admin-form-control" placeholder="Leakproof RCC, Vanishing Edge, Glass Walls, LED Illumination">
    </div>

    <div class="admin-grid-equal-2">
      <div class="admin-form-group">
        <label>Upload Service Photo</label>
        <input type="file" name="image" class="admin-form-control" accept="image/*">
      </div>

      <div class="admin-form-group">
        <label>Or Image URL</label>
        <input type="url" name="imageUrl" class="admin-form-control" placeholder="https://images.unsplash.com/...">
      </div>
    </div>

    <button type="submit" class="btn-sm btn-admin-primary" style="padding: 10px 20px; font-size: 0.9rem;">
      <i class="fa-solid fa-cloud-arrow-up"></i> Save Service
    </button>
  </form>
</div>

<!-- Existing Services Table -->
<div class="card-table">
  <div class="card-header">
    <h3>Existing Services (<%= services.length %>)</h3>
  </div>

  <div class="table-responsive">
    <table>
      <thead>
        <tr>
          <th>Image</th>
          <th>Title</th>
          <th>Short Description</th>
          <th>Features</th>
          <th>Action</th>
        </tr>
      </thead>
      <tbody>
        <% if (services && services.length > 0) { %>
          <% services.forEach(s => { %>
            <tr>
              <td>
                <img src="<%= s.image || '/images/infinity-pool.jpg' %>" alt="<%= s.title %>" style="width: 70px; height: 50px; object-fit: cover; border-radius: 6px;" onerror="this.src='/images/infinity-pool.jpg'">
              </td>
              <td><strong><%= s.title %></strong></td>
              <td style="max-width: 300px; font-size: 0.88rem; color: #475569;"><%= s.shortDescription %></td>
              <td style="font-size: 0.82rem;">
                <% if (s.features && s.features.length > 0) { %>
                  <%= s.features.join(', ') %>
                <% } else { %>
                  -
                <% } %>
              </td>
              <td>
                <div class="action-btns">
                  <a href="/admin/services/<%= s._id %>/edit" class="btn-sm btn-admin-warning">
                    <i class="fa-solid fa-pen-to-square"></i> Edit
                  </a>
                  <form action="/admin/services/<%= s._id %>/delete" method="POST" onsubmit="return confirm('Delete this service?');" style="display: inline;">
                    <button type="submit" class="btn-sm btn-admin-danger">
                      <i class="fa-solid fa-trash"></i> Delete
                    </button>
                  </form>
                </div>
              </td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr>
            <td colspan="5" style="text-align: center; padding: 30px; color: #64748b;">
              No services added yet. Fill the form above to add your first service.
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<%- include('layouts/footer') %>
