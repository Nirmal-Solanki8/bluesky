<%- include('layouts/header') %>

  <!-- Page Hero Banner -->
  <section class="page-hero-cinematic">
    <div class="page-hero-bg" style="background-image: url('/images/resort-pool.jpg');"></div>
    <div class="page-hero-overlay"></div>
    <div class="container" style="position: relative; z-index: 10;">
      <span class="section-tag-gold" style="margin-bottom: 18px; display: inline-flex;">
        <i class="fa-solid fa-gears"></i> High-Performance Hardware
      </span>
      <h1 class="page-hero-title">
        Pool Equipment & <span class="text-glow-gradient">Technology</span>
      </h1>
      <p class="page-hero-desc">
        Commercial-grade sand filters, variable speed inverter pumps, robotic suction cleaners, and architectural RGBW underwater LED illumination.
      </p>
    </div>
  </section>

  <!-- Products Catalog -->
  <section class="section" style="background: var(--bg-main);">
    <div class="container-wide">
      <!-- Category filter buttons -->
      <div style="display: flex; gap: 10px; flex-wrap: wrap; justify-content: center; margin-bottom: 45px;">
        <a href="/products" class="filter-pill <%= selectedCategory === 'all' ? 'active' : '' %>">
          All Products
        </a>
        <% categories.forEach(cat => { %>
          <a href="/products?category=<%= encodeURIComponent(cat) %>"
            class="filter-pill <%= selectedCategory === cat ? 'active' : '' %>">
            <%= cat %>
          </a>
        <% }) %>
      </div>

      <div class="grid-4">
        <% if (products && products.length > 0) { %>
          <% products.forEach(prod => { %>
            <div class="product-card-premium">
              <div class="product-img-wrap">
                <img src="<%= prod.image || '/images/resort-pool.jpg' %>" alt="<%= prod.name %>"
                  loading="lazy" decoding="async" onerror="this.src='/images/resort-pool.jpg'">
              </div>

              <div style="flex: 1; display: flex; flex-direction: column;">
                <span style="font-size: 0.76rem; color: var(--brand-cyan); text-transform: uppercase; font-weight: 800; letter-spacing: 0.5px; margin-bottom: 6px; display: block;">
                  <%= prod.category %>
                </span>

                <h3 style="font-size: 1.15rem; font-weight: 800; color: var(--text-main); line-height: 1.3; margin-bottom: 8px;">
                  <%= prod.name %>
                </h3>

                <p style="font-size: 0.9rem; color: var(--text-muted); line-height: 1.55; margin-bottom: 18px; flex: 1;">
                  <%= prod.shortDescription %>
                </p>

                <div style="padding-top: 14px; border-top: 1px solid var(--border-subtle); display: flex; align-items: center; justify-content: space-between; gap: 10px;">
                  <% if (prod.price && Number(prod.price) > 0) { %>
                    <div>
                      <span style="font-size: 0.72rem; color: var(--text-dim); text-transform: uppercase; font-weight: 600; display: block;">Price</span>
                      <strong style="font-size: 1.25rem; font-weight: 800; color: var(--brand-cyan);">₹<%= Number(prod.price).toLocaleString('en-IN') %></strong>
                    </div>
                  <% } else { %>
                    <div>
                      <span style="font-size: 0.72rem; color: var(--text-dim); text-transform: uppercase; font-weight: 600; display: block;">Pricing</span>
                      <strong style="font-size: 0.95rem; font-weight: 700; color: var(--text-main);">Quote on Request</strong>
                    </div>
                  <% } %>

                  <a href="/contact?product=<%= encodeURIComponent(prod.name) %>#quote-form" class="btn btn-outline"
                    style="padding: 8px 16px; font-size: 0.85rem; font-weight: 700; white-space: nowrap;">
                    Inquire <i class="fa-solid fa-arrow-right" style="font-size: 0.75rem; margin-left: 4px;"></i>
                  </a>
                </div>
              </div>
            </div>
          <% }) %>
        <% } else { %>
          <div style="grid-column: 1/-1; text-align: center; padding: 60px 20px; background: var(--bg-card); border-radius: 16px; border: 1px solid var(--border-subtle);">
            <i class="fa-solid fa-box-open" style="font-size: 3rem; color: var(--text-dim); margin-bottom: 15px;"></i>
            <h3 style="font-size: 1.3rem; font-weight: 700; margin-bottom: 8px;">No Products Found</h3>
            <p style="color: var(--text-muted); margin-bottom: 20px;">There are no products listed under this category yet.</p>
            <a href="/products" class="btn btn-primary" style="padding: 10px 24px; font-size: 0.9rem;">View All Products</a>
          </div>
        <% } %>
      </div>
    </div>
  </section>

  <%- include('layouts/footer') %>