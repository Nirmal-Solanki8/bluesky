<%- include('layouts/header') %>

<!-- Hero Banner: About Blue Sky International -->
<section class="page-hero-cinematic">
  <div class="page-hero-bg" style="background-image: url('/images/private-pool-hero.webp');"></div>
  <div class="page-hero-overlay"></div>

  <div class="container position-relative" style="z-index: 10;">
    <div class="section-tag-luxury mb-3">
      <i class="bi bi-water"></i> 16+ Years Turnkey Aquatic Mastery
    </div>
    
    <h1 class="font-serif text-white display-4 fw-bold mb-3">
      Engineering World-Class <span class="text-gradient-gold">Aquatic Architecture</span>
    </h1>
    
    <p class="luxury-subtext mx-auto mb-4" style="font-size: 1.15rem; color: #E2E8F0 !important; max-width: 820px;">
      Surat's foremost turnkey swimming pool construction and hydraulic engineering firm. Transforming private villa estates, luxury rooftops, and 5-star international resorts into crystalline waterscapes since 2008.
    </p>

    <!-- Luxury Credential Badges -->
    <div class="d-flex flex-wrap gap-3 justify-content-center pt-2">
      <div class="blueprint-badge blueprint-badge-gold" style="font-size: 0.85rem; padding: 8px 18px;">
        <i class="bi bi-shield-check"></i> 100% Monolithic RCC Leakproof
      </div>
      <div class="blueprint-badge" style="font-size: 0.85rem; padding: 8px 18px;">
        <i class="bi bi-patch-check"></i> ISO 9001:2015 Certified
      </div>
      <div class="blueprint-badge blueprint-badge-gold" style="font-size: 0.85rem; padding: 8px 18px;">
        <i class="bi bi-trophy"></i> <%= typeof settings !== 'undefined' && settings.poolsBuilt ? settings.poolsBuilt : 720 %>+ Pools Built
      </div>
      <div class="blueprint-badge" style="font-size: 0.85rem; padding: 8px 18px;">
        <i class="bi bi-geo-alt"></i> Surat Corporate Studio & HQ
      </div>
    </div>
  </div>
</section>

<!-- Section 1: The Bluesky Heritage & Philosophy -->
<section class="section py-5 my-4">
  <div class="container-wide">
    <div class="row g-5 align-items-center">
      
      <!-- Visual Showcase Frame with 3D Tilt Card -->
      <div class="col-lg-6">
        <div class="position-relative">
          <div class="glass-card overflow-hidden tilt-card-3d p-2" style="border-radius: var(--radius-lg);">
            <img src="/images/pool-types/vanishing-edge.webp" alt="Blue Sky Luxury Infinity Pool" 
                 class="w-100 rounded-4" style="height: 440px; object-fit: cover;" loading="lazy" decoding="async">
            
            <!-- Floating Credential Card Overlay -->
            <div class="position-absolute bottom-0 start-0 m-2 m-sm-4 p-3 rounded-4 glass-card-dark" 
                 style="border: 1px solid rgba(212, 175, 55, 0.4); max-width: calc(100% - 24px); width: 320px; box-shadow: 0 15px 35px rgba(0,0,0,0.7);">
              <span class="blueprint-badge blueprint-badge-gold mb-1">
                <i class="bi bi-gem"></i> Established 2008
              </span>
              <h5 class="font-serif text-white mb-1" style="font-size: 1.1rem;">16+ Years Turnkey Mastery</h5>
              <p class="small mb-0" style="color: #CBD5E1 !important; line-height: 1.45;">
                Gujarat's trusted architectural benchmark for private villa estates and commercial resorts.
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- Story Editorial Content -->
      <div class="col-lg-6">
        <div class="section-tag-luxury">
          <i class="bi bi-trophy"></i> The Blue Sky Standard
        </div>
        
        <h2 class="font-serif text-white display-6 fw-bold mb-3">
          Pioneering Aquatic Living With Engineering Integrity
        </h2>

        <p class="mb-3" style="color: #E2E8F0 !important; font-size: 1.08rem; line-height: 1.75;">
          Founded in Katargam, Surat, <strong class="text-white"><%= typeof settings !== 'undefined' && settings.companyName ? settings.companyName : 'Blue Sky International' %></strong> was established with an uncompromising mission: to eliminate the risks of leaking pool shells, green cloudy water, and unengineered local masonry contractors by introducing certified, turnkey civil and hydraulic engineering.
        </p>

        <p class="mb-4" style="color: #CBD5E1 !important; font-size: 1rem; line-height: 1.75;">
          Unlike conventional general builders who sub-contract excavation, plumbing, and mosaic finishing to fragmented third-party laborers, Blue Sky operates a unified, in-house team. Structural civil engineers, hydraulic calculation specialists, certified MEP technicians, and Spanish mosaic artisans collaborate seamlessly from initial 3D laser survey to final crystalline water commissioning.
        </p>

        <!-- Feature Points Bento Cards -->
        <div class="row g-3">
          <div class="col-sm-6">
            <div class="glass-card p-3 h-100">
              <div class="d-flex align-items-center gap-2 mb-2">
                <i class="bi bi-shield-check text-azure fs-4"></i>
                <h5 class="font-serif text-white mb-0" style="font-size: 1rem;">Monolithic RCC Pour</h5>
              </div>
              <p class="small mb-0" style="color: #CBD5E1 !important; line-height: 1.55;">
                Zero cold joints, M-30/M-35 grade concrete with polymer crystalline barrier tested under 72h hydrostatic ponding.
              </p>
            </div>
          </div>

          <div class="col-sm-6">
            <div class="glass-card p-3 h-100">
              <div class="d-flex align-items-center gap-2 mb-2">
                <i class="bi bi-droplet-half text-gold fs-4"></i>
                <h5 class="font-serif text-white mb-0" style="font-size: 1rem;">Italian Filtration MEP</h5>
              </div>
              <p class="small mb-0" style="color: #CBD5E1 !important; line-height: 1.55;">
                High-rate bobbin-wound sand filters, AFM bio-active glass media, and automated salt chlorination systems.
              </p>
            </div>
          </div>
        </div>

      </div>

    </div>
  </div>
</section>

<!-- Section 2: Live Metrics & Milestones Strip -->
<section class="luxury-stats-strip py-5 my-4">
  <div class="container">
    <div class="row g-4 justify-content-center">
      
      <div class="col-6 col-lg-3">
        <div class="luxury-stat-card">
          <div class="stat-number-glow counter-animate" data-count="<%= typeof settings !== 'undefined' && settings.experienceYears ? settings.experienceYears : 16 %>" data-suffix="+">
            <%= typeof settings !== 'undefined' && settings.experienceYears ? settings.experienceYears : 16 %>+
          </div>
          <div class="stat-label-subtle">Years Mastery</div>
        </div>
      </div>

      <div class="col-6 col-lg-3">
        <div class="luxury-stat-card">
          <div class="stat-number-glow counter-animate" data-count="<%= typeof settings !== 'undefined' && settings.poolsBuilt ? settings.poolsBuilt : 720 %>" data-suffix="+">
            <%= typeof settings !== 'undefined' && settings.poolsBuilt ? settings.poolsBuilt : 720 %>+
          </div>
          <div class="stat-label-subtle">Pools Completed</div>
        </div>
      </div>

      <div class="col-6 col-lg-3">
        <div class="luxury-stat-card">
          <div class="stat-number-glow counter-animate" data-count="<%= typeof settings !== 'undefined' && settings.happyClients ? settings.happyClients : 680 %>" data-suffix="+">
            <%= typeof settings !== 'undefined' && settings.happyClients ? settings.happyClients : 680 %>+
          </div>
          <div class="stat-label-subtle">Happy Villa Clients</div>
        </div>
      </div>

      <div class="col-6 col-lg-3">
        <div class="luxury-stat-card">
          <div class="stat-number-glow text-gradient-gold">100%</div>
          <div class="stat-label-subtle">Monolithic Leakproof</div>
        </div>
      </div>

    </div>
  </div>
</section>

<!-- Section 3: Architectural Heritage Timeline -->
<section class="section py-5 my-4">
  <div class="container-wide">
    <div class="text-center max-w-700 mx-auto mb-5">
      <div class="section-tag-luxury">
        <i class="bi bi-clock-history"></i> Architectural Heritage
      </div>
      <h2 class="font-serif text-white display-6 fw-bold mb-3">Our 16-Year Journey of Excellence</h2>
      <p class="luxury-subtext mx-auto" style="font-size: 1.05rem; color: #CBD5E1 !important; max-width: 720px;">
        From a pioneering concrete engineering studio in Surat to Gujarat's foremost turnkey luxury pool builder.
      </p>
    </div>

    <div class="luxury-timeline">
      <!-- Milestone 1 -->
      <div class="timeline-row">
        <div class="timeline-col">
          <div class="timeline-card glass-card">
            <span class="blueprint-badge blueprint-badge-gold mb-2">2008 • Genesis</span>
            <h4 class="font-serif text-white mb-2" style="font-size: 1.25rem;">Foundation of Blue Sky International</h4>
            <p class="small mb-0" style="color: #CBD5E1 !important; line-height: 1.6;">
              Established in Katargam, Surat by structural civil engineers with a mission to bring monolithic RCC construction and certified leakproofing to private villa estates.
            </p>
          </div>
        </div>
        <div class="timeline-marker"></div>
      </div>

      <!-- Milestone 2 -->
      <div class="timeline-row">
        <div class="timeline-col">
          <div class="timeline-card glass-card">
            <span class="blueprint-badge mb-2">2014 • Hydraulic Mastery</span>
            <h4 class="font-serif text-white mb-2" style="font-size: 1.25rem;">Gujarat's Premier Infinity Horizon Pools</h4>
            <p class="small mb-0" style="color: #CBD5E1 !important; line-height: 1.6;">
              Pioneered high-precision vanishing edge troughs, dual-chamber balance tanks, and imported Italian variable speed inverter filtration systems across high-end villas.
            </p>
          </div>
        </div>
        <div class="timeline-marker"></div>
      </div>

      <!-- Milestone 3 -->
      <div class="timeline-row">
        <div class="timeline-col">
          <div class="timeline-card glass-card">
            <span class="blueprint-badge blueprint-badge-gold mb-2">2019 • Commercial Scale</span>
            <h4 class="font-serif text-white mb-2" style="font-size: 1.25rem;">5-Star Resort Lagoons & Rooftop Sky Pools</h4>
            <p class="small mb-0" style="color: #CBD5E1 !important; line-height: 1.6;">
              Expanded turnkey capabilities to large commercial hotel lagoons, architectural acrylic transparent walls, and Olympic-spec FINA competition pools.
            </p>
          </div>
        </div>
        <div class="timeline-marker"></div>
      </div>

      <!-- Milestone 4 -->
      <div class="timeline-row">
        <div class="timeline-col">
          <div class="timeline-card glass-card">
            <span class="blueprint-badge mb-2">2024 • Benchmark Standard</span>
            <h4 class="font-serif text-white mb-2" style="font-size: 1.25rem;">720+ Masterpieces & ISO 9001:2015</h4>
            <p class="small mb-0" style="color: #CBD5E1 !important; line-height: 1.6;">
              Celebrated over 720 successfully handed-over luxury projects across India with our hallmark 100% monolithic leakproof guarantee and lifetime AMC care.
            </p>
          </div>
        </div>
        <div class="timeline-marker"></div>
      </div>
    </div>
  </div>
</section>

<!-- Section 4: Four Pillars of Excellence -->
<section class="section py-5 my-4">
  <div class="container-wide">
    <div class="text-center max-w-700 mx-auto mb-5">
      <div class="section-tag-luxury">
        <i class="bi bi-gem"></i> Quality Framework
      </div>
      <h2 class="font-serif text-white display-6 fw-bold mb-3">Four Pillars of the Blue Sky Standard</h2>
      <p class="luxury-subtext mx-auto" style="font-size: 1.05rem; color: #CBD5E1 !important; max-width: 720px;">
        Every swimming pool project follows our rigorous engineering discipline, ensuring zero structural settlement, flawless water filtration, and timeless aesthetics.
      </p>
    </div>

    <div class="row g-4">
      <!-- Pillar 1 -->
      <div class="col-md-6 col-lg-3">
        <div class="glass-card p-4 h-100 tilt-card-3d">
          <div class="mb-3" style="width: 52px; height: 52px; border-radius: 12px; background: rgba(2, 132, 199, 0.15); display: flex; align-items: center; justify-content: center; color: #38bdf8; font-size: 1.5rem; border: 1px solid rgba(2, 132, 199, 0.3);">
            <i class="bi bi-compass"></i>
          </div>
          <h3 class="font-serif text-white mb-2" style="font-size: 1.2rem;">3D Laser CAD Design</h3>
          <p class="small mb-0" style="color: #CBD5E1 !important; line-height: 1.65;">
            Precise topographical plot survey, hydraulic flow calculations, and photorealistic 3D architectural renders before excavation starts.
          </p>
        </div>
      </div>

      <!-- Pillar 2 -->
      <div class="col-md-6 col-lg-3">
        <div class="glass-card p-4 h-100 tilt-card-3d">
          <div class="mb-3" style="width: 52px; height: 52px; border-radius: 12px; background: rgba(212, 175, 55, 0.15); display: flex; align-items: center; justify-content: center; color: var(--gold-champagne); font-size: 1.5rem; border: 1px solid rgba(212, 175, 55, 0.3);">
            <i class="bi bi-box"></i>
          </div>
          <h3 class="font-serif text-white mb-2" style="font-size: 1.2rem;">Monolithic RCC Pour</h3>
          <p class="small mb-0" style="color: #CBD5E1 !important; line-height: 1.65;">
            Continuous monolithic concrete pouring with dual-cage high-tensile Fe-500D steel mesh reinforcement, preventing cold joints.
          </p>
        </div>
      </div>

      <!-- Pillar 3 -->
      <div class="col-md-6 col-lg-3">
        <div class="glass-card p-4 h-100 tilt-card-3d">
          <div class="mb-3" style="width: 52px; height: 52px; border-radius: 12px; background: rgba(0, 168, 150, 0.15); display: flex; align-items: center; justify-content: center; color: #00A896; font-size: 1.5rem; border: 1px solid rgba(0, 168, 150, 0.3);">
            <i class="bi bi-droplet"></i>
          </div>
          <h3 class="font-serif text-white mb-2" style="font-size: 1.2rem;">Bio-Active Filtration</h3>
          <p class="small mb-0" style="color: #CBD5E1 !important; line-height: 1.65;">
            High-rate deep bed sand filtration with activated glass AFM media, variable speed inverter pumps, and skin-friendly salt chlorinators.
          </p>
        </div>
      </div>

      <!-- Pillar 4 -->
      <div class="col-md-6 col-lg-3">
        <div class="glass-card p-4 h-100 tilt-card-3d">
          <div class="mb-3" style="width: 52px; height: 52px; border-radius: 12px; background: rgba(212, 175, 55, 0.15); display: flex; align-items: center; justify-content: center; color: var(--gold-champagne); font-size: 1.5rem; border: 1px solid rgba(212, 175, 55, 0.3);">
            <i class="bi bi-shield-check"></i>
          </div>
          <h3 class="font-serif text-white mb-2" style="font-size: 1.2rem;">Lifetime AMC Care</h3>
          <p class="small mb-0" style="color: #CBD5E1 !important; line-height: 1.65;">
            Our relationship continues long after handover. Dedicated in-house pool specialists handle periodic maintenance and water chemistry.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Section 5: Bluesky vs Local Contractors Comparison Matrix -->
<section class="section py-5 my-4">
  <div class="container-wide">
    <div class="text-center max-w-700 mx-auto mb-5">
      <div class="section-tag-luxury">
        <i class="bi bi-sliders"></i> Architectural Comparison
      </div>
      <h2 class="font-serif text-white display-6 fw-bold mb-3">Why Discerning Clients Choose Blue Sky</h2>
      <p class="luxury-subtext mx-auto" style="font-size: 1.05rem; color: #CBD5E1 !important; max-width: 720px;">
        See the critical engineering differences between certified turnkey pool architecture and unengineered local masonry contractors.
      </p>
    </div>

    <div class="glass-card overflow-hidden p-0" style="border-radius: var(--radius-lg);">
      <div class="table-responsive">
        <table class="table table-dark table-hover mb-0" style="background: transparent;">
          <thead>
            <tr style="border-bottom: 2px solid rgba(212, 175, 55, 0.3); background: rgba(15, 23, 42, 0.9);">
              <th class="p-4 font-serif text-white" style="width: 28%; font-size: 1.05rem;">Engineering Parameter</th>
              <th class="p-4 font-serif text-gold" style="width: 38%; font-size: 1.1rem; background: rgba(212, 175, 55, 0.08); border-left: 2px solid rgba(212, 175, 55, 0.4); border-right: 2px solid rgba(212, 175, 55, 0.4);">
                <i class="bi bi-check-circle-fill me-2 text-gold"></i> Blue Sky Standard <span class="blueprint-badge blueprint-badge-gold ms-2 py-0 px-2 small">GOLD BENCHMARK</span>
              </th>
              <th class="p-4 font-serif text-muted" style="width: 34%; font-size: 1rem;">Conventional Contractors</th>
            </tr>
          </thead>
          <tbody style="font-size: 0.95rem;">
            <tr style="border-bottom: 1px solid rgba(255, 255, 255, 0.08);">
              <td class="p-4 fw-bold text-white">Structural Core</td>
              <td class="p-4 fw-semibold text-white" style="background: rgba(212, 175, 55, 0.05); border-left: 2px solid rgba(212, 175, 55, 0.4); border-right: 2px solid rgba(212, 175, 55, 0.4);">
                <i class="bi bi-check-lg text-gold me-2"></i> Monolithic RCC with CAD design & dual-cage Fe-500D steel mesh
              </td>
              <td class="p-4" style="color: #94A3B8;">
                <i class="bi bi-x-lg text-danger me-2"></i> Brick masonry or unreinforced PCC prone to cracking & subsidence
              </td>
            </tr>
            <tr style="border-bottom: 1px solid rgba(255, 255, 255, 0.08);">
              <td class="p-4 fw-bold text-white">Waterproofing Integrity</td>
              <td class="p-4 fw-semibold text-white" style="background: rgba(212, 175, 55, 0.05); border-left: 2px solid rgba(212, 175, 55, 0.4); border-right: 2px solid rgba(212, 175, 55, 0.4);">
                <i class="bi bi-check-lg text-gold me-2"></i> 2-layer crystalline polymer injection + mandatory 72-hour ponding test
              </td>
              <td class="p-4" style="color: #94A3B8;">
                <i class="bi bi-x-lg text-danger me-2"></i> Basic cement slurry wash or single bitumen coat prone to leaks
              </td>
            </tr>
            <tr style="border-bottom: 1px solid rgba(255, 255, 255, 0.08);">
              <td class="p-4 fw-bold text-white">Hydraulics & Water Care</td>
              <td class="p-4 fw-semibold text-white" style="background: rgba(212, 175, 55, 0.05); border-left: 2px solid rgba(212, 175, 55, 0.4); border-right: 2px solid rgba(212, 175, 55, 0.4);">
                <i class="bi bi-check-lg text-gold me-2"></i> Italian variable speed pumps & bio-active glass AFM media
              </td>
              <td class="p-4" style="color: #94A3B8;">
                <i class="bi bi-x-lg text-danger me-2"></i> Undersized low-efficiency domestic pumps causing cloudy, stale water
              </td>
            </tr>
            <tr style="border-bottom: 1px solid rgba(255, 255, 255, 0.08);">
              <td class="p-4 fw-bold text-white">Lighting & Safety</td>
              <td class="p-4 fw-semibold text-white" style="background: rgba(212, 175, 55, 0.05); border-left: 2px solid rgba(212, 175, 55, 0.4); border-right: 2px solid rgba(212, 175, 55, 0.4);">
                <i class="bi bi-check-lg text-gold me-2"></i> 12V IP68 resin-filled underwater LED lights with isolated safety transformers
              </td>
              <td class="p-4" style="color: #94A3B8;">
                <i class="bi bi-x-lg text-danger me-2"></i> Non-certified niche lamps risking water ingress and short circuits
              </td>
            </tr>
            <tr>
              <td class="p-4 fw-bold text-white">Warranty & Handover</td>
              <td class="p-4 fw-semibold text-white" style="background: rgba(212, 175, 55, 0.05); border-left: 2px solid rgba(212, 175, 55, 0.4); border-right: 2px solid rgba(212, 175, 55, 0.4);">
                <i class="bi bi-check-lg text-gold me-2"></i> Written 100% leakproof warranty + dedicated in-house service team
              </td>
              <td class="p-4" style="color: #94A3B8;">
                <i class="bi bi-x-lg text-danger me-2"></i> No written warranty; untraceable after final payment
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</section>

<!-- Section 6: Consultation Call to Action -->
<section class="section py-5 my-4" style="background: rgba(15, 23, 42, 0.5);">
  <div class="container-wide">
    <div class="row g-5 align-items-center">
      <div class="col-lg-7">
        <div class="section-tag-luxury mb-3">
          <i class="bi bi-compass"></i> Complimentary 3D Survey
        </div>
        <h2 class="font-serif text-white display-6 fw-bold mb-3">
          Ready to Build Your Private Aquatic Oasis?
        </h2>
        <p class="luxury-subtext mb-4" style="color: #E2E8F0 !important; font-size: 1.08rem; line-height: 1.75;">
          Meet with our senior structural and hydraulic engineers at our Surat Studio or schedule a complimentary site laser inspection at your villa plot anywhere across Gujarat and Mumbai.
        </p>

        <div class="glass-card p-3 mb-4 d-inline-flex align-items-center gap-3">
          <i class="bi bi-geo-alt-fill text-gold fs-4"></i>
          <div>
            <div class="text-gold fw-bold small text-uppercase" style="letter-spacing: 0.8px;">Surat Corporate Studio:</div>
            <div class="text-white small">
              <%= typeof settings !== 'undefined' && settings.address ? settings.address : 'A-8, Laxmikant Ashram Rd, Rashi Circle, Bhulabhai Desai Park, Hari Darshan Society, Katargam, Surat, Gujarat 395004' %>
            </div>
          </div>
        </div>

        <div class="d-flex flex-wrap gap-3">
          <a href="/contact#quote-form" class="luxury-cta-btn" style="padding: 13px 32px; font-size: 0.96rem;">
            <i class="bi bi-compass"></i> Request 3D Site Survey
          </a>
          <a href="https://wa.me/918128920702?text=Hello%20Blue%20Sky%20International,%20I%20am%20interested%20in%20an%20architectural%20luxury%20swimming%20pool%20project." 
             target="_blank" rel="noopener noreferrer" class="btn btn-outline-light d-inline-flex align-items-center gap-2"
             style="border-radius: var(--radius-pill); padding: 12px 28px; font-weight: 600; border-color: rgba(255,255,255,0.25); background: rgba(15,23,42,0.5); backdrop-filter: blur(10px); color: #FFFFFF;">
            <i class="bi bi-whatsapp text-success"></i> WhatsApp Concierge
          </a>
        </div>
      </div>

      <div class="col-lg-5">
        <div class="glass-card overflow-hidden tilt-card-3d p-2">
          <img src="/images/private-pool-hero.webp" alt="Private Luxury Pool by Blue Sky" 
               class="w-100 rounded-4" style="height: 360px; object-fit: cover;" loading="lazy" decoding="async">
        </div>
      </div>
    </div>
  </div>
</section>

<%- include('layouts/footer') %>