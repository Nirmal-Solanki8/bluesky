        <div class="container-wide">
          <div class="quote-banner">
            <div class="quote-grid">
              <div>
                <span class="section-tag-gold" style="margin-bottom: 16px;"><i class="fa-solid fa-compass-drafting"></i>
                  Free 3D Site Survey & Consultation</span>
                <h2
                  style="font-family: var(--font-hero); font-size: clamp(2.2rem, 3.8vw, 3.2rem); font-weight: 900; margin-top: 10px; margin-bottom: 18px; color: var(--text-main); line-height: 1.15;">
                  Planning Your Dream Swimming Pool?
                </h2>
                <p style="color: var(--text-muted); font-size: 1.1rem; margin-bottom: 24px; line-height: 1.65;">
                  Speak directly with our senior pool architects. We offer complimentary plot inspection, 3D hydraulic
                  CAD models, and
                  transparent itemized estimates with 100% leakproof guarantee.
                </p>

                <div
                  style="background: var(--bg-card); padding: 22px 24px; border-radius: 16px; border: 1px solid var(--border-subtle); box-shadow: 0 4px 20px rgba(0,0,0,0.04); margin-bottom: 25px;">
                  <div style="font-weight: 800; color: #b45309; margin-bottom: 6px; font-size: 0.96rem;">
                    <i class="fa-solid fa-location-dot" style="color: var(--brand-cyan);"></i> Corporate Office &
                    Studio:
                  </div>
                  <div style="color: var(--text-main); font-size: 0.94rem; line-height: 1.6; font-weight: 500;">
                    <%= settings.address
                      || 'A-8, Laxmikant Ashram Rd, Rashi Circle, Bhulabhai Desai Park, Hari Darshan Society, Katargam, Surat, Gujarat 395004'
                      %>
                  </div>

                  <div style="color: var(--brand-cyan); font-size: 0.86rem; margin-top: 12px; font-weight: 700;">
                    <i class="fa-solid fa-shield-halved"></i> Over <%= settings.experienceYears || 16 %> Years of
                      Excellence &bull; <%= settings.poolsBuilt || 650 %>+ Pools Built
                  </div>
                </div>
              </div>

              <div class="quote-form-card" id="quote-form-box">
                <h3 style="font-family: var(--font-hero); font-size: 1.5rem; font-weight: 800; margin-bottom: 8px;">
                  Request Custom Quotation
                </h3>
                <p style="color: var(--text-muted); font-size: 0.9rem; margin-bottom: 20px;">
                  Fill out your requirements below. Our pool specialist will call back with a customized estimate.
                </p>

                <% if (locals.success_msg && success_msg.length> 0) { %>
                  <div
                    style="background: #dcfce7; color: #166534; padding: 12px 16px; border-radius: 8px; margin-bottom: 20px; font-size: 0.92rem; font-weight: 600; border: 1px solid #bbf7d0;">
                    <i class="fa-solid fa-circle-check"></i>
                    <%= success_msg %>
                  </div>
                  <% } %>

                    <% if (locals.error_msg && error_msg.length> 0) { %>
                      <div
                        style="background: #fee2e2; color: #991b1b; padding: 12px 16px; border-radius: 8px; margin-bottom: 20px; font-size: 0.92rem; font-weight: 600; border: 1px solid #fecaca;">
                        <i class="fa-solid fa-triangle-exclamation"></i>
                        <%= error_msg %>
                      </div>
                      <% } %>

                        <form action="/inquiry" method="POST">
                          <div class="form-row">
                            <div class="form-group">
                              <label for="quote-name">Your Name *</label>
                              <input type="text" id="quote-name" name="name" class="form-control"
                                placeholder="Your Name" autocomplete="name" required>
                            </div>
                            <div class="form-group">
                              <label for="quote-phone">Phone / Mobile *</label>
                              <input type="tel" id="quote-phone" name="phone" class="form-control"
                                placeholder="Phone Number" autocomplete="tel" required>
                            </div>
                          </div>

                          <div class="form-row">
                            <div class="form-group">
                              <label for="quote-email">Email Address</label>
                              <input type="email" id="quote-email" name="email" class="form-control"
                                placeholder="Email Address" autocomplete="email">
                            </div>
                            <div class="form-group">
                              <label for="quote-city">City / Location</label>
                              <input type="text" id="quote-city" name="city" class="form-control"
                                placeholder="City / Location" autocomplete="address-level2">
                            </div>
                          </div>

                          <div class="form-row">
                            <div class="form-group">
                              <label for="quote-pool-type">Pool Classification</label>
                              <select id="quote-pool-type" name="poolType" class="form-control">
                                <option value="Luxury Residential Villa Pool">Luxury Residential Villa Pool</option>
                                <option value="Vanishing Edge Infinity Pool">Vanishing Edge Infinity Pool</option>
                                <option value="Commercial / Resort Pool">Commercial & Resort Swimming Pool</option>
                                <option value="Rooftop / Penthouse Pool">Rooftop / Penthouse Sky Pool</option>
                                <option value="Deck-Level Overflow Pool">Deck-Level Overflow Pool</option>
                                <option value="Skimmer Type Swimming Pool">Skimmer Type Pool</option>
                                <option value="Readymade FRP Swimming Pool">Readymade FRP Fiberglass Pool</option>
                                <option value="Hydrotherapy Jacuzzi & Spa">Hydrotherapy Jacuzzi & Spa</option>
                                <option value="Pool Renovation & Repair">Pool Renovation, Leak Repair & Retiling
                                </option>
                                <option value="Maintenance & AMC">Maintenance & Cleaning AMC</option>
                              </select>
                            </div>
                            <div class="form-group">
                              <label for="quote-dimensions">Approx. Size (ft / sq.ft)</label>
                              <input type="text" id="quote-dimensions" name="poolDimensions" class="form-control"
                                placeholder="Pool or Plot Dimensions">
                            </div>
                          </div>

                          <div class="form-group">
                            <label for="quote-budget">Estimated Budget (Optional)</label>
                            <select id="quote-budget" name="budget" class="form-control">
                              <option value="">Select Estimated Budget Range (Optional)</option>
                              <option value="₹5L - ₹15L">₹5 Lakhs - ₹15 Lakhs</option>
                              <option value="₹15L - ₹30L">₹15 Lakhs - ₹30 Lakhs</option>
                              <option value="₹30L - ₹60L">₹30 Lakhs - ₹60 Lakhs</option>
                              <option value="₹60L+">₹60 Lakhs+ (Ultra Luxury / Resort)</option>
                              <option value="Need Consultation">Need Site Inspection First</option>
                            </select>
                          </div>

                          <div class="form-group">
                            <label for="quote-message">Project Details / Requirements</label>
                            <textarea id="quote-message" name="message" rows="3" class="form-control"
                              placeholder="Describe your pool requirements, specifications, or preferred design..."></textarea>
                          </div>

                          <button type="submit" class="btn btn-yellow"
                            style="width: 100%; padding: 14px; font-size: 1rem; border-radius: var(--radius-sm); font-weight: 700;">
                            <i class="fa-solid fa-paper-plane"></i> Submit Quotation Request
                          </button>
                        </form>
              </div>
            </div>
          </div>
        </div>
      </section>

      <%- include('layouts/footer') %>