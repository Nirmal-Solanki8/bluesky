<%- include('layouts/header') %>

  <!-- ===================================================================
     HERO SECTION (MATCHING CRYSTAL POOLS REFERENCE)
     - Live Animated Pool Background
     - Clean, Bold Typography with Typing Animation ("We build Bespoke Pools|")
     - Luxury Sub-description
     - NO Hero Buttons (Removed as requested by user)
     - Sleek Bottom "SCROLL" Indicator
     =================================================================== -->
  <section class="hero-live-container">
    <!-- Live Animated Background -->
    <div class="hero-live-bg"></div>

    <div class="container-hero-wide">
      <div class="hero-live-content">
        <h1 class="hero-main-heading">
          We build<br>
          <span class="hero-highlight-word"><span id="typing-text">Bespoke Pools</span><span
              class="typing-cursor">|</span></span>
        </h1>

        <p class="hero-sub-description">
          Architectural turnkey swimming pools engineered with leakproof monolithic RCC, infinity horizons, and advanced
          bio-active water filtration. Crafted for luxury villas, penthouses, and 5-star international resorts across
          India and worldwide.
        </p>

        <!-- Hero Buttons removed per user request for ultra-clean luxury look -->
      </div>
    </div>

    <!-- SCROLL Indicator at bottom center -->
    <a href="#dive-section" class="hero-scroll-indicator" aria-label="Scroll down">
      <span>SCROLL</span>
      <div class="scroll-line"></div>
    </a>
  </section>

  <!-- ===================================================================
     SECTION 2: "DIVE INTO EXCELLENCE" (MATCHING SCREENSHOT 1 & 2)
     - Clean Left Typography with Minimalist Pill Tabs
     - Right Column: 3D Jumping & Tilting Sunset Pool Card
     - Aquatic SVG Wave Background
     =================================================================== -->
  <!-- ===================================================================
     SECTION 2: "DIVE INTO EXCELLENCE" - MINIMALIST APPLE LUXURY SHOWCASE
     Exact Side-by-Side Layout with Frosted Glass Pills & Spacious Elegance
     =================================================================== -->
  <section class="section dive-into-excellence-section has-svg-water-bg" id="dive-section">
    <div class="container-wide">
      <div class="dive-apple-grid">

        <!-- Left Column: Pure Clean Minimalist Apple Typography & Frosted Pills -->
        <div class="dive-apple-content">
          <span class="apple-section-tag">
            <i class="fa-solid fa-water"></i> SWIMMING POOLS
          </span>

          <h2 class="apple-dive-heading">
            Dive into<br>Excellence
          </h2>

          <p class="apple-dive-desc">
            Discover our diverse range of luxury pools, engineered for beauty, durability, and a pristine swimming
            experience. Scroll through or tap any style to explore our architectural designs.
          </p>

          <!-- Sleek Frosted Glass Pills (Apple Style - No dots, Clean Glass Hover & Active) -->
          <div class="apple-pills-wrap" role="tablist" aria-label="Swimming Pool Styles">
            <button class="apple-pill-btn active" data-index="0" data-img="/images/infinity-pool.jpg"
              data-tag="Bespoke Architecture" data-title="Infinity Horizon Pools">
              Infinity Pools
            </button>
            <button class="apple-pill-btn" data-index="1" data-img="/images/resort-pool.jpg"
              data-tag="Resort & Hospitality" data-title="Resort Lagoons & Club Pools">
              Resort Pools
            </button>
            <button class="apple-pill-btn" data-index="2" data-img="/images/rooftop-pool.jpg"
              data-tag="Penthouse Living" data-title="Luxury Rooftop Glass Pools">
              Rooftop Pools
            </button>
            <button class="apple-pill-btn" data-index="3" data-img="/images/jacuzzi-spa.jpg"
              data-tag="Hydrotherapy Spas" data-title="Thermal Heated Jacuzzis">
              Jacuzzi & Spas
            </button>
            <button class="apple-pill-btn" data-index="4" data-img="/images/private-pool-hero.webp"
              data-tag="Private Villa" data-title="Skimmer & Overflow Villa Pools">
              Private Pools
            </button>
          </div>

          <div class="apple-link-wrap">
            <a href="/pool-types" class="apple-explore-link">
              <span>EXPLORE ALL 9 POOL TYPES</span>
              <i class="fa-solid fa-arrow-right"></i>
            </a>
          </div>
        </div>

        <!-- Right Column: Sunset Ocean Pool Card that Jumps & Tilts (Elevated Apple Style) -->
        <div class="dive-apple-card-col">
          <div class="jump-card-stage" id="jumpCardStage">
            <div class="apple-image-card" id="jumpImageCard">
              <img src="/images/infinity-pool.jpg" alt="Infinity Horizon Pool" id="jumpCardImg" class="apple-card-img"
                width="560" height="380" decoding="async" loading="lazy">

              <div class="apple-card-caption">
                <span class="apple-caption-tag" id="jumpCaptionTag">Bespoke Architecture</span>
                <h3 class="apple-caption-title" id="jumpCaptionTitle">Infinity Horizon Pools</h3>
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ===================================================================
     SECTION 3: "OUR PREMIUM SERVICES" FULL-WIDTH BENTO GRID
     (MATCHING SCREENSHOT 3 & 4)
     =================================================================== -->
