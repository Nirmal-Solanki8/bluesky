<%- include('layouts/header') %>

<!-- Main Landmark Container (Accessibility Compliant) -->
<main id="main-content" role="main">

<!-- Hero Section -->
<section class="luxury-hero-container" id="luxuryHeroSection">
  <!-- Automatic Luxury Background Slider (Sliding to Left via transform: translateX) -->
  <div class="luxury-hero-slider" id="luxuryHeroSlider" aria-hidden="true">
    <div class="luxury-hero-track" id="luxuryHeroTrack">
      <div class="luxury-hero-slide" style="background-image: linear-gradient(180deg, rgba(8, 11, 16, 0.55) 0%, rgba(8, 11, 16, 0.3) 45%, rgba(8, 11, 16, 0.92) 100%), url('/images/private-pool-hero.webp');"></div>
      <div class="luxury-hero-slide" data-bg="/images/infinity-pool.webp"></div>
      <div class="luxury-hero-slide" data-bg="/images/resort-pool.webp"></div>
      <div class="luxury-hero-slide" data-bg="/images/rooftop-pool.webp"></div>
      <div class="luxury-hero-slide" data-bg="/images/jacuzzi-spa.webp"></div>
      <!-- Seamless loop clone of first slide -->
      <div class="luxury-hero-slide" data-bg="/images/private-pool-hero.webp"></div>
    </div>
  </div>

  <!-- Ambient Light Caustic Overlay -->
  <div class="luxury-hero-caustics"></div>

  <!-- Perfectly Fitted 100vh Foreground Container -->
  <div class="container position-relative h-100 d-flex flex-column justify-content-center" style="z-index: 10;">
    <div class="row align-items-center">
      <div class="col-lg-10 col-xl-9">
        
        <!-- Architectural Status Badge -->
        <div class="section-tag-luxury mb-3">
          <i class="bi bi-gem"></i> Bespoke Architectural Pool Engineering
        </div>

        <!-- Headline with GSAP Word-Fading / Sliding Effect -->
        <h1 class="luxury-heading mb-3">
          Architects of<br>
          <span class="hero-sliding-headline-wrap">
            <span class="hero-animated-word" id="heroAnimatedHeadline">Turnkey Resort Lagoons</span>
          </span>
        </h1>

        <p class="luxury-subtext mb-3" style="color: #E2E8F0 !important; font-size: clamp(0.95rem, 1.05vw, 1.08rem); line-height: 1.65; max-width: 720px;">
          Monolithic leakproof RCC swimming pools, vanishing edge horizons, and bio-filtration engineering. Engineered for high-net-worth private villa estates, penthouses, and 5-star international resorts across India and worldwide.
        </p>

        <!-- Luxury Action Buttons -->
        <div class="d-flex flex-wrap gap-3 pt-1 mb-3">
          <a href="/contact#quote-form" class="luxury-cta-btn" style="padding: 11px 28px; font-size: 0.92rem;" onclick="window.openConsultationModal(event)">
            <i class="bi bi-calendar2-check"></i> Request Consultation
          </a>
          <a href="#portfolio-showcase" class="btn btn-outline-light d-inline-flex align-items-center gap-2"
            style="border-radius: var(--radius-pill); padding: 10px 24px; font-weight: 600; font-size: 0.92rem; border-color: rgba(255,255,255,0.25); background: rgba(15,23,42,0.5); backdrop-filter: blur(10px); color: #FFFFFF;">
            <span>Explore Masterpieces</span>
            <i class="bi bi-arrow-down-right"></i>
          </a>
        </div>

        <!-- Trust Badges Strip -->
        <div class="d-flex flex-wrap align-items-center gap-3 gap-md-4 pt-2 small" style="border-top: 1px solid rgba(255,255,255,0.15); color: #E2E8F0;">
          <div class="d-flex align-items-center gap-2">
            <i class="bi bi-shield-check text-gold fs-5"></i>
            <span class="fw-semibold" style="color: #F8FAFC;">100% Leakproof Monolithic RCC</span>
          </div>
          <div class="d-flex align-items-center gap-2">
            <i class="bi bi-patch-check text-gold fs-5"></i>
            <span class="fw-semibold" style="color: #F8FAFC;">ISO 9001:2015 Certified</span>
          </div>
          <div class="d-flex align-items-center gap-2">
            <i class="bi bi-clock-history text-gold fs-5"></i>
            <span class="fw-semibold" style="color: #F8FAFC;"><%= typeof settings !== 'undefined' && settings.experienceYears ? settings.experienceYears : 16 %>+ Years Turnkey Mastery</span>
          </div>
        </div>

      </div>
    </div>
  </div>

  <!-- Subtle Elegant Navigation Dots -->
  <div class="luxury-slider-nav" id="luxurySliderNav" role="tablist" aria-label="Hero background image slider navigation">
    <button type="button" class="luxury-slider-dot active" data-slide="0" role="tab" aria-selected="true" aria-label="Slide 1: Private Villa Pool"></button>
    <button type="button" class="luxury-slider-dot" data-slide="1" role="tab" aria-selected="false" aria-label="Slide 2: Infinity Edge Pool"></button>
    <button type="button" class="luxury-slider-dot" data-slide="2" role="tab" aria-selected="false" aria-label="Slide 3: Turnkey Resort Lagoon"></button>
    <button type="button" class="luxury-slider-dot" data-slide="3" role="tab" aria-selected="false" aria-label="Slide 4: Luxury Rooftop Pool"></button>
    <button type="button" class="luxury-slider-dot" data-slide="4" role="tab" aria-selected="false" aria-label="Slide 5: Hydrotherapy Jacuzzi Spa"></button>
  </div>

  <!-- Bottom Scroll Indicator -->
  <a href="#stats-strip" class="hero-scroll-indicator" aria-label="Scroll down">
    <span style="color: #CBD5E1;">SCROLL</span>
    <div class="scroll-line"></div>
  </a>
</section>

<!-- Stats Bar -->
<section class="luxury-stats-strip" id="stats-strip">
  <div class="container">
    <div class="row g-4 justify-content-center">
      
      <div class="col-6 col-lg-3">
        <div class="luxury-stat-card">
          <div class="stat-number-glow counter-animate" data-count="<%= typeof settings !== 'undefined' && settings.experienceYears ? settings.experienceYears : 16 %>" data-suffix="+"><%= typeof settings !== 'undefined' && settings.experienceYears ? settings.experienceYears : 16 %>+</div>
          <div class="stat-label-subtle">Years of Excellence</div>
        </div>
      </div>

      <div class="col-6 col-lg-3">
        <div class="luxury-stat-card">
          <div class="stat-number-glow counter-animate" data-count="<%= typeof settings !== 'undefined' && settings.poolsBuilt ? settings.poolsBuilt : 720 %>" data-suffix="+"><%= typeof settings !== 'undefined' && settings.poolsBuilt ? settings.poolsBuilt : 720 %>+</div>
          <div class="stat-label-subtle">Luxury Pools Built</div>
        </div>
      </div>

      <div class="col-6 col-lg-3">
        <div class="luxury-stat-card">
          <div class="stat-number-glow counter-animate" data-count="100" data-suffix="%">100%</div>
          <div class="stat-label-subtle">Leakproof Guarantee</div>
        </div>
      </div>

      <div class="col-6 col-lg-3">
        <div class="luxury-stat-card">
          <div class="stat-number-glow text-gradient-gold">SURAT</div>
          <div class="stat-label-subtle">Gujarat Studio & HQ</div>
        </div>
      </div>

    </div>
  </div>
</section>

<!-- Before / After Slider -->
<section class="py-5 my-4" id="engineering-slider">
  <div class="container">
    <div class="text-center max-w-700 mx-auto mb-5">
      <div class="section-tag-luxury">
        <i class="bi bi-rulers"></i> Turnkey Engineering Precision
      </div>
      <h2 class="font-serif text-white display-6 fw-bold mb-3">
        From Monolithic RCC to Finished Oasis
      </h2>
      <p class="luxury-subtext mx-auto" style="font-size: 1.08rem; color: #E2E8F0 !important; max-width: 760px;">
        Drag the interactive slider below to inspect our heavy rebar reinforced concrete shell during structural pouring versus the handed-over 5-star vanishing edge horizon pool.
      </p>
    </div>

    <!-- Before / After Slider Container -->
    <div class="before-after-wrapper">
      <div class="before-after-container" aria-label="Interactive before and after pool construction slider">
        
        <!-- BEFORE LAYER: Raw RCC Construction -->
        <div class="ba-layer ba-before">
          <img src="/images/rcc-construction.webp" alt="Raw Monolithic RCC Swimming Pool Under Construction" class="ba-img" width="1200" height="675" loading="lazy" decoding="async">
          <div class="ba-badge ba-badge-before">
            <i class="bi bi-cone-striped me-1"></i> Phase 1: Raw RCC Rebar Structure
          </div>
        </div>

        <!-- AFTER LAYER: Completed Luxury Pool -->
        <div class="ba-layer ba-after">
          <img src="/images/infinity-pool.webp" alt="Completed 5-Star Luxury Vanishing Edge Pool" class="ba-img" width="1200" height="675" loading="lazy" decoding="async">
          <div class="ba-badge ba-badge-after">
            <i class="bi bi-check2-circle me-1"></i> Phase 5: Completed 5-Star Sanctuary
          </div>
        </div>

        <!-- Draggable Handle Divider -->
        <div class="ba-handle">
          <div class="ba-handle-line"></div>
          <div class="ba-handle-circle" title="Drag left or right">
            <i class="bi bi-chevron-left"></i>
            <i class="bi bi-chevron-right"></i>
          </div>
          <div class="ba-handle-line"></div>
        </div>

      </div>

      <!-- Architectural Blueprint Specification Grid -->
      <div class="blueprint-spec-grid mt-3">
        <div class="blueprint-spec-item">
          <span class="blueprint-spec-label">Concrete Grade</span>
          <span class="blueprint-spec-val">M-30 Monolithic</span>
        </div>
        <div class="blueprint-spec-item">
          <span class="blueprint-spec-label">Steel Rebar Mesh</span>
          <span class="blueprint-spec-val">Fe-500D Dual Grid</span>
        </div>
        <div class="blueprint-spec-item">
          <span class="blueprint-spec-label">Waterproofing</span>
          <span class="blueprint-spec-val">Polymer Crystalline</span>
        </div>
        <div class="blueprint-spec-item">
          <span class="blueprint-spec-label">Hydro-Ponding</span>
          <span class="blueprint-spec-val">72h Zero Leak Test</span>
        </div>
        <div class="blueprint-spec-item">
          <span class="blueprint-spec-label">Commissioning</span>
          <span class="blueprint-spec-val">Automated Bio-Clean</span>
        </div>
      </div>
    </div>

  </div>
</section>

<!-- Section 2: Architectural Formats -->
<section class="section dive-into-excellence-section" id="dive-section">
  <div class="container-wide">
    <div class="dive-apple-grid">

      <!-- Left Column: Typography & Frosted Glass Pills -->
      <div class="dive-apple-content">
        <span class="section-tag-luxury">
          <i class="bi bi-water"></i> Architectural Formats
        </span>

        <h2 class="apple-dive-heading">
          Dive into<br>Excellence
        </h2>

        <p class="apple-dive-desc">
          Discover our curated spectrum of architectural formats, engineered for monolithic durability, crystal water reflection, and peerless aesthetics.
        </p>

        <!-- Frosted Glass Pills Tablist -->
        <div class="apple-pills-wrap" role="tablist" aria-label="Swimming Pool Styles">
          <button class="apple-pill-btn active" role="tab" aria-selected="true" data-index="0" data-img="/images/infinity-pool.webp"
            data-tag="Bespoke Architecture" data-title="Infinity Horizon Pools">
            Infinity Pools
          </button>
          <button class="apple-pill-btn" role="tab" aria-selected="false" data-index="1" data-img="/images/resort-pool.webp"
            data-tag="Resort & Hospitality" data-title="Resort Lagoons & Club Pools">
            Resort Pools
          </button>
          <button class="apple-pill-btn" role="tab" aria-selected="false" data-index="2" data-img="/images/rooftop-pool.webp"
            data-tag="Penthouse Living" data-title="Luxury Rooftop Glass Pools">
            Rooftop Pools
          </button>
          <button class="apple-pill-btn" role="tab" aria-selected="false" data-index="3" data-img="/images/jacuzzi-spa.webp"
            data-tag="Hydrotherapy Spas" data-title="Thermal Heated Jacuzzis">
            Jacuzzi & Spas
          </button>
          <button class="apple-pill-btn" role="tab" aria-selected="false" data-index="4" data-img="/images/private-pool-hero.webp"
            data-tag="Private Villa" data-title="Skimmer & Overflow Villa Pools">
            Private Pools
          </button>
        </div>

        <div class="apple-link-wrap pt-3">
          <a href="/pool-types" class="apple-explore-link">
            <span>EXPLORE ALL 9 ARCHITECTURAL TYPES</span>
            <i class="bi bi-arrow-right"></i>
          </a>
        </div>
      </div>

      <!-- Right Column: Elevated 3D Sunset Pool Card with Tilt & Jump -->
      <div class="dive-apple-card-col">
        <div class="jump-card-stage" id="jumpCardStage">
          <div class="apple-image-card tilt-card-3d" id="jumpImageCard">
            <img src="/images/infinity-pool.webp" alt="Infinity Horizon Pool" id="jumpCardImg" class="apple-card-img"
              width="560" height="380" decoding="async" loading="lazy">

            <div class="apple-card-caption">
              <span class="apple-caption-tag" id="jumpCaptionTag">Bespoke Architecture</span>
              <h3 class="apple-caption-title" id="jumpCaptionTitle">Infinity Horizon Pools</h3>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<!-- Section 3: Premium Services -->
<section class="section-fullwidth premium-services-section" id="premium-services">
  <div class="container-wide">
    <div class="section-head text-center max-w-700 mx-auto mb-5">
      <div class="section-tag-luxury">
        <i class="bi bi-gem"></i> Turnkey Capability
      </div>
      <h2 class="services-main-title">Our Turnkey Services</h2>
      <p class="luxury-subtext mx-auto" style="color: #CBD5E1 !important; font-size: 1.05rem; max-width: 720px;">
        Comprehensive end-to-end execution from geotechnical survey and monolithic civil pouring to handcrafted glass mosaics and automated hydraulic MEP.
      </p>
    </div>

    <!-- Full-Width Bento Grid -->
    <div class="bento-services-grid-fluid">

      <!-- Card 1: Turnkey Pools (Large Highlight Card) -->
      <div class="bento-card bento-col-2 tilt-card-3d">
        <img src="/images/private-pool-hero.webp" alt="Turnkey Swimming Pools" class="bento-bg-img" width="680"
          height="360" loading="lazy" decoding="async">
        <div class="bento-overlay">
          <div class="bento-content">
            <span class="blueprint-badge blueprint-badge-gold mb-2">Civil & Hydraulic</span>
            <h3 class="bento-title">Turnkey Swimming Pools</h3>
            <p class="bento-sub">Monolithic RCC casting, structural leakproofing, vanishing edge troughs & FINA standard MEP.</p>
            <a href="/private-swimming-pools" class="bento-link">
              EXPLORE DESIGNS <i class="bi bi-arrow-right"></i>
            </a>
          </div>
        </div>
      </div>

      <!-- Card 2: Waterfall & Fountain -->
      <div class="bento-card tilt-card-3d">
        <img src="/images/pool-types/vanishing-edge.webp" alt="Waterfall & fountain" class="bento-bg-img" width="340"
          height="360" loading="lazy" decoding="async">
        <div class="bento-overlay">
          <div class="bento-content">
            <span class="blueprint-badge mb-2">Aquatic Features</span>
            <h3 class="bento-title">Waterfall & Fountain</h3>
            <p class="bento-sub">Sheer descent curtains, laminar arch jets, and programmable water walls.</p>
            <a href="/services#waterfalls" class="bento-link">
              LEARN MORE <i class="bi bi-arrow-right"></i>
            </a>
          </div>
        </div>
      </div>

      <!-- Card 3: Pool Tiles & Mosaics -->
      <div class="bento-card tilt-card-3d">
        <img src="/images/pool-types/overflow.webp" alt="Pool tiles and mosaics" class="bento-bg-img" width="340"
          height="360" loading="lazy" decoding="async">
        <div class="bento-overlay">
          <div class="bento-content">
            <span class="blueprint-badge mb-2">Surfaces</span>
            <h3 class="bento-title">Pool Tiles & Mosaics</h3>
            <p class="bento-sub">Bespoke glass mosaics, underwater murals, and Spanish non-slip porcelain.</p>
            <a href="/products?category=Pool%20Tiles%20%26%20Mosaics" class="bento-link">
              VIEW MOSAICS <i class="bi bi-arrow-right"></i>
            </a>
          </div>
        </div>
      </div>

      <!-- Card 4: Accessories & Equipment -->
      <div class="bento-card tilt-card-3d">
        <img src="/images/pool-types/commercial.webp" alt="Accessories and equipment" class="bento-bg-img" width="340"
          height="360" loading="lazy" decoding="async">
        <div class="bento-overlay">
          <div class="bento-content">
            <span class="blueprint-badge mb-2">Hydraulics</span>
            <h3 class="bento-title">Filtration & Pumps</h3>
            <p class="bento-sub">Variable-speed inverter pumps, commercial sand filters, and RGBW LED lighting.</p>
            <a href="/products?category=Pool%20Filtration%20%26%20Pumps" class="bento-link">
              EQUIPMENT CATALOG <i class="bi bi-arrow-right"></i>
            </a>
          </div>
        </div>
      </div>

      <!-- Card 5: Readymade FRP pools -->
      <div class="bento-card tilt-card-3d">
        <img src="/images/rooftop-pool.webp" alt="Readymade FRP pools" class="bento-bg-img" width="340" height="360"
          loading="lazy" decoding="async">
        <div class="bento-overlay">
          <div class="bento-content">
            <span class="blueprint-badge mb-2">Rapid Install</span>
            <h3 class="bento-title">Readymade FRP Pools</h3>
            <p class="bento-sub">High-strength composite fiberglass shells delivered and installed within 7 days.</p>
            <a href="/pool-types#readymade-frp" class="bento-link">
              FRP MODELS <i class="bi bi-arrow-right"></i>
            </a>
          </div>
        </div>
      </div>

      <!-- Card 6: Renovation & Waterproofing (Span 2) -->
      <div class="bento-card bento-col-2 tilt-card-3d">
        <img src="/images/resort-pool.webp" alt="Renovation and waterproofing" class="bento-bg-img" width="680"
          height="360" loading="lazy" decoding="async">
        <div class="bento-overlay">
          <div class="bento-content">
            <span class="blueprint-badge blueprint-badge-gold mb-2">Restoration</span>
            <h3 class="bento-title">Renovation & Structural Leak Repair</h3>
            <p class="bento-sub">High-pressure epoxy injection, crystalline regrouting, tile replacement, and energy retrofit.</p>
            <a href="/services#renovation" class="bento-link">
              SCHEDULE SURVEY <i class="bi bi-arrow-right"></i>
            </a>
          </div>
        </div>
      </div>

      <!-- Card 7: Maintenance & AMC -->
      <div class="bento-card tilt-card-3d">
        <img src="/images/jacuzzi-spa.webp" alt="Maintenance & AMC" class="bento-bg-img" width="340" height="360"
          loading="lazy" decoding="async">
        <div class="bento-overlay">
          <div class="bento-content">
            <span class="blueprint-badge mb-2">Annual Care</span>
            <h3 class="bento-title">Maintenance & AMC</h3>
            <p class="bento-sub">Automated water balancing, robotic vacuum sweeps, and scheduled pump servicing.</p>
            <a href="/services#maintenance" class="bento-link">
              EXPLORE AMC <i class="bi bi-arrow-right"></i>
            </a>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<!-- Section 4: Featured Masterpieces -->
<section class="section" id="portfolio-showcase">
  <div class="container-wide">
    <div class="d-flex justify-content-between align-items-end mb-4 flex-wrap gap-3">
      <div>
        <div class="section-tag-luxury">
          <i class="bi bi-trophy"></i> Masterpiece Portfolio
        </div>
        <h2 class="font-serif text-white display-6 fw-bold mb-0">Featured Completed Projects</h2>
      </div>
      <div class="w-100 w-md-auto">
        <a href="/gallery" class="luxury-cta-btn w-100 w-md-auto justify-content-center text-center" style="padding: 10px 24px; font-size: 0.88rem;">
          View Complete Gallery (<%= typeof projects !== 'undefined' && projects ? projects.length : 12 %>+) &rarr;
        </a>
      </div>
    </div>

    <div class="row g-4">
      <% if (typeof projects !== 'undefined' && projects && projects.length > 0) { %>
        <% projects.slice(0, 3).forEach(project => { %>
          <div class="col-lg-4 col-md-6">
            <div class="portfolio-home-card tilt-card-3d" 
                 data-img="<%= project.coverImage || '/images/infinity-pool.jpg' %>"
                 data-title="<%= project.title %>"
                 data-category="<%= project.category %>"
                 onclick="window.openLuxuryLightbox(this.dataset.img, this.dataset.title, this.dataset.category)"
                 style="cursor: pointer;">
              <img src="<%= project.coverImage || '/images/infinity-pool.jpg' %>"
                alt="<%= project.title || 'Luxury Swimming Pool' %>" class="portfolio-home-img" width="400" height="280"
                loading="lazy" decoding="async" onerror="this.src='/images/infinity-pool.jpg'">
              <div class="portfolio-home-overlay">
                <span class="portfolio-home-tag">
                  <%= project.category %>
                </span>
                <h3 class="portfolio-home-title">
                  <%= project.title %>
                </h3>
                <div class="portfolio-home-meta">
                  <i class="bi bi-geo-alt text-gold me-1"></i>
                  <%= project.location %> • <%= project.completionYear %>
                </div>
              </div>
            </div>
          </div>
        <% }) %>
      <% } else { %>
        <div class="col-lg-4 col-md-6">
          <div class="portfolio-home-card tilt-card-3d" 
               onclick="window.openLuxuryLightbox('/images/infinity-pool.webp', 'Katargam Luxury Villa Estate', 'Residential Villa')"
               style="cursor: pointer;">
            <img src="/images/infinity-pool.webp" alt="Infinity Villa" class="portfolio-home-img" width="400"
              height="280" loading="lazy" decoding="async">
            <div class="portfolio-home-overlay">
              <span class="portfolio-home-tag">Residential Villa</span>
              <h3 class="portfolio-home-title">Katargam Luxury Villa Estate</h3>
              <div class="portfolio-home-meta"><i class="bi bi-geo-alt text-gold me-1"></i> Surat, Gujarat • 2024</div>
            </div>
          </div>
        </div>
        <div class="col-lg-4 col-md-6">
          <div class="portfolio-home-card tilt-card-3d"
               onclick="window.openLuxuryLightbox('/images/rooftop-pool.webp', 'Bodakdev Horizon Lagoon', 'Penthouse Sky Pool')"
               style="cursor: pointer;">
            <img src="/images/rooftop-pool.webp" alt="Bodakdev Penthouse" class="portfolio-home-img" width="400"
              height="280" loading="lazy" decoding="async">
            <div class="portfolio-home-overlay">
              <span class="portfolio-home-tag">Penthouse Sky Pool</span>
              <h3 class="portfolio-home-title">Bodakdev Horizon Lagoon</h3>
              <div class="portfolio-home-meta"><i class="bi bi-geo-alt text-gold me-1"></i> Ahmedabad, Gujarat • 2023</div>
            </div>
          </div>
        </div>
        <div class="col-lg-4 col-md-6">
          <div class="portfolio-home-card tilt-card-3d"
               onclick="window.openLuxuryLightbox('/images/resort-pool.webp', 'The Grand Palace Oasis', 'Commercial Resort')"
               style="cursor: pointer;">
            <img src="/images/resort-pool.webp" alt="Club Resort" class="portfolio-home-img" width="400"
              height="280" loading="lazy" decoding="async">
            <div class="portfolio-home-overlay">
              <span class="portfolio-home-tag">Commercial Resort</span>
              <h3 class="portfolio-home-title">The Grand Palace Oasis</h3>
              <div class="portfolio-home-meta"><i class="bi bi-geo-alt text-gold me-1"></i> Mumbai, Maharashtra • 2024</div>
            </div>
          </div>
        </div>
      <% } %>
    </div>
  </div>
</section>

<!-- Section 5: Turnkey Process -->
<section class="section py-5 my-4" style="background: rgba(15, 23, 42, 0.45);">
  <div class="container-wide">
    <div class="section-head text-center max-w-700 mx-auto mb-5">
      <div class="section-tag-luxury">
        <i class="bi bi-compass"></i> Engineering Precision
      </div>
      <h2 class="font-serif text-white display-6 fw-bold mb-3">Our 5-Stage Turnkey Process</h2>
      <p class="luxury-subtext mx-auto" style="font-size: 1.05rem; color: #CBD5E1 !important; max-width: 720px;">
        From topographical laser site survey to the crystal-clear first splash, every phase is engineered by our in-house civil and hydraulic masters.
      </p>
    </div>

    <div class="process-grid">
      <div class="process-step-card glass-card">
        <span class="process-num">01</span>
        <h3 class="process-title text-white">3D CAD Modeling</h3>
        <p class="process-desc" style="color: #CBD5E1 !important;">Site laser survey, soil mechanics analysis, hydraulic sizing, and photorealistic 3D visualization.</p>
      </div>

      <div class="process-step-card glass-card">
        <span class="process-num">02</span>
        <h3 class="process-title text-white">Monolithic RCC</h3>
        <p class="process-desc" style="color: #CBD5E1 !important;">Precision excavation, heavy steel rebar mesh cage, and monolithic concrete pouring with zero cold joints.</p>
      </div>

      <div class="process-step-card glass-card">
        <span class="process-num">03</span>
        <h3 class="process-title text-white">Dual Waterproofing</h3>
        <p class="process-desc" style="color: #CBD5E1 !important;">Polymer crystalline barrier injection with rigorous 72-hour static water ponding leakage tests.</p>
      </div>

      <div class="process-step-card glass-card">
        <span class="process-num">04</span>
        <h3 class="process-title text-white">Mosaics & MEP</h3>
        <p class="process-desc" style="color: #CBD5E1 !important;">Designer Spanish glass mosaic tiling, filtration manifold, automated pumps & RGBW LED lighting installation.</p>
      </div>

      <div class="process-step-card glass-card">
        <span class="process-num">05</span>
        <h3 class="process-title text-white">Handover & Care</h3>
        <p class="process-desc" style="color: #CBD5E1 !important;">Water chemistry balancing, salt chlorination commissioning, owner handover, and lifetime warranty issuance.</p>
      </div>
    </div>
  </div>
</section>

<!-- Section 6: Client Testimonials -->
