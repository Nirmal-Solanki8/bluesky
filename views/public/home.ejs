  <!-- ===================================================================
     SECTION 4: FEATURED MASTERPIECES SHOWCASE (PORTFOLIO PREVIEW)
     =================================================================== -->
  <section class="section has-svg-water-bg" id="portfolio-showcase">
    <div class="container-wide">
      <div
        style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 45px; flex-wrap: wrap; gap: 20px;">
        <div>
          <span class="section-tag-gold"><i class="fa-solid fa-trophy"></i> Masterpiece Portfolio</span>
          <h2 class="dive-heading" style="margin-bottom: 0;">Featured Completed Projects</h2>
        </div>
        <div>
          <a href="/gallery" class="filter-pill active">
            View Complete Gallery (<%= projects ? projects.length : 0 %>+) &rarr;
          </a>
        </div>
      </div>

      <div class="portfolio-grid-home">
        <% if (projects && projects.length> 0) { %>
          <% projects.slice(0, 3).forEach(project=> { %>
            <div class="portfolio-home-card">
              <img src="<%= project.coverImage || '/images/infinity-pool.jpg' %>"
                alt="<%= project.title || 'Luxury Swimming Pool' %>" class="portfolio-home-img" width="400" height="280"
                loading="lazy" decoding="async" onerror="this.src='/images/infinity-pool.jpg'">
              <div class="portfolio-home-overlay">
                <span class="portfolio-home-tag">
                  <%= project.category %>
                </span>
                <h3 class="portfolio-home-title">
                  <%= project.title %>
                </h3>
                <div class="portfolio-home-meta">
                  <i class="fa-solid fa-location-dot" style="color: var(--brand-yellow);"></i>
                  <%= project.location %> • <%= project.completionYear %>
                </div>
              </div>
            </div>
            <% }) %>
              <% } else { %>
                <div class="portfolio-home-card">
                  <img src="/images/infinity-pool.jpg" alt="Infinity Villa" class="portfolio-home-img" width="400"
                    height="280" loading="lazy" decoding="async">
                  <div class="portfolio-home-overlay">
                    <span class="portfolio-home-tag">Residential Villa</span>
                    <h3 class="portfolio-home-title">Katargam Luxury Villa Estate</h3>
                    <div class="portfolio-home-meta"><i class="fa-solid fa-location-dot"
                        style="color: var(--brand-yellow);"></i> Surat, Gujarat • 2024</div>
                  </div>
                </div>
                <div class="portfolio-home-card">
                  <img src="/images/rooftop-pool.jpg" alt="Bodakdev Penthouse" class="portfolio-home-img" width="400"
                    height="280" loading="lazy" decoding="async">
                  <div class="portfolio-home-overlay">
                    <span class="portfolio-home-tag">Penthouse Sky Pool</span>
                    <h3 class="portfolio-home-title">Bodakdev Horizon Lagoon</h3>
                    <div class="portfolio-home-meta"><i class="fa-solid fa-location-dot"
                        style="color: var(--brand-yellow);"></i> Ahmedabad, Gujarat • 2023</div>
                  </div>
                </div>
                <div class="portfolio-home-card">
                  <img src="/images/resort-pool.jpg" alt="Club Resort" class="portfolio-home-img" width="400"
                    height="280" loading="lazy" decoding="async">
                  <div class="portfolio-home-overlay">
                    <span class="portfolio-home-tag">Commercial Resort</span>
                    <h3 class="portfolio-home-title">The Grand Palace Oasis</h3>
                    <div class="portfolio-home-meta"><i class="fa-solid fa-location-dot"
                        style="color: var(--brand-yellow);"></i> Mumbai, Maharashtra • 2024</div>
                  </div>
                </div>
                <% } %>
      </div>
    </div>
  </section>

  <!-- ===================================================================
     SECTION 4.5: FEATURED POOL HARDWARE & PRODUCTS
     =================================================================== -->
  <% if (products && products.length> 0) { %>
    <section class="section" id="featured-products" style="background: #ffffff;">
      <div class="container-wide">
        <div
          style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 45px; flex-wrap: wrap; gap: 20px;">
          <div>
            <span class="section-tag-gold"><i class="fa-solid fa-gears"></i> Hardware & Technology</span>
            <h2 class="dive-heading" style="margin-bottom: 0;">Featured Equipment & Products</h2>
          </div>
          <div>
            <a href="/products" class="filter-pill active">
              View All Products &rarr;
            </a>
          </div>
        </div>

        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr)); gap: clamp(16px, 3vw, 25px);">
          <% products.forEach(prod=> { %>
            <div
              style="background: var(--bg-card); border-radius: var(--radius-md); padding: 22px; border: 1px solid var(--border-subtle); box-shadow: var(--shadow-sm); display: flex; flex-direction: column; transition: transform 0.3s ease, box-shadow 0.3s ease;">
              <div
                style="height: 180px; width: 100%; overflow: hidden; border-radius: 8px; margin-bottom: 16px; background: #f8fafc; display: flex; align-items: center; justify-content: center;">
                <img src="<%= prod.image || '/images/infinity-pool.jpg' %>"
                  alt="<%= prod.name || 'Swimming Pool Product' %>" width="280" height="180" loading="lazy"
                  decoding="async" style="width: 100%; height: 100%; object-fit: cover;"
                  onerror="this.src='/images/infinity-pool.jpg'">
              </div>
              <span
                style="font-size: 0.75rem; color: var(--primary-cyan); text-transform: uppercase; font-weight: 700; margin-bottom: 6px;">
                <%= prod.category %>
              </span>
              <h3 style="font-size: 1.1rem; font-weight: 700; color: var(--text-main); margin-bottom: 8px;">
                <%= prod.name %>
              </h3>
              <p style="font-size: 0.88rem; color: var(--text-muted); margin-bottom: 16px; flex: 1; line-height: 1.5;">
                <%= prod.shortDescription %>
              </p>
              <div
                style="display: flex; justify-content: space-between; align-items: center; padding-top: 12px; border-top: 1px solid var(--border-subtle);">
                <% if (prod.price> 0) { %>
                  <div style="font-weight: 800; font-size: 1.15rem; color: var(--primary-cyan);">₹<%=
                      prod.price.toLocaleString('en-IN') %>
                  </div>
                  <% } else { %>
                    <span style="font-size: 0.85rem; color: var(--text-muted); font-weight: 600;">Custom Quote</span>
                    <% } %>
                      <a href="/contact?product=<%= encodeURIComponent(prod.name) %>#quote-form" class="btn btn-outline"
                        style="font-size: 0.8rem; padding: 7px 14px; border-radius: var(--radius-full);">
                        Inquire Now
                      </a>
              </div>
            </div>
            <% }) %>
        </div>
      </div>
    </section>
    <% } %>

      <!-- ===================================================================
     SECTION 5: 5-STAGE TURNKEY ARCHITECTURAL PROCESS
     =================================================================== -->
      <section class="section has-svg-water-bg" style="background: var(--bg-card-subtle);">
        <div class="container-wide">
          <div class="section-head" style="text-align: center; margin-bottom: 50px;">
            <span class="section-tag-gold"><i class="fa-solid fa-compass-drafting"></i> Engineering Precision</span>
            <h2 class="dive-heading">Our 5-Stage Turnkey Process</h2>
            <p style="color: var(--text-muted); font-size: 1.1rem; max-width: 720px; margin: 0 auto;">
              From initial topographical soil testing to the crystal-clear first splash, every phase is executed by our
              in-house civil and hydraulic engineers.
            </p>
          </div>

          <div class="process-grid">
            <div class="process-step-card">
              <span class="process-num">01</span>
              <h4 class="process-title">3D CAD Modeling</h4>
              <p class="process-desc">Site laser survey, soil mechanics analysis, hydraulic sizing, and photorealistic
                3D
                visualization.</p>
            </div>

            <div class="process-step-card">
              <span class="process-num">02</span>
              <h4 class="process-title">Monolithic RCC</h4>
              <p class="process-desc">Precision excavation, heavy steel rebar mesh cage, and monolithic concrete pouring
                with zero cold joints.</p>
            </div>

            <div class="process-step-card">
              <span class="process-num">03</span>
              <h4 class="process-title">Dual Waterproofing</h4>
              <p class="process-desc">Polymer crystalline barrier injection with rigorous 72-hour static water ponding
                leakage tests.</p>
            </div>

            <div class="process-step-card">
              <span class="process-num">04</span>
              <h4 class="process-title">Mosaics & MEP</h4>
              <p class="process-desc">Designer Spanish glass mosaic tiling, filtration manifold, automated pumps & RGBW
                LED
                lighting installation.</p>
            </div>

            <div class="process-step-card">
              <span class="process-num">05</span>
              <h4 class="process-title">Handover & Care</h4>
              <p class="process-desc">Water chemistry balancing, salt chlorination commissioning, owner handover, and
                warranty issuance.</p>
            </div>
          </div>
        </div>
      </section>

