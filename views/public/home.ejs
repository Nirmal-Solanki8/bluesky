              </a>
            </div>
          </div>
        </div>

        <!-- Card 5: Readymade FRP pools (Screenshot 4) -->
        <div class="bento-card">
          <img src="/images/rooftop-pool.jpg" alt="Readymade FRP pools" class="bento-bg-img" width="340" height="360"
            loading="lazy" decoding="async">
          <div class="bento-overlay">
            <div class="bento-content">
              <h3 class="bento-title">Readymade FRP pools</h3>
