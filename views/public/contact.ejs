<%- include('layouts/header') %>

<!-- Cinematic Hero -->
<section class="page-hero-cinematic">
  <div class="page-hero-bg" style="background-image: url('/images/rooftop-pool.webp');"></div>
  <div class="page-hero-overlay"></div>
  <div class="container position-relative" style="z-index: 10;">
    <div class="section-tag-luxury mb-3">
      <i class="bi bi-compass"></i> Blue Sky Architectural Design Studio
    </div>
    <h1 class="font-serif text-white display-5 fw-bold mb-3">
      Private Client Concierge & <span class="text-gradient-gold">Design Studio</span>
    </h1>
    <p class="luxury-subtext mb-0">
      Consult directly with our principal civil architects and hydraulic engineers. Whether designing a private villa sanctuary or a 5-star commercial resort horizon, we deliver end-to-end turnkey engineering across Gujarat & Western India.
    </p>
  </div>
</section>

<!-- Luxury Architectural Stats Strip -->
<div class="container-wide my-4">
  <div class="luxury-stats-strip">
    <div class="luxury-stat-card">
      <div class="luxury-stat-num">2 Hours</div>
      <div class="luxury-stat-label">Rapid Engineer Response</div>
      <p class="text-muted small mb-0 mt-1">Direct call from lead civil engineer</p>
    </div>
    <div class="luxury-stat-card">
      <div class="luxury-stat-num">Free</div>
      <div class="luxury-stat-label">3D Laser Site Feasibility</div>
      <p class="text-muted small mb-0 mt-1">Topography & soil bearing inspection</p>
    </div>
    <div class="luxury-stat-card">
      <div class="luxury-stat-num">100%</div>
      <div class="luxury-stat-label">Itemized Milestone BOQ</div>
      <p class="text-muted small mb-0 mt-1">Zero hidden costs, fixed price guarantee</p>
    </div>
    <div class="luxury-stat-card">
      <div class="luxury-stat-num">15-Yr</div>
      <div class="luxury-stat-label">Monolithic Shell Warranty</div>
      <p class="text-muted small mb-0 mt-1">Written legal warranty certificate</p>
    </div>
  </div>
</div>

<!-- Main Contact & Form Section -->
<section class="section py-5 my-2" id="quote-form">
  <div class="container-wide">
    <div class="row g-5">

      <!-- Contact Info & Studio Details -->
      <div class="col-lg-5">
        <div class="glass-card p-4 p-md-5 h-100 d-flex flex-column justify-content-between" style="border: 1px solid rgba(212, 175, 55, 0.25); background: rgba(15, 23, 42, 0.8);">
          <div>
            <div class="section-tag-luxury mb-3">
              <i class="bi bi-geo-alt"></i> Surat Corporate Headquarters
            </div>
            <h2 class="font-serif text-white mb-4" style="font-size: 1.85rem; line-height: 1.3;">
              Executive Design Studio & Workshop
            </h2>

            <!-- Address Item -->
            <div class="d-flex gap-3 mb-4">
              <div style="background: rgba(212, 175, 55, 0.15); width: 50px; height: 50px; border-radius: 12px; display: flex; align-items: center; justify-content: center; color: var(--gold-champagne); font-size: 1.3rem; flex-shrink: 0; border: 1px solid rgba(212, 175, 55, 0.3);">
                <i class="bi bi-geo-alt-fill"></i>
              </div>
              <div>
                <strong class="text-white d-block mb-1" style="font-size: 0.95rem;">Registered Studio Address</strong>
                <p class="text-muted small mb-2" style="line-height: 1.6;">
                  <%= typeof settings !== 'undefined' && settings.address ? settings.address : 'A-8, Laxmikant Ashram Rd, Rashi Circle, Bhulabhai Desai Park, Hari Darshan Society, Katargam, Surat, Gujarat 395004' %>
                </p>
                <a href="https://maps.google.com/?q=Katargam+Surat+Gujarat" target="_blank" rel="noopener noreferrer" class="text-gold small fw-semibold text-decoration-none hover-gold d-inline-flex align-items-center gap-1">
                  Open in Google Maps <i class="bi bi-box-arrow-up-right" style="font-size: 0.75rem;"></i>
                </a>
              </div>
            </div>

            <!-- Direct Phone Item -->
            <div class="d-flex gap-3 mb-4">
              <div style="background: rgba(212, 175, 55, 0.15); width: 50px; height: 50px; border-radius: 12px; display: flex; align-items: center; justify-content: center; color: var(--gold-champagne); font-size: 1.3rem; flex-shrink: 0; border: 1px solid rgba(212, 175, 55, 0.3);">
                <i class="bi bi-telephone-fill"></i>
              </div>
              <div>
                <strong class="text-white d-block mb-1" style="font-size: 0.95rem;">Direct Studio Consultation</strong>
                <p class="mb-1">
                  <a href="tel:<%= typeof settings !== 'undefined' && settings.phone ? settings.phone.replace(/[^0-9+]/g, '') : '+918128920702' %>"
                    class="text-decoration-none fw-bold hover-gold text-white" style="font-size: 1.05rem;">
                    <%= typeof settings !== 'undefined' && settings.phone ? settings.phone : '+91 81289 20702' %>
                  </a>
                </p>
                <span class="text-muted small">Direct line to Principal Civil Pool Engineer</span>
              </div>
            </div>

            <!-- WhatsApp Item -->
            <div class="d-flex gap-3 mb-4">
              <div style="background: rgba(37, 211, 102, 0.15); width: 50px; height: 50px; border-radius: 12px; display: flex; align-items: center; justify-content: center; color: #25d366; font-size: 1.3rem; flex-shrink: 0; border: 1px solid rgba(37, 211, 102, 0.3);">
                <i class="bi bi-whatsapp"></i>
              </div>
              <div>
                <strong class="text-white d-block mb-1" style="font-size: 0.95rem;">Instant WhatsApp Concierge</strong>
                <p class="mb-1">
                  <a href="https://wa.me/<%= (typeof settings !== 'undefined' && settings.whatsapp ? settings.whatsapp.replace(/[^0-9]/g, '') : '918128920702') %>?text=Hello%20Blue%20Sky,%20I%20would%20like%20to%20consult%20regarding%20a%20swimming%20pool%20project." target="_blank" rel="noopener noreferrer"
                    class="text-decoration-none fw-bold hover-gold" style="color: #25d366; font-size: 1.05rem;">
                    Chat on WhatsApp (<%= typeof settings !== 'undefined' && settings.whatsapp ? settings.whatsapp : '+91 81289 20702' %>)
                  </a>
                </p>
                <span class="text-muted small">Share plot photos & CAD drawings directly</span>
              </div>
            </div>

            <!-- Email Item -->
            <div class="d-flex gap-3 mb-4">
              <div style="background: rgba(212, 175, 55, 0.15); width: 50px; height: 50px; border-radius: 12px; display: flex; align-items: center; justify-content: center; color: var(--gold-champagne); font-size: 1.3rem; flex-shrink: 0; border: 1px solid rgba(212, 175, 55, 0.3);">
                <i class="bi bi-envelope-fill"></i>
              </div>
              <div>
                <strong class="text-white d-block mb-1" style="font-size: 0.95rem;">Official Executive Communications</strong>
                <p class="mb-0">
                  <a href="mailto:<%= typeof settings !== 'undefined' && settings.email ? settings.email : 'pritesh029@gmail.com' %>" class="text-muted text-decoration-none hover-gold">
                    <%= typeof settings !== 'undefined' && settings.email ? settings.email : 'pritesh029@gmail.com' %>
                  </a>
                </p>
              </div>
            </div>
          </div>

          <!-- Studio Operating Hours -->
          <div class="p-3 rounded-3 mt-4" style="background: rgba(8, 11, 16, 0.85); border: 1px solid rgba(212, 175, 55, 0.2);">
            <div class="d-flex align-items-center justify-content-between mb-2">
              <span class="text-gold small fw-bold"><i class="bi bi-clock-history me-1"></i> Studio Visiting Hours</span>
              <span class="badge bg-success bg-opacity-25 text-success border border-success border-opacity-50 small">Open Mon - Sat</span>
            </div>
            <p class="text-muted small mb-0" style="line-height: 1.6;">
              Monday – Saturday: 9:30 AM to 7:00 PM IST<br>
              Site laser surveys and Sunday meetings strictly by prior appointment.
            </p>
          </div>
        </div>
      </div>

      <!-- Luxury Inquiry Form -->
      <div class="col-lg-7">
        <div class="luxury-form-card" style="background: rgba(15, 23, 42, 0.85); border: 1px solid rgba(212, 175, 55, 0.25);">
          
          <div class="d-flex align-items-center justify-content-between mb-3">
            <span class="blueprint-badge blueprint-badge-gold">Priority Client Routing</span>
            <span class="text-muted small"><i class="bi bi-shield-lock-fill text-gold me-1"></i> Strict NDA Confidentiality</span>
          </div>

          <h3 class="font-serif text-white mb-2" style="font-size: 1.75rem;">
            Request Architectural Quotation & Site Visit
          </h3>
          <p class="text-muted small mb-4">
            Complete the form below. A senior civil pool engineer will contact you within 2 business hours to discuss feasibility and schedule a site inspection.
          </p>

          <form action="/inquiry" method="POST">
            <div class="row g-3">
              
              <div class="col-md-6">
                <label for="contact-name" class="luxury-label">Full Name *</label>
                <input type="text" id="contact-name" name="name" class="luxury-input" placeholder="Your Name" required autocomplete="name">
              </div>

              <div class="col-md-6">
                <label for="contact-phone" class="luxury-label">Phone / WhatsApp *</label>
                <input type="tel" id="contact-phone" name="phone" class="luxury-input" placeholder="Enter 10-digit mobile number" required autocomplete="tel">
              </div>

              <div class="col-md-6">
                <label for="contact-email" class="luxury-label">Email Address (Optional)</label>
                <input type="email" id="contact-email" name="email" class="luxury-input" placeholder="client@estate.com" autocomplete="email">
              </div>

              <div class="col-md-6">
                <label for="contact-city" class="luxury-label">City / Project Site Location *</label>
                <input type="text" id="contact-city" name="city" class="luxury-input" placeholder="Surat, Navsari, Ahmedabad, Mumbai..." required autocomplete="address-level2">
              </div>

              <div class="col-md-6">
                <label for="contact-pool-type" class="luxury-label">Pool Classification</label>
                <select id="contact-pool-type" name="poolType" class="luxury-select">
                  <option value="Luxury Residential Villa Pool">Luxury Residential Villa Pool</option>
                  <option value="Vanishing Edge Infinity Pool">Infinity Edge Horizon Pool</option>
                  <option value="Commercial & Resort Swimming Pool">Commercial & Resort Swimming Pool</option>
                  <option value="Rooftop / Terrace Sky Pool">Rooftop / Terrace Sky Pool</option>
                  <option value="Deck-Level Overflow Pool">Deck-Level Overflow Mirror Pool</option>
                  <option value="Classic Skimmer Pool">Classic Skimmer Type Pool</option>
                  <option value="Readymade FRP Swimming Pool">Readymade FRP Fiberglass Pool</option>
                  <option value="Hydrotherapy Jacuzzi & Spa">Hydrotherapy Jacuzzi & Thermal Spa</option>
                  <option value="Pool Renovation, Leak Repair & Retiling">Pool Renovation, Leak Repair & Retiling</option>
                  <option value="Maintenance & AMC">Annual Maintenance & Automated Chemical AMC</option>
                </select>
              </div>

              <div class="col-md-6">
                <label for="contact-dimensions" class="luxury-label">Approximate Dimensions / Plot Size</label>
                <input type="text" id="contact-dimensions" name="poolDimensions" class="luxury-input" placeholder="e.g. 32' x 16' (or 650 sq.ft)">
              </div>

              <div class="col-12">
                <label for="contact-budget" class="luxury-label">Estimated Investment Range</label>
                <select id="contact-budget" name="budget" class="luxury-select">
                  <option value="">Select Estimated Investment Tier</option>
                  <option value="₹10L - ₹20L">₹10 Lakhs - ₹20 Lakhs (Compact Villa / FRP)</option>
                  <option value="₹20L - ₹40L">₹20 Lakhs - ₹40 Lakhs (Luxury Residential Monolithic)</option>
                  <option value="₹40L - ₹75L">₹40 Lakhs - ₹75 Lakhs (Infinity Horizon / Sky Pool)</option>
                  <option value="₹75L+">₹75 Lakhs+ (Ultra Luxury Estate / 5-Star Resort)</option>
                  <option value="Need Consultation">Need Site Inspection & Architectural Recommendation</option>
                </select>
              </div>

              <div class="col-12">
                <label for="contact-message" class="luxury-label">Architectural Vision / Custom Requirements</label>
                <textarea id="contact-message" name="message" rows="4" class="luxury-textarea"
                  placeholder="Describe your site elevation, glass walls, sun decks, cascading waterfalls, or automated heating requirements..."></textarea>
              </div>

              <div class="col-12 pt-2">
                <button type="submit" class="luxury-cta-btn w-100 justify-content-center" style="padding: 15px; font-size: 1.05rem;">
                  <i class="bi bi-send-fill"></i> Submit Quotation & Site Visit Request
                </button>
              </div>

            </div>
          </form>
        </div>
      </div>

    </div>
  </div>
</section>

<!-- 4-Stage Architectural Turnkey Process Timeline -->
<section class="section py-5 position-relative" style="background: rgba(11, 17, 33, 0.5); border-top: 1px solid rgba(212, 175, 55, 0.15); border-bottom: 1px solid rgba(212, 175, 55, 0.15);">
  <div class="container-wide">
    <div class="text-center max-w-700 mx-auto mb-5">
      <span class="blueprint-badge blueprint-badge-gold mb-2 d-inline-block">The Blue Sky Standard</span>
      <h2 class="font-serif text-white display-6 fw-bold mb-3">What Happens After You Inquire</h2>
      <p class="text-muted">A transparent, engineered path from preliminary conversation to crystal water immersion.</p>
    </div>

    <div class="row g-4">
      <div class="col-lg-3 col-md-6">
        <div class="glass-card p-4 h-100 text-center text-md-start">
          <div class="d-inline-flex align-items-center justify-content-center mb-3 rounded-circle" style="width: 50px; height: 50px; background: rgba(212, 175, 55, 0.2); border: 1px solid var(--gold-champagne); color: var(--gold-champagne); font-family: var(--font-serif); font-size: 1.2rem; font-weight: 700;">
            01
          </div>
          <h4 class="font-serif text-white fs-5 mb-2">Technical Briefing</h4>
          <p class="text-muted small mb-0">Direct phone discovery within 2 hours. We discuss plot dimensions, style preferences, usage expectations, and budget parameters.</p>
        </div>
      </div>

      <div class="col-lg-3 col-md-6">
        <div class="glass-card p-4 h-100 text-center text-md-start">
          <div class="d-inline-flex align-items-center justify-content-center mb-3 rounded-circle" style="width: 50px; height: 50px; background: rgba(2, 132, 199, 0.2); border: 1px solid #38bdf8; color: #38bdf8; font-family: var(--font-serif); font-size: 1.2rem; font-weight: 700;">
            02
          </div>
          <h4 class="font-serif text-white fs-5 mb-2">3D Laser Survey</h4>
          <p class="text-muted small mb-0">Our civil engineering team visits your site with optical laser levels to calculate natural gradient, excavation depth, and drainage connectivity.</p>
        </div>
      </div>

      <div class="col-lg-3 col-md-6">
        <div class="glass-card p-4 h-100 text-center text-md-start">
          <div class="d-inline-flex align-items-center justify-content-center mb-3 rounded-circle" style="width: 50px; height: 50px; background: rgba(0, 245, 212, 0.2); border: 1px solid #00F5D4; color: #00F5D4; font-family: var(--font-serif); font-size: 1.2rem; font-weight: 700;">
            03
          </div>
          <h4 class="font-serif text-white fs-5 mb-2">CAD Blueprint & BOQ</h4>
          <p class="text-muted small mb-0">We deliver photorealistic 3D renders, hydraulic pipe schematics, pump sizing calculations, and an itemized fixed-price BOQ contract.</p>
        </div>
      </div>

      <div class="col-lg-3 col-md-6">
        <div class="glass-card p-4 h-100 text-center text-md-start">
          <div class="d-inline-flex align-items-center justify-content-center mb-3 rounded-circle" style="width: 50px; height: 50px; background: rgba(16, 185, 129, 0.2); border: 1px solid #34D399; color: #34D399; font-family: var(--font-serif); font-size: 1.2rem; font-weight: 700;">
            04
          </div>
          <h4 class="font-serif text-white fs-5 mb-2">Turnkey Execution</h4>
          <p class="text-muted small mb-0">Excavation, M30 monolithic casting, 4-layer waterproofing, Italian tiling, pump room commissioning, and legal 15-year warranty handover.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Client FAQ Section -->
<section class="section py-5">
  <div class="container-wide">
    <div class="text-center max-w-700 mx-auto mb-5">
      <span class="blueprint-badge blueprint-badge-gold mb-2 d-inline-block">Client Advisory</span>
      <h2 class="font-serif text-white display-6 fw-bold mb-3">Frequently Asked Questions</h2>
      <p class="text-muted">Answers to common structural, hydraulic, and timeline inquiries.</p>
    </div>

    <div class="row g-4 justify-content-center">
      <div class="col-lg-8">
        
        <div class="glass-card p-4 mb-3">
          <h4 class="font-serif text-white fs-5 mb-2">
            <i class="bi bi-question-circle text-gold me-2"></i> How long does turnkey swimming pool construction take?
          </h4>
          <p class="text-muted small mb-0" style="line-height: 1.7;">
            A standard residential villa pool (e.g. 30' x 15') requires approximately 4 to 8 weeks from excavation to handover. Large commercial resort pools or complex cantilevered rooftop glass pools typically take 10 to 14 weeks depending on structural curing and architectural tile finishes.
          </p>
        </div>

        <div class="glass-card p-4 mb-3">
          <h4 class="font-serif text-white fs-5 mb-2">
            <i class="bi bi-question-circle text-gold me-2"></i> What is included in your 15-year structural warranty?
          </h4>
          <p class="text-muted small mb-0" style="line-height: 1.7;">
            Our 15-year legal warranty covers the monolithic RCC shell against settlement cracks, structural deflection, and hydrostatic water leakage. Pumps and hydraulic electrical equipment carry 1 to 5 years of OEM manufacturer replacement warranties.
          </p>
        </div>

        <div class="glass-card p-4 mb-3">
          <h4 class="font-serif text-white fs-5 mb-2">
            <i class="bi bi-question-circle text-gold me-2"></i> Can you construct swimming pools on existing rooftops or penthouses?
          </h4>
          <p class="text-muted small mb-0" style="line-height: 1.7;">
            Yes. We conduct structural load calculations on building columns and slabs. Where civil loads are constrained, we engineer lightweight modular stainless steel or high-tensile fiberglass pools with acrylic transparent viewing panels.
          </p>
        </div>

        <div class="glass-card p-4">
          <h4 class="font-serif text-white fs-5 mb-2">
            <i class="bi bi-question-circle text-gold me-2"></i> Do you undertake projects outside of Surat?
          </h4>
          <p class="text-muted small mb-0" style="line-height: 1.7;">
            Absolutely. We regularly execute turnkey swimming pool construction, fountain architecture, and resort projects throughout Surat, Navsari, Valsad, Vapi, Bharuch, Vadodara, Ahmedabad, Rajkot, Mumbai, and neighboring regions.
          </p>
        </div>

      </div>
    </div>
  </div>
</section>

<%- include('layouts/footer') %>