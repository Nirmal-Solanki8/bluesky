<%- include('layouts/header') %>

  <section class="page-hero-cinematic">
    <div class="page-hero-bg" style="background-image: url('/images/rooftop-pool.jpg');"></div>
    <div class="page-hero-overlay"></div>
    <div class="container" style="position: relative; z-index: 10;">
      <span class="section-tag-gold" style="margin-bottom: 16px; display: inline-flex;"><i
          class="fa-solid fa-headset"></i> Connect With Engineers</span>
      <h1 class="page-hero-title">
        Get In Touch With <span class="text-glow-gradient">Bluesky</span>
      </h1>
      <p class="page-hero-desc">
        Consult with our hydraulic specialists for bespoke pool architecture, 3D designs, and turnkey estimates.
      </p>
    </div>
  </section>

  <section class="section" id="quote-form" style="padding: 70px 0 100px;">
    <div class="container">
      <div class="contact-grid">

        <!-- Contact Info Box -->
        <div class="contact-info-card"
          style="background: var(--bg-card); border-radius: var(--radius-bento); box-shadow: 0 15px 40px rgba(0,0,0,0.06); border: 1px solid var(--border-subtle); display: flex; flex-direction: column; justify-content: space-between;">
          <div>
            <span class="section-tag"><i class="fa-solid fa-building"></i> Headquarters</span>
            <h3 style="font-size: 1.6rem; color: var(--text-main); margin-bottom: 25px;">Corporate Office</h3>

            <div style="margin-bottom: 25px; display: flex; gap: 16px;">
              <div
                style="background: rgba(2, 132, 199, 0.12); width: 48px; height: 48px; border-radius: 12px; display: flex; align-items: center; justify-content: center; color: var(--primary-cyan); font-size: 1.3rem; flex-shrink: 0;">
                <i class="fa-solid fa-location-dot"></i>
              </div>
              <div>
                <strong style="color: var(--text-main); font-size: 1rem; display: block; margin-bottom: 4px;">Registered
                  Address</strong>
                <p style="color: var(--text-muted); font-size: 0.92rem; line-height: 1.5;">
                  <%= settings.address %>
                </p>
              </div>
            </div>

            <div style="margin-bottom: 25px; display: flex; gap: 16px;">
              <div
                style="background: rgba(2, 132, 199, 0.12); width: 48px; height: 48px; border-radius: 12px; display: flex; align-items: center; justify-content: center; color: var(--primary-cyan); font-size: 1.3rem; flex-shrink: 0;">
                <i class="fa-solid fa-phone"></i>
              </div>
              <div>
                <strong style="color: var(--text-main); font-size: 1rem; display: block; margin-bottom: 4px;">Direct
                  Phone</strong>
                <p style="color: var(--text-muted); font-size: 0.95rem;">
                  <a href="tel:+918128920702" style="color: var(--primary-cyan); font-weight: 700;">+91 81289 20702</a>
                </p>
              </div>
            </div>

            <div style="margin-bottom: 25px; display: flex; gap: 16px;">
              <div
                style="background: rgba(37, 211, 102, 0.15); width: 48px; height: 48px; border-radius: 12px; display: flex; align-items: center; justify-content: center; color: #25d366; font-size: 1.3rem; flex-shrink: 0;">
                <i class="fa-brands fa-whatsapp"></i>
              </div>
              <div>
                <strong style="color: var(--text-main); font-size: 1rem; display: block; margin-bottom: 4px;">WhatsApp
                  Direct</strong>
                <p style="color: var(--text-muted); font-size: 0.95rem;">
                  <a href="https://wa.me/918128920702" target="_blank" rel="noopener noreferrer"
                    style="color: #25d366; font-weight: 700;">+91 81289 20702 (Chat Online)</a>
                </p>
              </div>
            </div>

            <div style="margin-bottom: 25px; display: flex; gap: 16px;">
              <div
                style="background: rgba(2, 132, 199, 0.12); width: 48px; height: 48px; border-radius: 12px; display: flex; align-items: center; justify-content: center; color: var(--primary-cyan); font-size: 1.3rem; flex-shrink: 0;">
                <i class="fa-solid fa-envelope"></i>
              </div>
              <div>
                <strong style="color: var(--text-main); font-size: 1rem; display: block; margin-bottom: 4px;">Official
                  Email</strong>
                <p style="color: var(--text-muted); font-size: 0.95rem;">
                  <a href="mailto:pritesh029@gmail.com" style="color: var(--text-main);">
                    <%= settings.email %>
                  </a>
                </p>
              </div>
            </div>
          </div>

          <div
            style="background: var(--bg-card-subtle); padding: 20px; border-radius: var(--radius-sm); border: 1px solid var(--border-subtle);">
            <small style="color: var(--text-muted);">Working Hours: Mon - Sat: 9:30 AM to 7:00 PM IST (Site Inspections
              by Appointment)</small>
          </div>
        </div>

        <!-- Inquiry / Quote Form -->
        <div id="quote-form" class="contact-form-card"
          style="background: var(--bg-card); border-radius: var(--radius-md); box-shadow: var(--shadow-md); border: 1px solid var(--border-subtle);">
          <h3 style="font-size: 1.6rem; color: var(--text-main); margin-bottom: 8px;">Request Custom Quotation</h3>
          <p style="color: var(--text-muted); margin-bottom: 25px; font-size: 0.95rem;">Fill out the form below and a
            senior pool engineer will connect with you within 2 business hours.</p>

          <% if (locals.success_msg && success_msg.length> 0) { %>
            <div
              style="background: #dcfce7; color: #166534; padding: 12px 16px; border-radius: 8px; margin-bottom: 22px; font-size: 0.92rem; font-weight: 600; border: 1px solid #bbf7d0;">
              <i class="fa-solid fa-circle-check"></i>
              <%= success_msg %>
            </div>
            <% } %>

              <% if (locals.error_msg && error_msg.length> 0) { %>
                <div
                  style="background: #fee2e2; color: #991b1b; padding: 12px 16px; border-radius: 8px; margin-bottom: 22px; font-size: 0.92rem; font-weight: 600; border: 1px solid #fecaca;">
                  <i class="fa-solid fa-triangle-exclamation"></i>
                  <%= error_msg %>
                </div>
                <% } %>

                  <form action="/inquiry" method="POST">
                    <div class="form-row">
                      <div class="form-group">
                        <label for="contact-name">Full Name *</label>
                        <input type="text" id="contact-name" name="name" class="form-control" placeholder="Full Name"
                          autocomplete="name" required>
                      </div>
                      <div class="form-group">
                        <label for="contact-phone">Phone / Mobile *</label>
                        <input type="tel" id="contact-phone" name="phone" class="form-control"
                          placeholder="Phone Number" autocomplete="tel" required>
                      </div>
                    </div>

                    <div class="form-row">
                      <div class="form-group">
                        <label for="contact-email">Email Address</label>
                        <input type="email" id="contact-email" name="email" class="form-control"
                          placeholder="Email Address" autocomplete="email">
                      </div>
                      <div class="form-group">
                        <label for="contact-city">City / Location</label>
                        <input type="text" id="contact-city" name="city" class="form-control"
                          placeholder="City / Location" autocomplete="address-level2">
                      </div>
                    </div>

                    <div class="form-row">
                      <div class="form-group">
                        <label for="contact-pool-type">Pool Classification</label>
                        <select id="contact-pool-type" name="poolType" class="form-control">
                          <option value="Luxury Residential Villa Pool">Luxury Residential Villa Pool</option>
                          <option value="Vanishing Edge Infinity Pool">Infinity Edge Horizon Pool</option>
                          <option value="Commercial / Resort Pool">Commercial & Resort Swimming Pool</option>
                          <option value="Rooftop / Penthouse Pool">Rooftop / Terrace Sky Pool</option>
                          <option value="Deck-Level Overflow Pool">Deck-Level Overflow Pool</option>
                          <option value="Skimmer Type Swimming Pool">Skimmer Type Pool</option>
                          <option value="Readymade FRP Swimming Pool">Readymade FRP Fiberglass Pool</option>
                          <option value="Hydrotherapy Jacuzzi & Spa">Hydrotherapy Jacuzzi & Spa</option>
                          <option value="Pool Renovation & Repair">Pool Renovation, Leak Repair & Retiling</option>
                          <option value="Maintenance & AMC">Maintenance & Cleaning AMC</option>
                        </select>
                      </div>
                      <div class="form-group">
                        <label for="contact-dimensions">Approx. Size (ft / sq.ft)</label>
                        <input type="text" id="contact-dimensions" name="poolDimensions" class="form-control"
                          placeholder="Pool or Plot Dimensions">
                      </div>
                    </div>

                    <div class="form-group">
                      <label for="contact-budget">Estimated Budget (Optional)</label>
                      <select id="contact-budget" name="budget" class="form-control">
                        <option value="">Select Estimated Budget Range (Optional)</option>
                        <option value="₹5L - ₹15L">₹5 Lakhs - ₹15 Lakhs</option>
                        <option value="₹15L - ₹30L">₹15 Lakhs - ₹30 Lakhs</option>
                        <option value="₹30L - ₹60L">₹30 Lakhs - ₹60 Lakhs</option>
                        <option value="₹60L+">₹60 Lakhs+ (Ultra Luxury / Resort)</option>
                        <option value="Need Consultation">Need Site Inspection First</option>
                      </select>
                    </div>

                    <div class="form-group">
                      <label for="contact-message">Project Details / Requirements</label>
                      <textarea id="contact-message" name="message" rows="3" class="form-control"
                        placeholder="Describe your pool requirements, specifications, or preferred design..."></textarea>
                    </div>

                    <button type="submit" class="btn btn-primary"
                      style="padding: 14px 34px; font-size: 1rem; width: 100%; border-radius: var(--radius-sm); font-weight: 700;">
                      <i class="fa-solid fa-paper-plane"></i> Submit Quotation Request
                    </button>
                  </form>
        </div>

      </div>
    </div>
  </section>

  <%- include('layouts/footer') %>