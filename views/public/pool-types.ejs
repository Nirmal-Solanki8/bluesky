<!-- Engineering Comparison Matrix -->
<section class="section py-5 my-4" id="comparison">
  <div class="container-wide">
    <div class="text-center max-w-700 mx-auto mb-5">
      <div class="section-tag-luxury">
        <i class="bi bi-table"></i> Engineering Comparison Matrix
      </div>
      <h2 class="font-serif text-white display-6 fw-bold mb-3">Compare Pool Archetypes Side by Side</h2>
      <p class="luxury-subtext mx-auto" style="font-size: 1.05rem; color: #CBD5E1 !important; max-width: 680px;">
        Compare civil construction timelines, surge balance tank requirements, waterline aesthetic, and ideal property settings.
      </p>
    </div>

    <div class="luxury-comparison-card">
      <div class="table-responsive">
        <table class="luxury-comparison-table mb-0">
          <thead>
            <tr>
              <th>Pool Archetype</th>
              <th>Construction Time</th>
              <th>Surge Tank Needed?</th>
              <th>Waterline Aesthetic</th>
              <th>Best Suited For</th>
              <th style="text-align: right;">Action</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td class="fw-bold text-white"><i class="bi bi-house-door text-gold me-2"></i> Private Villa</td>
              <td style="color: #CBD5E1;">4 - 8 Weeks</td>
              <td><span class="blueprint-badge">Optional</span></td>
              <td>Custom (Deck / Skimmer)</td>
              <td class="fw-semibold text-white">Villas & Farmhouses</td>
              <td style="text-align: right;"><button type="button" class="luxury-cta-btn py-1 px-3" style="font-size: 0.8rem;" onclick="selectPoolType('private'); document.getElementById('interactive-showcase').scrollIntoView({behavior: 'smooth'});">Configure</button></td>
            </tr>
            <tr>
              <td class="fw-bold text-white"><i class="bi bi-building text-gold me-2"></i> Commercial Resort</td>
              <td style="color: #CBD5E1;">6 - 12 Weeks</td>
              <td><span class="blueprint-badge blueprint-badge-gold">Yes (Mandatory)</span></td>
              <td>Deck-Level Overflow</td>
              <td class="fw-semibold text-white">Hotels & Clubhouses</td>
              <td style="text-align: right;"><button type="button" class="luxury-cta-btn py-1 px-3" style="font-size: 0.8rem;" onclick="selectPoolType('commercial'); document.getElementById('interactive-showcase').scrollIntoView({behavior: 'smooth'});">Configure</button></td>
            </tr>
            <tr>
              <td class="fw-bold text-white"><i class="bi bi-water text-gold me-2"></i> Vanishing Edge</td>
              <td style="color: #CBD5E1;">6 - 10 Weeks</td>
              <td><span class="blueprint-badge blueprint-badge-gold">Yes (Catch Basin)</span></td>
              <td>Zero-Edge Horizon</td>
              <td class="fw-semibold text-white">Hilltop & Panoramic Estates</td>
              <td style="text-align: right;"><button type="button" class="luxury-cta-btn py-1 px-3" style="font-size: 0.8rem;" onclick="selectPoolType('vanishing-edge'); document.getElementById('interactive-showcase').scrollIntoView({behavior: 'smooth'});">Configure</button></td>
            </tr>
            <tr>
              <td class="fw-bold text-white"><i class="bi bi-droplet-half text-gold me-2"></i> Overflow Type</td>
              <td style="color: #CBD5E1;">6 - 8 Weeks</td>
              <td><span class="blueprint-badge blueprint-badge-gold">Yes (Balance Tank)</span></td>
              <td>Flush Mirror Reflection</td>
              <td class="fw-semibold text-white">Modern Architectural Villas</td>
              <td style="text-align: right;"><button type="button" class="luxury-cta-btn py-1 px-3" style="font-size: 0.8rem;" onclick="selectPoolType('overflow'); document.getElementById('interactive-showcase').scrollIntoView({behavior: 'smooth'});">Configure</button></td>
            </tr>
            <tr>
              <td class="fw-bold text-white"><i class="bi bi-lightning-charge text-gold me-2"></i> Readymade FRP</td>
