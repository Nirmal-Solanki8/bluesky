    // Clean Dual-Layer Lighting Engine (Natural Day vs. Night LED Illumination)
    let currentLightingMode = 'day';
    let currentActivePoolKey = 'private';

    function setLightingScene(scene) {
      currentLightingMode = scene;
      const stageBox = document.getElementById('stageVisualBox');
      const btnDay = document.getElementById('btnDayMode');
      const btnNight = document.getElementById('btnNightMode');
      const stageBadge = document.getElementById('stageBadge');
      const data = poolTypesData[currentActivePoolKey];

      if (scene === 'night') {
        if (stageBox) stageBox.classList.add('night-active');
        if (btnDay) btnDay.classList.remove('active');
        if (btnNight) btnNight.classList.add('active');
        if (stageBadge) stageBadge.innerHTML = '<i class="fa-solid fa-moon" style="color: #fbbf24;"></i> Night Illumination';
      } else {
        if (stageBox) stageBox.classList.remove('night-active');
        if (btnDay) btnDay.classList.add('active');
        if (btnNight) btnNight.classList.remove('active');
        if (stageBadge && data) stageBadge.innerHTML = data.badge;
      }
    }

    function selectPoolType(typeKey) {
      const data = poolTypesData[typeKey];
      if (!data) return;
      currentActivePoolKey = typeKey;

      // 1. Update Segmented Pills & Auto-Center Active Pill on Mobile
      document.querySelectorAll('.apple-pill-btn').forEach(btn => {
        const isActive = btn.getAttribute('data-type') === typeKey;
        btn.classList.toggle('active', isActive);
        if (isActive) {
          btn.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
        }
      });

      // 2. Update Catalog Cards Highlight
      document.querySelectorAll('.apple-pool-card').forEach(card => {
        const onClickAttr = card.getAttribute('onclick') || '';
        card.classList.toggle('active-card', onClickAttr.includes(`'${typeKey}'`));
      });

      // 3. Smooth Fade Transition on Both Dual-Layers (Day & Night)
      const imgDay = document.getElementById('stageImageDay');
      const imgNight = document.getElementById('stageImageNight');
      if (imgDay) {
        imgDay.style.transform = 'scale(1.04)';
        setTimeout(() => {
          imgDay.src = data.imageDay;
          imgDay.alt = data.name + ' Daylight';
          imgDay.style.transform = 'scale(1)';
        }, 150);
      }
      if (imgNight) {
        imgNight.style.transform = 'scale(1.04)';
        setTimeout(() => {
          imgNight.src = data.imageNight;
          imgNight.alt = data.name + ' Night Illumination';
          imgNight.style.transform = 'scale(1)';
        }, 150);
      }

      // 4. Update Badges & Captions
      const badge = document.getElementById('stageBadge');
      if (badge) {
        badge.innerHTML = currentLightingMode === 'night' 
          ? '<i class="fa-solid fa-moon" style="color: #fbbf24;"></i> Night Illumination'
          : data.badge;
      }

      const sub = document.getElementById('stageSub');
      if (sub) sub.textContent = data.sub;

      const loc = document.getElementById('stageLocation');
      if (loc) loc.textContent = data.location;

      // 5. Update Editorial Panel
      const tag = document.getElementById('stageTag');
      if (tag) tag.innerHTML = data.tag;

      const timeline = document.getElementById('stageTimelineBadge');
      if (timeline) timeline.textContent = data.timeline;

      const title = document.getElementById('stageTitle');
      if (title) title.textContent = data.name;

      const desc = document.getElementById('stageDesc');
      if (desc) desc.textContent = data.desc;

      // 6. Update Specs
      const sConst = document.getElementById('specConstruction');
      if (sConst) sConst.textContent = data.specs.construction;

      const sWater = document.getElementById('specWaterline');
      if (sWater) sWater.textContent = data.specs.waterline;

      const sDepth = document.getElementById('specDepth');
      if (sDepth) sDepth.textContent = data.specs.depth;

      const sSan = document.getElementById('specSanitization');
      if (sSan) sSan.textContent = data.specs.sanitization;

      // 7. Update Highlights
      const hList = document.getElementById('stageHighlights');
      if (hList) {
        hList.innerHTML = data.highlights.map(h => `<li><i class="fa-solid fa-circle-check"></i> ${h}</li>`).join('');
      }

      // 8. Update Quote Button & Extra Guide Button
      const quoteBtn = document.getElementById('stageQuoteBtn');
      if (quoteBtn) {
        quoteBtn.innerHTML = `<i class="fa-solid fa-calculator"></i> Request ${data.name.replace(' Pools', '')} Quote`;
      }

      const extraBtn = document.getElementById('stageExtraBtn');
      if (extraBtn) {
        if (data.hasGuide) {
          extraBtn.style.display = 'inline-flex';
          extraBtn.href = '/private-swimming-pools';
          extraBtn.innerHTML = '<i class="fa-solid fa-arrow-right"></i> Dedicated Villa Guide';
        } else {
          extraBtn.style.display = 'inline-flex';
          extraBtn.href = '#quote-form';
          extraBtn.innerHTML = '<i class="fa-solid fa-headset"></i> Talk to Engineer';
        }
      }

      // 9. Update Quote Form Dropdown
      const select = document.getElementById('poolTypeSelect');
      if (select) {
        for (let i = 0; i < select.options.length; i++) {
          if (select.options[i].value === data.quoteValue || select.options[i].text.includes(data.quoteValue)) {
            select.selectedIndex = i;
            break;
          }
        }
      }
    }

    // Attach click listeners to pill buttons
    document.addEventListener('DOMContentLoaded', () => {
      document.querySelectorAll('.apple-pill-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const type = btn.getAttribute('data-type');
          if (type) selectPoolType(type);
        });
      });
    });
  </script>

  <%- include('layouts/footer') %>