            <!-- Night Layer (Real Photorealistic Dusk/Night with 3000K & Cyan LEDs) -->
            <img src="/images/pool-types/private-night.jpg" alt="Night Illuminated Swimming Pool" class="stage-layer stage-layer-night" id="stageImageNight" decoding="async" loading="lazy">
            
            <div class="apple-stage-overlay"></div>

            <!-- Minimal Top Bar: Category Spec & Clean Day / Night Toggle -->
