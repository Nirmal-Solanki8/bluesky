        <div class="apple-pool-card p-3 h-100" onclick="selectPoolType('vanishing-edge')">
          <div style="height: 180px; overflow: hidden; border-radius: var(--radius-sm); margin-bottom: 14px; position: relative;">
            <img src="/images/pool-types/vanishing-edge.webp" alt="Vanishing Edge Infinity Pools" class="w-100 h-100" style="object-fit: cover;" loading="lazy" decoding="async">
            <span class="blueprint-badge blueprint-badge-gold" style="position: absolute; top: 10px; left: 10px;">Signature</span>
          </div>
          <div>
            <span class="text-gold small fw-bold text-uppercase d-block mb-1">Ultra Luxury</span>
            <h4 class="font-serif text-white mb-2" style="font-size: 1.15rem;">Vanishing Infinity Edge</h4>
            <p class="small mb-3" style="color: #CBD5E1 !important; line-height: 1.5;">Precision weir walls merging waterlines with scenic horizons and skies.</p>
          </div>
          <div class="d-flex align-items-center justify-content-between pt-2 border-top border-secondary border-opacity-25 mt-auto">
            <span class="small text-muted"><i class="bi bi-clock me-1"></i> 6 - 10 Wks</span>
            <span class="text-gold fw-bold small">Configure &rarr;</span>
          </div>
        </div>
      </div>

      <!-- 4. Overflow Type -->
      <div class="col-lg-3 col-md-6">
        <div class="apple-pool-card p-3 h-100" onclick="selectPoolType('overflow')">
          <div style="height: 180px; overflow: hidden; border-radius: var(--radius-sm); margin-bottom: 14px; position: relative;">
            <img src="/images/pool-types/overflow.webp" alt="Overflow Type Swimming Pools" class="w-100 h-100" style="object-fit: cover;" loading="lazy" decoding="async">
            <span class="blueprint-badge" style="position: absolute; top: 10px; left: 10px;">Mirror Pool</span>
          </div>
          <div>
            <span class="text-gold small fw-bold text-uppercase d-block mb-1">Architectural</span>
            <h4 class="font-serif text-white mb-2" style="font-size: 1.15rem;">Deck-Level Overflow</h4>
            <p class="small mb-3" style="color: #CBD5E1 !important; line-height: 1.5;">Waterline flush with perimeter stone for a motionless mirror reflection.</p>
          </div>
          <div class="d-flex align-items-center justify-content-between pt-2 border-top border-secondary border-opacity-25 mt-auto">
            <span class="small text-muted"><i class="bi bi-clock me-1"></i> 6 - 8 Wks</span>
            <span class="text-gold fw-bold small">Configure &rarr;</span>
          </div>
        </div>
      </div>

      <!-- 5. Readymade FRP -->
      <div class="col-lg-3 col-md-6">
        <div class="apple-pool-card p-3 h-100" onclick="selectPoolType('readymade-frp')">
          <div style="height: 180px; overflow: hidden; border-radius: var(--radius-sm); margin-bottom: 14px; position: relative;">
            <img src="/images/rooftop-pool.webp" alt="Readymade FRP Pools" class="w-100 h-100" style="object-fit: cover;" loading="lazy" decoding="async">
            <span class="blueprint-badge blueprint-badge-gold" style="position: absolute; top: 10px; left: 10px;">Rapid Shell</span>
          </div>
          <div>
            <span class="text-gold small fw-bold text-uppercase d-block mb-1">Composite</span>
