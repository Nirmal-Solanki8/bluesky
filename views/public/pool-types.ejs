                <span class="section-tag-gold" id="stageTag" style="margin-bottom: 0;">
                  <i class="fa-solid fa-house-chimney-window"></i> 01. Residential Category
                </span>
                <span id="stageTimelineBadge" class="stage-timeline-pill">
                  4 - 8 Weeks Handover
                </span>
              </div>

