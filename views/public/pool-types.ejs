            <p class="small mb-3" style="color: #CBD5E1 !important; line-height: 1.5;">Pre-fabricated composite fiberglass shells delivered and installed in 7 days.</p>
          </div>
          <div class="d-flex align-items-center justify-content-between pt-2 border-top border-secondary border-opacity-25 mt-auto">
            <span class="small text-muted"><i class="bi bi-clock me-1"></i> 7 - 10 Days</span>
            <span class="text-gold fw-bold small">Configure &rarr;</span>
          </div>
        </div>
      </div>

      <!-- 6. Competition Olympic -->
      <div class="col-lg-3 col-md-6">
        <div class="apple-pool-card p-3 h-100" onclick="selectPoolType('competition')">
          <div style="height: 180px; overflow: hidden; border-radius: var(--radius-sm); margin-bottom: 14px; position: relative;">
            <img src="/images/pool-types/competition.webp" alt="Competition Olympic Pools" class="w-100 h-100" style="object-fit: cover;" loading="lazy" decoding="async">
            <span class="blueprint-badge" style="position: absolute; top: 10px; left: 10px;">Olympic Spec</span>
          </div>
          <div>
            <span class="text-gold small fw-bold text-uppercase d-block mb-1">Athletic</span>
            <h4 class="font-serif text-white mb-2" style="font-size: 1.15rem;">Competition Pools</h4>
            <p class="small mb-3" style="color: #CBD5E1 !important; line-height: 1.5;">FINA compliant 50m and 25m semi-Olympic complexes for institutions.</p>
          </div>
          <div class="d-flex align-items-center justify-content-between pt-2 border-top border-secondary border-opacity-25 mt-auto">
            <span class="small text-muted"><i class="bi bi-clock me-1"></i> 10 - 16 Wks</span>
            <span class="text-gold fw-bold small">Configure &rarr;</span>
          </div>
        </div>
      </div>

      <!-- 7. Recreational Theme -->
      <div class="col-lg-3 col-md-6">
        <div class="apple-pool-card p-3 h-100" onclick="selectPoolType('recreational')">
          <div style="height: 180px; overflow: hidden; border-radius: var(--radius-sm); margin-bottom: 14px; position: relative;">
            <img src="/images/pool-types/recreational.webp" alt="Recreational Theme Pools" class="w-100 h-100" style="object-fit: cover;" loading="lazy" decoding="async">
            <span class="blueprint-badge blueprint-badge-gold" style="position: absolute; top: 10px; left: 10px;">Leisure</span>
          </div>
          <div>
            <span class="text-gold small fw-bold text-uppercase d-block mb-1">Water Parks</span>
            <h4 class="font-serif text-white mb-2" style="font-size: 1.15rem;">Recreational Pools</h4>
            <p class="small mb-3" style="color: #CBD5E1 !important; line-height: 1.5;">Wave pools, lazy rivers, zero-depth beach slopes, and kids splash pads.</p>
          </div>
          <div class="d-flex align-items-center justify-content-between pt-2 border-top border-secondary border-opacity-25 mt-auto">
