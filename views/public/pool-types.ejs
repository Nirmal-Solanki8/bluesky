<%- include('layouts/header') %>

<!-- Hero: Architectural Swimming Pool Types & Formats -->
<section class="page-hero-cinematic">
  <div class="page-hero-bg" style="background-image: url('/images/pool-types/vanishing-edge.webp');"></div>
  <div class="page-hero-overlay"></div>

  <div class="container position-relative" style="z-index: 10;">
    <div class="section-tag-luxury mb-3">
      <i class="bi bi-layers-half"></i> Precision Aquatic Architecture
    </div>
    
    <h1 class="font-serif text-white display-4 fw-bold mb-3">
      Architectural Swimming Pool <span class="text-gradient-gold">Types & Formats</span>
    </h1>
    
    <p class="luxury-subtext mx-auto mb-4" style="font-size: 1.15rem; color: #E2E8F0 !important; max-width: 820px;">
      Explore Gujarat's foremost engineering portfolio. From monolithic infinity horizons and mirror overflow decks to rapid FRP shells, discover the exact pool archetype engineered for your property.
    </p>

    <div class="d-flex flex-wrap gap-3 justify-content-center pt-2">
      <a href="#interactive-showcase" class="luxury-cta-btn" style="padding: 13px 32px; font-size: 0.96rem;">
        <i class="bi bi-sliders"></i> Interactive Pool Configurator
      </a>
      <a href="#types-grid" class="btn btn-outline-light d-inline-flex align-items-center gap-2"
        style="border-radius: var(--radius-pill); padding: 12px 28px; font-weight: 600; border-color: rgba(255,255,255,0.25); background: rgba(15,23,42,0.5); backdrop-filter: blur(10px); color: #FFFFFF;">
        <i class="bi bi-grid-3x3-gap"></i> View All 8 Archetypes
      </a>
      <a href="#comparison" class="btn btn-outline-light d-inline-flex align-items-center gap-2"
        style="border-radius: var(--radius-pill); padding: 12px 28px; font-weight: 600; border-color: rgba(255,255,255,0.25); background: rgba(15,23,42,0.5); backdrop-filter: blur(10px); color: #FFFFFF;">
        <i class="bi bi-table"></i> Engineering Matrix
      </a>
    </div>
  </div>
</section>

<!-- Sticky Segmented Pill Controller -->
<div class="apple-selector-wrap" id="interactive-showcase">
  <div class="container-wide">
    <div class="apple-pill-nav" id="poolPillsContainer">
      <button type="button" class="apple-pill-btn active" data-type="private">
        <i class="bi bi-house-door me-1 text-gold"></i> Private Villa
      </button>
      <button type="button" class="apple-pill-btn" data-type="commercial">
        <i class="bi bi-building me-1 text-gold"></i> Commercial & Resort
      </button>
      <button type="button" class="apple-pill-btn" data-type="vanishing-edge">
        <i class="bi bi-water me-1 text-gold"></i> Vanishing Infinity
      </button>
      <button type="button" class="apple-pill-btn" data-type="overflow">
        <i class="bi bi-droplet-half me-1 text-gold"></i> Deck-Level Overflow
      </button>
      <button type="button" class="apple-pill-btn" data-type="readymade-frp">
        <i class="bi bi-lightning-charge me-1 text-gold"></i> Readymade FRP
      </button>
      <button type="button" class="apple-pill-btn" data-type="competition">
        <i class="bi bi-trophy me-1 text-gold"></i> Competition FINA
      </button>
      <button type="button" class="apple-pill-btn" data-type="recreational">
        <i class="bi bi-sun me-1 text-gold"></i> Leisure & Theme
      </button>
      <button type="button" class="apple-pill-btn" data-type="skimmer">
        <i class="bi bi-shield-check me-1 text-gold"></i> Classic Skimmer
      </button>
    </div>
  </div>
</div>

<!-- Flagship Interactive Stage -->
<section class="section py-5 my-4" style="padding-top: 0;">
  <div class="container-wide">
    <div class="apple-stage-container">
      <div class="apple-stage-grid">
        
        <!-- Left: Visual Showcase Frame with Clean Dual Day/Night Image Layers -->
        <div class="apple-stage-visual" id="stageVisualBox">
          <img src="/images/pool-types/private.webp" alt="Daylight Swimming Pool" class="stage-layer stage-layer-day" id="stageImageDay" decoding="async">
          <img src="/images/pool-types/private-night.webp" alt="Night Illuminated Swimming Pool" class="stage-layer stage-layer-night" id="stageImageNight" decoding="async" loading="lazy">
          
          <div class="apple-stage-overlay"></div>

          <!-- Minimal Top Bar: Category Spec & Day / Night Toggle -->
          <div class="stage-top-bar">
            <span class="blueprint-badge blueprint-badge-gold" id="stageBadge">
              <i class="bi bi-gem me-1"></i> Bespoke Villa Spec
            </span>

            <div class="stage-lighting-toggle" id="lightingToggle">
              <button type="button" class="s-light-btn active" id="btnDayMode" onclick="setLightingScene('day')" title="Natural Daylight View">
                <i class="bi bi-sun text-warning me-1"></i> Day
              </button>
              <button type="button" class="s-light-btn" id="btnNightMode" onclick="setLightingScene('night')" title="Night LED Illumination">
                <i class="bi bi-moon-stars text-info me-1"></i> Night
              </button>
            </div>
          </div>

          <div class="stage-caption-clean">
            <span id="stageSub" class="stage-sub-label text-gold">Private Luxury Villa</span>
            <h3 id="stageLocation" class="stage-location-title font-serif text-white">Katargam & Bodakdev Estates</h3>
          </div>
        </div>

        <!-- Right: Editorial & Hydraulic Engineering Specs Panel -->
        <div class="apple-stage-content">
          <div>
            <div class="d-flex align-items-center justify-content-between mb-3 gap-2 flex-wrap">
              <span class="section-tag-luxury mb-0" id="stageTag">
                <i class="bi bi-house-door"></i> 01. Residential Category
              </span>
              <span id="stageTimelineBadge" class="blueprint-badge blueprint-badge-gold">
                4 - 8 Weeks Handover
              </span>
            </div>

            <h2 class="font-serif text-white display-6 fw-bold mb-3" id="stageTitle">
              Private Swimming Pools
            </h2>

            <p class="mb-4" id="stageDesc" style="color: #E2E8F0 !important; font-size: 1.05rem; line-height: 1.7;">
              Custom-built swimming pools tailored exclusively for residential villas, farmhouses, penthouses, and private estates. Designed for family recreation, personal fitness, and exquisite architectural landscape enhancement.
            </p>

            <!-- Keynote Specs Matrix -->
            <div class="row g-3 mb-4">
              <div class="col-6">
                <div class="apple-spec-item">
                  <span class="apple-spec-label"><i class="bi bi-tools me-1"></i> Construction</span>
                  <p class="apple-spec-val" id="specConstruction">Turnkey RCC / Pre-cast</p>
                </div>
              </div>
              <div class="col-6">
                <div class="apple-spec-item">
                  <span class="apple-spec-label"><i class="bi bi-water me-1"></i> Waterline</span>
                  <p class="apple-spec-val" id="specWaterline">Skimmer / Deck Overflow</p>
                </div>
              </div>
              <div class="col-6">
                <div class="apple-spec-item">
                  <span class="apple-spec-label"><i class="bi bi-arrows-vertical me-1"></i> Average Depth</span>
                  <p class="apple-spec-val" id="specDepth">3.5 ft to 5.0 ft</p>
                </div>
              </div>
              <div class="col-6">
                <div class="apple-spec-item">
                  <span class="apple-spec-label"><i class="bi bi-droplet-half me-1"></i> Sanitization</span>
                  <p class="apple-spec-val" id="specSanitization">Saltwater Chlorinator / UV</p>
                </div>
              </div>
            </div>

            <!-- Engineering Highlights List -->
            <ul class="list-unstyled d-grid gap-2 mb-4" id="stageHighlights" style="color: #CBD5E1; font-size: 0.95rem;">
              <li class="d-flex align-items-center gap-2"><i class="bi bi-check-circle-fill text-gold"></i> Monolithic concrete casting with crystalline waterproofing membrane</li>
              <li class="d-flex align-items-center gap-2"><i class="bi bi-check-circle-fill text-gold"></i> 15-Year structural leakproof guarantee with turnkey MEP piping</li>
              <li class="d-flex align-items-center gap-2"><i class="bi bi-check-circle-fill text-gold"></i> Complimentary 3D architectural CAD modeling and site elevation survey</li>
            </ul>
          </div>

          <!-- Action Buttons -->
          <div class="d-flex flex-wrap gap-3 pt-2">
            <a href="javascript:void(0)" class="luxury-cta-btn" id="stageQuoteBtn" onclick="if(window.openConsultationModal){window.openConsultationModal(event, 'Private Villa Pool');}">
              <i class="bi bi-calendar2-check"></i> Request Consultation
            </a>
            <a href="/private-swimming-pools" class="btn btn-outline-light d-inline-flex align-items-center gap-2" id="stageExtraBtn"
               style="border-radius: var(--radius-pill); padding: 10px 24px; font-weight: 600; border-color: rgba(255,255,255,0.25); background: rgba(15,23,42,0.5); backdrop-filter: blur(10px); color: #FFFFFF;">
              <i class="bi bi-arrow-right"></i> Dedicated Villa Guide
            </a>
          </div>
        </div>

      </div>
    </div>
  </div>
</section>

<!-- Browse All 8 Pool Archetypes -->
<section class="section py-5 my-4" id="types-grid" style="background: rgba(15, 23, 42, 0.45);">
  <div class="container-wide">
    <div class="text-center max-w-700 mx-auto mb-5">
      <div class="section-tag-luxury">
        <i class="bi bi-grid-3x3-gap"></i> Complete Portfolio
      </div>
      <h2 class="font-serif text-white display-6 fw-bold mb-3">Browse All 8 Pool Archetypes</h2>
      <p class="luxury-subtext mx-auto" style="font-size: 1.05rem; color: #CBD5E1 !important; max-width: 680px;">
        Click any archetype to inspect its engineering specifications, waterline architecture, and construction timeline.
      </p>
    </div>

    <div class="row g-4">
      <!-- 1. Private Villa -->
      <div class="col-lg-3 col-md-6">
        <div class="apple-pool-card active-card p-3 h-100" onclick="selectPoolType('private')">
          <div style="height: 180px; overflow: hidden; border-radius: var(--radius-sm); margin-bottom: 14px; position: relative;">
            <img src="/images/pool-types/private.webp" alt="Private Swimming Pool" class="w-100 h-100" style="object-fit: cover;" loading="lazy" decoding="async">
            <span class="blueprint-badge blueprint-badge-gold" style="position: absolute; top: 10px; left: 10px;">Villa Spec</span>
          </div>
          <div>
            <span class="text-gold small fw-bold text-uppercase d-block mb-1">Residential</span>
            <h4 class="font-serif text-white mb-2" style="font-size: 1.15rem;">Private Swimming Pools</h4>
            <p class="small mb-3" style="color: #CBD5E1 !important; line-height: 1.5;">Bespoke RCC pools tailored for farmhouses, courtyards, and luxury estates.</p>
          </div>
          <div class="d-flex align-items-center justify-content-between pt-2 border-top border-secondary border-opacity-25 mt-auto">
            <span class="small text-muted"><i class="bi bi-clock me-1"></i> 4 - 8 Wks</span>
            <span class="text-gold fw-bold small">Configure &rarr;</span>
          </div>
        </div>
      </div>

      <!-- 2. Commercial Resort -->
      <div class="col-lg-3 col-md-6">
        <div class="apple-pool-card p-3 h-100" onclick="selectPoolType('commercial')">
          <div style="height: 180px; overflow: hidden; border-radius: var(--radius-sm); margin-bottom: 14px; position: relative;">
            <img src="/images/pool-types/commercial.webp" alt="Commercial Swimming Pools" class="w-100 h-100" style="object-fit: cover;" loading="lazy" decoding="async">
            <span class="blueprint-badge" style="position: absolute; top: 10px; left: 10px;">Commercial</span>
          </div>
          <div>
            <span class="text-gold small fw-bold text-uppercase d-block mb-1">Hospitality</span>
            <h4 class="font-serif text-white mb-2" style="font-size: 1.15rem;">Commercial & Resorts</h4>
            <p class="small mb-3" style="color: #CBD5E1 !important; line-height: 1.5;">High bather-load facilities with automated chemical loops for 5-star hotels.</p>
          </div>
          <div class="d-flex align-items-center justify-content-between pt-2 border-top border-secondary border-opacity-25 mt-auto">
            <span class="small text-muted"><i class="bi bi-clock me-1"></i> 6 - 12 Wks</span>
            <span class="text-gold fw-bold small">Configure &rarr;</span>
          </div>
        </div>
