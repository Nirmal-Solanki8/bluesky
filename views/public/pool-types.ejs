  <!-- ===================================================================
     ENGINEERING COMPARISON MATRIX
     =================================================================== -->
  <section class="section" id="comparison" style="padding: 90px 0;">
    <div class="container-wide">
      <div class="section-head" style="text-align: center; margin-bottom: 45px;">
        <span class="section-tag-gold"><i class="fa-solid fa-table-columns"></i> Engineering Comparison Matrix</span>
        <h2 class="dive-heading">Compare Pool Archetypes Side by Side</h2>
        <p style="color: var(--text-muted); font-size: 1.1rem; max-width: 680px; margin: 0 auto;">
          Compare civil construction timelines, surge balance tank requirements, waterline aesthetic, and ideal property settings.
        </p>
      </div>

      <div style="text-align: center;">
        <span class="table-scroll-hint">
          <i class="fa-solid fa-arrows-left-right"></i> Swipe sideways to inspect full specifications
        </span>
      </div>

      <div class="luxury-comparison-card">
        <table class="luxury-comparison-table">
          <thead>
            <tr>
              <th>Pool Archetype</th>
              <th>Construction Time</th>
              <th>Surge Tank Needed?</th>
              <th>Waterline Aesthetic</th>
              <th>Best Suited For</th>
              <th style="text-align: right;">Action</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td style="font-weight: 800;"><i class="fa-solid fa-house-chimney-window" style="color: var(--brand-yellow); margin-right: 8px;"></i> Private Villa</td>
              <td style="color: var(--text-muted); font-weight: 600;">4 - 8 Weeks</td>
              <td><span style="background: rgba(100, 116, 139, 0.1); padding: 4px 10px; border-radius: 50px; font-size: 0.82rem; font-weight: 700;">Optional</span></td>
              <td>Custom (Deck / Skimmer)</td>
              <td style="font-weight: 700;">Villas & Farmhouses</td>
              <td style="text-align: right;"><button type="button" class="btn btn-sm btn-yellow" onclick="selectPoolType('private'); document.getElementById('interactive-showcase').scrollIntoView({behavior: 'smooth'});">Configure</button></td>
            </tr>
            <tr>
              <td style="font-weight: 800;"><i class="fa-solid fa-hotel" style="color: var(--brand-cyan); margin-right: 8px;"></i> Commercial Resort</td>
              <td style="color: var(--text-muted); font-weight: 600;">6 - 12 Weeks</td>
              <td><span style="background: rgba(16, 185, 129, 0.12); color: #059669; padding: 4px 10px; border-radius: 50px; font-size: 0.82rem; font-weight: 700;">Yes (Mandatory)</span></td>
