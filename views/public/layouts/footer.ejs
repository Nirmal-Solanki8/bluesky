  aria-label="Direct Concierge">
  <i class="bi bi-whatsapp"></i>
  <span>Direct Concierge</span>
</a>

<!-- Interactive High-Res Lightbox Modal (For All Gallery & Project Views) -->
<div class="luxury-lightbox" id="luxuryLightbox" role="dialog" aria-modal="true" aria-label="Project Preview Lightbox">
  <div class="lightbox-backdrop" onclick="window.closeLuxuryLightbox()"></div>
  <div class="lightbox-dialog">
    <button class="lightbox-close-btn" onclick="window.closeLuxuryLightbox()" aria-label="Close Lightbox">
      <i class="bi bi-x-lg"></i>
    </button>
    <div class="lightbox-media-frame">
      <img src="/images/infinity-pool.webp" alt="High Resolution Project" id="lightboxImg" class="lightbox-img" loading="lazy" decoding="async">
    </div>
    <div class="lightbox-info-bar">
      <div>
        <span class="blueprint-badge blueprint-badge-gold mb-1" id="lightboxCategory">Bespoke Architecture</span>
        <h4 class="font-serif text-white mb-0" id="lightboxTitle" style="font-size: 1.25rem;">Infinity Horizon Pool</h4>
      </div>
      <a href="/contact#quote-form" class="luxury-cta-btn" style="padding: 7px 18px; font-size: 0.82rem;">
        Inquire Similar <i class="bi bi-arrow-right"></i>
      </a>
    </div>
  </div>
</div>

<!-- Interactive Architectural Consultation Modal (Available Globally from All Pages) -->
<div class="luxury-lightbox" id="luxuryConsultationModal" role="dialog" aria-modal="true" aria-label="Architectural Consultation Request Modal">
  <div class="lightbox-backdrop" onclick="window.closeConsultationModal()"></div>
  <div class="survey-modal-dialog position-relative">
    <button class="lightbox-close-btn" onclick="window.closeConsultationModal()" aria-label="Close Modal">
      <i class="bi bi-x-lg"></i>
    </button>
    
    <div class="mb-3 text-start">
      <div class="blueprint-badge blueprint-badge-gold mb-2 d-inline-block">
        <i class="bi bi-chat-left-text me-1"></i> Bespoke Architectural Consultation
      </div>
      <h3 class="font-serif text-white mb-1" style="font-size: 1.5rem;">
        Request Architectural Consultation
      </h3>
      <p class="text-muted small mb-0">
        Provide your preliminary specifications below. Our senior civil pool engineer will contact you with a customized blueprint estimate.
      </p>
    </div>

    <!-- Live Status Alert inside Modal -->
    <div id="consultationModalAlert" class="alert d-none py-2 px-3 small rounded-pill mb-3" role="alert"></div>

    <form action="/inquiry" method="POST" id="globalConsultationForm" onsubmit="window.handleConsultationSubmit(event)" class="text-start mt-3">
      <div class="row g-3">
        <div class="col-md-6">
          <label for="modal-survey-name" class="luxury-label">Full Name *</label>
          <input type="text" id="modal-survey-name" name="name" class="luxury-input" placeholder="Your Name" required autocomplete="name">
        </div>

        <div class="col-md-6">
          <label for="modal-survey-phone" class="luxury-label">Phone / WhatsApp *</label>
          <input type="tel" id="modal-survey-phone" name="phone" class="luxury-input" placeholder="Enter 10-digit mobile number" required autocomplete="tel">
        </div>

        <div class="col-md-6">
          <label for="modal-survey-email" class="luxury-label">Email Address (Optional)</label>
          <input type="email" id="modal-survey-email" name="email" class="luxury-input" placeholder="client@estate.com" autocomplete="email">
        </div>

        <div class="col-md-6">
          <label for="modal-survey-city" class="luxury-label">Plot Location / City *</label>
          <input type="text" id="modal-survey-city" name="city" class="luxury-input" placeholder="Surat, Navsari, Ahmedabad, Mumbai..." required autocomplete="address-level2">
        </div>

        <div class="col-md-6">
          <label for="modal-survey-pool-type" class="luxury-label">Architectural Pool Format</label>
          <select id="modal-survey-pool-type" name="poolType" class="luxury-select">
            <option value="Vanishing Edge Infinity Pool">Vanishing Edge Horizon Infinity Pool</option>
            <option value="Luxury Residential Villa Pool">Luxury Residential Villa RCC Pool</option>
            <option value="Rooftop / Penthouse Sky Pool">Rooftop / Penthouse Cantilevered Sky Pool</option>
            <option value="Deck-Level Overflow Pool">Deck-Level Overflow Mirror Pool</option>
            <option value="Commercial & Resort Swimming Pool">Commercial Resort & Club Lagoon</option>
            <option value="Readymade FRP Fiberglass Pool">Readymade FRP Fiberglass Shell</option>
            <option value="Hydrotherapy Jacuzzi & Thermal Spa">Hydrotherapy Jacuzzi & Thermal Spa</option>
            <option value="Pool Renovation, Leak Repair & Retiling">Pool Renovation & Leak Proofing</option>
            <option value="Annual Maintenance & AMC">Automated Chemical Dosing AMC</option>
          </select>
        </div>

        <div class="col-md-6">
          <label for="modal-survey-dimensions" class="luxury-label">Plot / Pool Dimensions</label>
          <input type="text" id="modal-survey-dimensions" name="poolDimensions" class="luxury-input" placeholder="e.g. 35ft x 18ft (or plot sq.ft)">
        </div>

        <div class="col-12">
          <label for="modal-survey-budget" class="luxury-label">Estimated Investment Tier (Optional)</label>
          <select id="modal-survey-budget" name="budget" class="luxury-select">
            <option value="">Select Estimated Investment Tier</option>
            <option value="₹10L - ₹20L">₹10 Lakhs - ₹20 Lakhs (Compact Villa / FRP Shell)</option>
            <option value="₹20L - ₹40L">₹20 Lakhs - ₹40 Lakhs (Luxury Residential Monolithic RCC)</option>
            <option value="₹40L - ₹75L">₹40 Lakhs - ₹75 Lakhs (Infinity Horizon / Rooftop Sky Pool)</option>
            <option value="₹75L+">₹75 Lakhs+ (Ultra-Luxury Estate / 5-Star Resort)</option>
            <option value="Need Site Survey First">Need Engineer Recommendation First</option>
          </select>
        </div>

        <div class="col-12">
          <label for="modal-survey-message" class="luxury-label">Site Requirements / Custom Vision</label>
          <textarea id="modal-survey-message" name="message" rows="2" class="luxury-textarea"
            placeholder="Share details regarding slope elevation, glass view walls, water curtains, or heating..."></textarea>
        </div>

        <div class="col-12 pt-2">
          <button type="submit" id="consultationSubmitBtn" class="luxury-cta-btn w-100 justify-content-center" style="padding: 13px; font-size: 0.98rem;">
            <i class="bi bi-send-fill me-1"></i> Submit Consultation Request
          </button>
        </div>
      </div>
    </form>
  </div>
</div>

<script>
  window.openLuxuryLightbox = function (imgSrc, title, category) {
    var modal = document.getElementById('luxuryLightbox');
    var img = document.getElementById('lightboxImg');
    var titleEl = document.getElementById('lightboxTitle');
    var catEl = document.getElementById('lightboxCategory');
    if (img && imgSrc) img.src = imgSrc;
    if (titleEl && title) titleEl.textContent = title;
    if (catEl && category) catEl.textContent = category;
    if (modal) modal.classList.add('active');
    document.body.style.overflow = 'hidden';
  };
  window.closeLuxuryLightbox = function () {
    var modal = document.getElementById('luxuryLightbox');
    if (modal) modal.classList.remove('active');
    document.body.style.overflow = '';
  };

  window.openConsultationModal = function (e, preselectedType) {
    if (e && e.preventDefault) e.preventDefault();
    var modal = document.getElementById('luxuryConsultationModal') || document.getElementById('luxury3dSurveyModal');
    if (preselectedType) {
      var select = document.getElementById('modal-survey-pool-type');
      if (select) {
        for (var i = 0; i < select.options.length; i++) {
          if (select.options[i].value === preselectedType || select.options[i].text.toLowerCase().includes(preselectedType.toLowerCase())) {
            select.selectedIndex = i;
            break;
          }
        }
      }
    }
    var alertBox = document.getElementById('consultationModalAlert');
    if (alertBox) alertBox.classList.add('d-none');
    if (modal) modal.classList.add('active');
    document.body.style.overflow = 'hidden';
  };

  window.closeConsultationModal = function () {
    var modal = document.getElementById('luxuryConsultationModal') || document.getElementById('luxury3dSurveyModal');
    if (modal) modal.classList.remove('active');
    document.body.style.overflow = '';
  };

  // Backwards compatibility aliases
  window.open3dSurveyModal = window.openConsultationModal;
  window.close3dSurveyModal = window.closeConsultationModal;

  window.handleConsultationSubmit = async function (e) {
    e.preventDefault();
    var form = e.target;
    var btn = document.getElementById('consultationSubmitBtn');
    var alertBox = document.getElementById('consultationModalAlert');
    var origText = btn ? btn.innerHTML : '';

    if (btn) {
      btn.disabled = true;
      btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span> Recording Inquiry...';
    }

    try {
      var formData = new FormData(form);
      var urlEncoded = new URLSearchParams(formData).toString();

      var response = await fetch('/inquiry', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/x-www-form-urlencoded',
          'Accept': 'application/json'
        },
        body: urlEncoded
      });

      var data = await response.json();

      if (data && data.success) {
        if (alertBox) {
          alertBox.className = 'alert alert-success py-2 px-3 small rounded-pill mb-3';
          alertBox.innerHTML = '<i class="bi bi-check-circle-fill me-1"></i> Recorded in Admin Panel! Connecting to WhatsApp...';
          alertBox.classList.remove('d-none');
        }
        if (btn) {
          btn.innerHTML = '<i class="bi bi-check2-circle text-white me-1"></i> Inquiry Received!';
        }

        // Open WhatsApp in a new tab
        if (data.whatsappUrl) {
          var waWindow = window.open(data.whatsappUrl, '_blank');
          if (!waWindow) {
            window.location.href = data.whatsappUrl;
          }
        }

        setTimeout(function () {
          window.closeConsultationModal();
          form.reset();
          if (btn) {
            btn.disabled = false;
            btn.innerHTML = origText;
          }
          if (alertBox) alertBox.classList.add('d-none');
        }, 1500);
      } else {
        if (alertBox) {
          alertBox.className = 'alert alert-danger py-2 px-3 small rounded-pill mb-3';
          alertBox.innerHTML = '<i class="bi bi-exclamation-triangle-fill me-1"></i> ' + ((data && data.message) || 'Error submitting inquiry.');
          alertBox.classList.remove('d-none');
        }
        if (btn) {
          btn.disabled = false;
          btn.innerHTML = origText;
        }
      }
    } catch (err) {
      console.warn('AJAX submit fallback to standard post:', err);
      form.submit();
    }
  };

  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
      window.closeLuxuryLightbox();
      window.closeConsultationModal();
    }
  });
</script>

