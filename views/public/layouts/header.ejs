  <link rel="prefetch" href="/images/infinity-pool.webp" as="image">
  <link rel="prefetch" href="/images/resort-pool.webp" as="image">
  <link rel="preload" as="image" href="/images/logo.svg" type="image/svg+xml">

  <!-- Optimized Google Fonts: Non-blocking with display=swap -->
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" media="print" onload="this.media='all'">
  <noscript>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap">
