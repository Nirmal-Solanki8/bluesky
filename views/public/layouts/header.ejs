  <!-- Flash Alerts -->
  <div class="container" id="global-flash-container"
    style="position: fixed; top: 95px; left: 50%; transform: translateX(-50%); z-index: 9999; width: calc(100% - 48px); max-width: 800px; pointer-events: none;">
    <% if (locals.success_msg && success_msg.length> 0) { %>
      <div class="alert flash-alert-item"
        style="pointer-events: auto; background: #059669; color: #fff; padding: 14px 22px; border-radius: 50px; box-shadow: 0 10px 30px rgba(0,0,0,0.25); display: flex; align-items: center; justify-content: space-between; gap: 12px; font-weight: 600; margin-bottom: 10px; animation: slideDown 0.3s ease;">
        <div style="display: flex; align-items: center; gap: 12px;">
          <i class="fa-solid fa-circle-check" style="font-size: 1.25rem;"></i>
          <div>
            <%= success_msg %>
          </div>
        </div>
        <button onclick="this.closest('.flash-alert-item').remove()"
          style="background: none; border: none; color: #fff; cursor: pointer; font-size: 1.1rem; padding: 4px; opacity: 0.85;">
          <i class="fa-solid fa-xmark"></i>
        </button>
      </div>
      <% } %>
        <% if (locals.error_msg && error_msg.length> 0) { %>
          <div class="alert flash-alert-item"
            style="pointer-events: auto; background: #dc2626; color: #fff; padding: 14px 22px; border-radius: 50px; box-shadow: 0 10px 30px rgba(0,0,0,0.25); display: flex; align-items: center; justify-content: space-between; gap: 12px; font-weight: 600; margin-bottom: 10px; animation: slideDown 0.3s ease;">
            <div style="display: flex; align-items: center; gap: 12px;">
              <i class="fa-solid fa-circle-exclamation" style="font-size: 1.25rem;"></i>
              <div>
                <%= error_msg %>
              </div>
            </div>
            <button onclick="this.closest('.flash-alert-item').remove()"
              style="background: none; border: none; color: #fff; cursor: pointer; font-size: 1.1rem; padding: 4px; opacity: 0.85;">
              <i class="fa-solid fa-xmark"></i>
            </button>
          </div>
          <% } %>
  </div>
  <script>
    setTimeout(() => {
      const items = document.querySelectorAll('.flash-alert-item');
      items.forEach(el => {
        el.style.transition = 'opacity 0.6s ease, transform 0.6s ease';
        el.style.opacity = '0';
        el.style.transform = 'translateY(-15px)';
        setTimeout(() => el.remove(), 600);
      });
    }, 6000);
  </script>