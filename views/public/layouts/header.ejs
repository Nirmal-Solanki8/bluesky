  <!-- Global Flash Alerts Container -->
  <div class="container" id="global-flash-container"
    style="position: fixed; top: 95px; left: 50%; transform: translateX(-50%); z-index: 9999; width: calc(100% - 48px); max-width: 720px; pointer-events: none;">
    <% if (locals.success_msg && success_msg.length > 0) { %>
      <div class="alert flash-alert-item"
        style="pointer-events: auto; background: rgba(5, 150, 105, 0.95); backdrop-filter: blur(12px); color: #fff; padding: 14px 22px; border-radius: 50px; box-shadow: 0 10px 30px rgba(0,0,0,0.3); display: flex; align-items: center; justify-content: space-between; gap: 12px; font-weight: 600; margin-bottom: 10px; border: 1px solid rgba(16, 185, 129, 0.4);">
        <div style="display: flex; align-items: center; gap: 12px;">
          <i class="bi bi-check-circle-fill text-white fs-5"></i>
          <div><%= success_msg %></div>
        </div>
        <button onclick="this.closest('.flash-alert-item').remove()"
          style="background: none; border: none; color: #fff; cursor: pointer; font-size: 1.1rem; padding: 4px; opacity: 0.85;">
          <i class="bi bi-x-lg"></i>
        </button>
      </div>
    <% } %>
    <% if (locals.error_msg && error_msg.length > 0) { %>
      <div class="alert flash-alert-item"
        style="pointer-events: auto; background: rgba(220, 38, 38, 0.95); backdrop-filter: blur(12px); color: #fff; padding: 14px 22px; border-radius: 50px; box-shadow: 0 10px 30px rgba(0,0,0,0.3); display: flex; align-items: center; justify-content: space-between; gap: 12px; font-weight: 600; margin-bottom: 10px; border: 1px solid rgba(239, 68, 68, 0.4);">
        <div style="display: flex; align-items: center; gap: 12px;">
          <i class="bi bi-exclamation-triangle-fill text-white fs-5"></i>
          <div><%= error_msg %></div>
        </div>
        <button onclick="this.closest('.flash-alert-item').remove()"
          style="background: none; border: none; color: #fff; cursor: pointer; font-size: 1.1rem; padding: 4px; opacity: 0.85;">
          <i class="bi bi-x-lg"></i>
        </button>
      </div>
    <% } %>
  </div>
  <script>
    setTimeout(function () {
      var items = document.querySelectorAll('.flash-alert-item');
      items.forEach(function (el) {
        el.style.transition = 'opacity 0.6s ease, transform 0.6s ease';
        el.style.opacity = '0';
        el.style.transform = 'translateY(-15px)';
        setTimeout(function () { el.remove(); }, 600);
      });
    }, 6000);
  </script>