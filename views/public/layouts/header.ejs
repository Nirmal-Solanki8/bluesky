  <!-- Zero-Delay Mobile Drawer Fallback Scripts -->
  <script>
    window.openMobileDrawer = function (e) {
      if (e && e.preventDefault) e.preventDefault();
      var d = document.getElementById('mobile-drawer');
      var b = document.getElementById('drawer-backdrop');
      if (d) d.classList.add('open');
      if (b) b.classList.add('active');
      document.body.style.overflow = 'hidden';
      document.documentElement.style.overflow = 'hidden';
    };
    window.closeMobileDrawer = function (e) {
      if (e && e.preventDefault) e.preventDefault();
      var d = document.getElementById('mobile-drawer');
      var b = document.getElementById('drawer-backdrop');
      if (d) d.classList.remove('open');
      if (b) b.classList.remove('active');
      document.body.style.overflow = '';
      document.documentElement.style.overflow = '';
    };
    window.toggleMobileDrawer = function (e) {
      var d = document.getElementById('mobile-drawer');
      if (d && d.classList.contains('open')) {
        window.closeMobileDrawer(e);
      } else {
        window.openMobileDrawer(e);
      }
    };
    window.toggleDrawerAccordion = function (btn, e) {
      if (e) {
        if (typeof e.preventDefault === 'function') e.preventDefault();
        if (typeof e.stopPropagation === 'function') e.stopPropagation();
      }
      var item = btn ? btn.closest('.drawer-dropdown-item') : null;
      if (!item) return;
      var wasOpen = item.classList.contains('open');
      var allItems = document.querySelectorAll('.drawer-dropdown-item');
      for (var i = 0; i < allItems.length; i++) {
        allItems[i].classList.remove('open');
      }
      if (!wasOpen) {
        item.classList.add('open');
      }
    };
  </script>
