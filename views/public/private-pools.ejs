<%- include('layouts/header') %>

<!-- Hero: Bespoke Private Villa Swimming Pools -->
<section class="page-hero-cinematic">
  <div class="page-hero-bg" style="background-image: url('/images/private-pool-hero.webp');"></div>
  <div class="page-hero-overlay"></div>

  <div class="container position-relative" style="z-index: 10;">
    <div class="section-tag-luxury mb-3">
      <i class="bi bi-house-door"></i> Residential & Villa Specialists
    </div>
    
    <h1 class="font-serif text-white display-4 fw-bold mb-3">
      Private Villa <span class="text-gradient-gold">Swimming Pools</span>
    </h1>
    
    <p class="luxury-subtext mx-auto mb-4" style="font-size: 1.15rem; color: #E2E8F0 !important; max-width: 820px;">
      Bespoke architectural swimming pools engineered for private villas, farmhouses, and luxury estates. From sleek skimmer pools to breathtaking infinity horizons, we craft personal aquatic sanctuaries with our 100% leakproof monolithic RCC assurance.
    </p>

    <div class="d-flex flex-wrap gap-3 justify-content-center pt-2">
      <a href="#quote-form" class="luxury-cta-btn" style="padding: 13px 32px; font-size: 0.96rem;">
        <i class="bi bi-compass"></i> Request 3D Villa Design
      </a>
      <a href="#private-types" class="btn btn-outline-light d-inline-flex align-items-center gap-2"
        style="border-radius: var(--radius-pill); padding: 12px 28px; font-weight: 600; border-color: rgba(255,255,255,0.25); background: rgba(15,23,42,0.5); backdrop-filter: blur(10px); color: #FFFFFF;">
        <i class="bi bi-layers"></i> Explore Design Styles
      </a>
    </div>
  </div>
</section>

<!-- Stats Bar: Private Villa Benchmarks -->
<section class="luxury-stats-strip py-5 my-4">
  <div class="container">
    <div class="row g-4 justify-content-center">
      
      <div class="col-6 col-lg-3">
        <div class="luxury-stat-card">
          <div class="stat-number-glow counter-animate" data-count="380" data-suffix="+">380+</div>
          <div class="stat-label-subtle">Villa Pools Built</div>
        </div>
      </div>

      <div class="col-6 col-lg-3">
        <div class="luxury-stat-card">
          <div class="stat-number-glow counter-animate" data-count="15" data-suffix=" Yrs">15 Yrs</div>
          <div class="stat-label-subtle">RCC Leakproof Warranty</div>
        </div>
      </div>

      <div class="col-6 col-lg-3">
        <div class="luxury-stat-card">
          <div class="stat-number-glow counter-animate" data-count="100" data-suffix="%">100%</div>
          <div class="stat-label-subtle">Skin-Friendly Saltwater</div>
        </div>
      </div>

      <div class="col-6 col-lg-3">
        <div class="luxury-stat-card">
          <div class="stat-number-glow text-gradient-gold">FREE</div>
          <div class="stat-label-subtle">3D Laser CAD Layout</div>
        </div>
      </div>

    </div>
  </div>
</section>

<!-- Overview: The Private Pool Promise -->
<section class="section py-5 my-4">
  <div class="container-wide">
    <div class="row g-5 align-items-center">
      
      <div class="col-lg-6">
        <div class="section-tag-luxury">
          <i class="bi bi-gem"></i> Bespoke Architectural Sanctuary
        </div>
        <h2 class="font-serif text-white display-6 fw-bold mb-3">
          Designed Exclusively<br>For Your Villa Estate
        </h2>
        <p class="mb-4" style="color: #E2E8F0 !important; font-size: 1.08rem; line-height: 1.75;">
          A private swimming pool is the architectural heart of your family home, an oasis of fitness, and an entertainer’s paradise. Over our 16+ years of expertise, Blue Sky International has pioneered residential pool engineering that harmonizes seamlessly with your landscape.
        </p>
        <p class="mb-4" style="color: #CBD5E1 !important; font-size: 1rem; line-height: 1.75;">
          Whether you envision a serene courtyard reflection pool, an elevated rooftop plunge pool, or a sweeping farmhouse vanishing horizon, our in-house civil and hydraulic teams deliver turnkey execution from site excavation to the crystal-clear first splash.
        </p>

        <div class="row g-3">
          <div class="col-sm-6">
            <div class="glass-card p-3 h-100">
              <h5 class="font-serif text-white mb-2" style="font-size: 1.05rem;">
                <i class="bi bi-shield-check text-azure me-2"></i> 100% Leakproof RCC
              </h5>
              <p class="small mb-0" style="color: #CBD5E1 !important; line-height: 1.55;">
                Monolithic concrete pouring with crystalline polymer injection tested under 72h hydrostatic ponding.
              </p>
            </div>
          </div>
          <div class="col-sm-6">
            <div class="glass-card p-3 h-100">
              <h5 class="font-serif text-white mb-2" style="font-size: 1.05rem;">
                <i class="bi bi-droplet-half text-gold me-2"></i> Gentle Mineral Water
              </h5>
              <p class="small mb-0" style="color: #CBD5E1 !important; line-height: 1.55;">
                Silky, crystal-clear water with automated salt chlorination that is soothing on skin and eyes.
              </p>
            </div>
          </div>
        </div>
      </div>

      <div class="col-lg-6">
        <div class="glass-card overflow-hidden tilt-card-3d p-2">
          <img src="/images/resort-pool.webp" alt="Private Villa Swimming Pool" 
               class="w-100 rounded-4" style="height: 440px; object-fit: cover;" loading="lazy" decoding="async">
          <div class="p-3">
            <span class="blueprint-badge blueprint-badge-gold mb-1">Residential Villa Showcase</span>
            <h5 class="font-serif text-white mb-0">Bodakdev Luxury Estate Horizon</h5>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<!-- Private Pool Design Styles Bento Grid -->
<section class="section py-5 my-4" id="private-types" style="background: rgba(15, 23, 42, 0.45);">
  <div class="container-wide">
    <div class="text-center max-w-700 mx-auto mb-5">
      <div class="section-tag-luxury">
        <i class="bi bi-grid-1x2"></i> Tailored Formats
      </div>
      <h2 class="font-serif text-white display-6 fw-bold mb-3">Private Pool Formats & Styles</h2>
      <p class="luxury-subtext mx-auto" style="font-size: 1.05rem; color: #CBD5E1 !important; max-width: 720px;">
        Choose the ideal architectural water level and construction method for your villa plot dimensions.
      </p>
    </div>

    <div class="row g-4">
      <!-- 1. Skimmer Type -->
      <div class="col-lg-4 col-md-6">
        <div class="glass-card p-3 h-100 tilt-card-3d">
          <div style="height: 220px; overflow: hidden; border-radius: var(--radius-sm); margin-bottom: 16px;">
            <img src="/images/private-pool-hero.webp" alt="Skimmer Type Pools" 
                 class="w-100 h-100" style="object-fit: cover;" loading="lazy" decoding="async">
          </div>
          <span class="blueprint-badge blueprint-badge-gold mb-2">Most Popular For Villas</span>
          <h4 class="font-serif text-white mb-2" style="font-size: 1.25rem;">Skimmer Type Pools</h4>
          <p class="small mb-0" style="color: #CBD5E1 !important; line-height: 1.6;">
            Waterline sits 10–15cm below deck level with integrated surface skimmer throats. High energy efficiency, minimal maintenance, and classic aesthetic.
          </p>
        </div>
      </div>

      <!-- 2. Overflow Deck Level -->
      <div class="col-lg-4 col-md-6">
        <div class="glass-card p-3 h-100 tilt-card-3d">
          <div style="height: 220px; overflow: hidden; border-radius: var(--radius-sm); margin-bottom: 16px;">
            <img src="/images/pool-types/overflow.webp" alt="Overflow Deck Level Pools" 
                 class="w-100 h-100" style="object-fit: cover;" loading="lazy" decoding="async">
          </div>
          <span class="blueprint-badge mb-2">Mirror Reflection</span>
          <h4 class="font-serif text-white mb-2" style="font-size: 1.25rem;">Deck-Level Overflow Pools</h4>
          <p class="small mb-0" style="color: #CBD5E1 !important; line-height: 1.6;">
            Water level sits perfectly flush with perimeter deck tiles, spilling quietly into perimeter drainage slots for a mesmerizing reflective mirror effect.
          </p>
        </div>
      </div>

      <!-- 3. Vanishing Infinity Edge -->
      <div class="col-lg-4 col-md-6">
        <div class="glass-card p-3 h-100 tilt-card-3d">
          <div style="height: 220px; overflow: hidden; border-radius: var(--radius-sm); margin-bottom: 16px;">
            <img src="/images/infinity-pool.webp" alt="Infinity Edge Private Pools" 
                 class="w-100 h-100" style="object-fit: cover;" loading="lazy" decoding="async">
          </div>
          <span class="blueprint-badge blueprint-badge-gold mb-2">Signature Horizon</span>
          <h4 class="font-serif text-white mb-2" style="font-size: 1.25rem;">Vanishing Infinity Edge</h4>
          <p class="small mb-0" style="color: #CBD5E1 !important; line-height: 1.6;">
            Negative edge weir wall merging with gardens, lakes, or horizons. Features balance surge tanks, hidden return pumps, and optional glass viewing walls.
          </p>
        </div>
      </div>

      <!-- 4. Readymade FRP Fiberglass -->
      <div class="col-lg-4 col-md-6">
        <div class="glass-card p-3 h-100 tilt-card-3d">
          <div style="height: 220px; overflow: hidden; border-radius: var(--radius-sm); margin-bottom: 16px;">
            <img src="/images/resort-pool.webp" alt="Readymade FRP Pools" 
                 class="w-100 h-100" style="object-fit: cover;" loading="lazy" decoding="async">
          </div>
          <span class="blueprint-badge mb-2">Rapid 7-Day Install</span>
          <h4 class="font-serif text-white mb-2" style="font-size: 1.25rem;">Readymade FRP Pools</h4>
          <p class="small mb-0" style="color: #CBD5E1 !important; line-height: 1.6;">
            Precision-manufactured composite fiberglass shells with ultra-smooth gelcoat finishes, integrated steps, and rapid excavation-to-swim delivery.
          </p>
        </div>
      </div>

      <!-- 5. Indoor & Rooftop Sky Pools -->
      <div class="col-lg-4 col-md-6">
        <div class="glass-card p-3 h-100 tilt-card-3d">
          <div style="height: 220px; overflow: hidden; border-radius: var(--radius-sm); margin-bottom: 16px;">
            <img src="/images/rooftop-pool.webp" alt="Indoor & Rooftop Private Pools" 
                 class="w-100 h-100" style="object-fit: cover;" loading="lazy" decoding="async">
          </div>
          <span class="blueprint-badge blueprint-badge-gold mb-2">Penthouse Living</span>
          <h4 class="font-serif text-white mb-2" style="font-size: 1.25rem;">Indoor & Rooftop Pools</h4>
          <p class="small mb-0" style="color: #CBD5E1 !important; line-height: 1.6;">
            Engineered with lightweight high-strength rebar and structural load calculations for terrace penthouses. Features automated climate heating and covers.
          </p>
        </div>
      </div>

      <!-- 6. Hydrotherapy Jacuzzis -->
      <div class="col-lg-4 col-md-6">
        <div class="glass-card p-3 h-100 tilt-card-3d">
          <div style="height: 220px; overflow: hidden; border-radius: var(--radius-sm); margin-bottom: 16px;">
            <img src="/images/jacuzzi-spa.webp" alt="Private Jacuzzis and Spas" 
                 class="w-100 h-100" style="object-fit: cover;" loading="lazy" decoding="async">
          </div>
          <span class="blueprint-badge mb-2">Wellness Spas</span>
          <h4 class="font-serif text-white mb-2" style="font-size: 1.25rem;">Private Spas & Jacuzzis</h4>
          <p class="small mb-0" style="color: #CBD5E1 !important; line-height: 1.6;">
            Custom heated hydro-massage spa tubs built directly into your pool deck with targeted therapeutic back, foot, and neck hydrotherapy jets.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Step-by-Step Turnkey Execution Process -->
<section class="section py-5 my-4">
  <div class="container-wide">
    <div class="text-center max-w-700 mx-auto mb-5">
      <div class="section-tag-luxury">
        <i class="bi bi-list-check"></i> Turnkey Journey
      </div>
      <h2 class="font-serif text-white display-6 fw-bold mb-3">How We Build Your Private Pool</h2>
      <p class="luxury-subtext mx-auto" style="font-size: 1.05rem; color: #CBD5E1 !important; max-width: 720px;">
        A hassle-free 5-stage engineering process managed completely by our in-house civil and hydraulic teams.
      </p>
    </div>

    <div class="process-grid">
      <div class="process-step-card glass-card">
        <span class="process-num">01</span>
        <h4 class="process-title text-white">3D Consultation</h4>
        <p class="process-desc" style="color: #CBD5E1 !important;">Site soil test, plot laser survey, and photorealistic 3D architectural renders.</p>
      </div>

      <div class="process-step-card glass-card">
        <span class="process-num">02</span>
        <h4 class="process-title text-white">Excavation & RCC</h4>
        <p class="process-desc" style="color: #CBD5E1 !important;">Precision earthmoving and monolithic RCC structural concrete pouring with zero cold joints.</p>
      </div>

      <div class="process-step-card glass-card">
        <span class="process-num">03</span>
        <h4 class="process-title text-white">Dual Waterproofing</h4>
        <p class="process-desc" style="color: #CBD5E1 !important;">Polymer-modified crystalline waterproofing injection with mandatory 72-hour hydrostatic ponding test.</p>
      </div>

      <div class="process-step-card glass-card">
        <span class="process-num">04</span>
        <h4 class="process-title text-white">Tiling & MEP Plant</h4>
        <p class="process-desc" style="color: #CBD5E1 !important;">Designer Spanish glass mosaics, sand filtration battery, LED lighting & variable speed pumps installation.</p>
      </div>

      <div class="process-step-card glass-card">
        <span class="process-num">05</span>
        <h4 class="process-title text-white">Handover & Care</h4>
        <p class="process-desc" style="color: #CBD5E1 !important;">Water chemistry balancing, owner handover, lifetime warranty issuance, and ongoing AMC care.</p>
      </div>
    </div>
  </div>
</section>

<!-- Luxury Private Pool Inquiry Form -->
<section class="section py-5 my-4" id="quote-form" style="background: rgba(15, 23, 42, 0.5);">
  <div class="container-wide">
    <div class="row g-5 align-items-center">
      
      <div class="col-lg-5">
        <div class="section-tag-luxury">
          <i class="bi bi-compass"></i> Free Private Pool Survey
        </div>
        <h2 class="font-serif text-white display-6 fw-bold mb-3">
          Ready to Build Your Private Villa Pool?
        </h2>
        <p class="luxury-subtext mb-4" style="color: #E2E8F0 !important; font-size: 1.08rem; line-height: 1.75;">
          Speak directly with our senior pool architects. We offer complimentary plot laser inspections, 3D hydraulic CAD designs, and transparent itemized estimates with our 100% monolithic leakproof guarantee.
        </p>

        <div class="glass-card p-4 mb-4">
          <div class="text-gold fw-bold mb-2 small text-uppercase" style="letter-spacing: 0.8px;">
            <i class="bi bi-geo-alt-fill me-1"></i> Surat Studio & Corporate Office:
          </div>
          <p class="text-white mb-2" style="font-size: 0.95rem; line-height: 1.6;">
            <%= typeof settings !== 'undefined' && settings.address ? settings.address : 'A-8, Laxmikant Ashram Rd, Rashi Circle, Bhulabhai Desai Park, Hari Darshan Society, Katargam, Surat, Gujarat 395004' %>
          </p>
          <div class="d-flex align-items-center gap-2 text-muted small">
            <i class="bi bi-clock text-gold me-1"></i> Mon-Sat: 9AM - 8PM
          </div>
        </div>

        <div class="d-flex align-items-center gap-2 text-muted small">
          <i class="bi bi-shield-check text-gold fs-5"></i>
          <span>Over 16 Years Turnkey Excellence &bull; 380+ Villa Pools Completed</span>
        </div>
      </div>

      <div class="col-lg-7">
        <div class="luxury-form-card">
          <h3 class="font-serif text-white mb-2" style="font-size: 1.6rem;">
            Request Private Pool Estimate
          </h3>
          <p class="small mb-4" style="color: #CBD5E1 !important;">
            Get a customized quote and free 3D CAD design for your villa or farmhouse swimming pool.
          </p>

          <form action="/inquiry" method="POST">
            <div class="row g-3">
              <div class="col-md-6">
                <label for="priv-name" class="luxury-label">Your Full Name *</label>
                <input type="text" id="priv-name" name="name" class="luxury-input" placeholder="e.g. Vikramaditya Singhania" required autocomplete="name">
              </div>

              <div class="col-md-6">
                <label for="priv-phone" class="luxury-label">Mobile Number *</label>
                <input type="tel" id="priv-phone" name="phone" class="luxury-input" placeholder="Enter 10-digit mobile number" required autocomplete="tel">
              </div>

              <div class="col-md-6">
                <label for="priv-email" class="luxury-label">Email Address</label>
                <input type="email" id="priv-email" name="email" class="luxury-input" placeholder="client@estate.com" autocomplete="email">
              </div>

              <div class="col-md-6">
                <label for="priv-city" class="luxury-label">City / Project Location *</label>
                <input type="text" id="priv-city" name="city" class="luxury-input" placeholder="Surat, Mumbai, Goa, etc." required autocomplete="address-level2">
              </div>

              <div class="col-md-6">
                <label for="priv-pool-type" class="luxury-label">Pool Classification</label>
                <select id="priv-pool-type" name="poolType" class="luxury-select">
                  <option value="Luxury Residential Villa Pool" selected>Private Villa Pool (Residential)</option>
                  <option value="Vanishing Edge Infinity Pool">Private Infinity Edge Horizon Pool</option>
                  <option value="Rooftop / Penthouse Sky Pool">Rooftop / Penthouse Sky Pool</option>
                  <option value="Deck-Level Overflow Pool">Deck-Level Overflow Pool</option>
                  <option value="Hydrotherapy Jacuzzi & Thermal Spa">Private Jacuzzi & Hydrotherapy Spa</option>
                  <option value="Pool Renovation, Leak Repair & Retiling">Pool Renovation & Leak Repair</option>
                </select>
              </div>

              <div class="col-md-6">
                <label for="priv-dimensions" class="luxury-label">Approximate Size / Plot Area</label>
                <input type="text" id="priv-dimensions" name="poolDimensions" class="luxury-input" placeholder="e.g. 35ft x 18ft (or plot sq.ft)">
              </div>

              <div class="col-12">
                <label for="priv-budget" class="luxury-label">Estimated Investment Tier (Optional)</label>
                <select id="priv-budget" name="budget" class="luxury-select">
                  <option value="">Select Estimated Investment Tier</option>
                  <option value="₹10L - ₹20L">₹10 Lakhs - ₹20 Lakhs (Compact Villa / FRP)</option>
                  <option value="₹20L - ₹40L">₹20 Lakhs - ₹40 Lakhs (Luxury Residential RCC)</option>
                  <option value="₹40L - ₹75L">₹40 Lakhs - ₹75 Lakhs (Infinity Horizon / Sky Pool)</option>
                  <option value="₹75L+">₹75 Lakhs+ (Ultra-Luxury Estate Sanctuary)</option>
                  <option value="Need Site Survey First">Need Site Survey & Recommendation First</option>
                </select>
              </div>

              <div class="col-12">
                <label for="priv-message" class="luxury-label">Project Details / Vision</label>
                <textarea id="priv-message" name="message" rows="3" class="luxury-textarea"
                  placeholder="Share details regarding architectural style, glass railings, heating, water curtains, or specific finishing materials..."></textarea>
              </div>

              <div class="col-12 pt-2">
                <button type="submit" class="luxury-cta-btn w-100 justify-content-center" style="padding: 14px; font-size: 1rem;">
                  <i class="bi bi-send-fill"></i> Submit Private Pool Inquiry
                </button>
              </div>
            </div>
          </form>
        </div>
      </div>

    </div>
  </div>
</section>

<%- include('layouts/footer') %>