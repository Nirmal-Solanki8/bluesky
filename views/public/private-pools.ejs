  <!-- ===================================================================
     PRIVATE POOL DESIGN STYLES (MATCHING CRYSTAL POOLS OPTIONS)
     =================================================================== -->
  <section class="section has-svg-water-bg" id="private-types" style="background: var(--bg-card-subtle);">
    <div class="fluid-container">
      <div class="section-head">
        <span class="section-tag-gold"><i class="fa-solid fa-shapes"></i> Tailored Formats</span>
        <h2 class="services-main-title">Private Pool Formats & Styles</h2>
        <p
          style="color: var(--text-muted); font-size: 1.15rem; text-align: center; max-width: 750px; margin: -40px auto 50px;">
          Choose the ideal architectural water level and construction method for your villa plot dimensions.
        </p>
      </div>

      <div class="bento-services-grid-fluid">
        <!-- 1. Skimmer Type -->
        <div class="bento-card">
          <img src="/images/private-pool-hero.webp"
            alt="Skimmer Type Pools" class="bento-bg-img" decoding="async" loading="lazy">
          <div class="bento-overlay">
            <div class="bento-content">
              <span
                style="color: var(--brand-yellow); font-size: 0.8rem; font-weight: 800; text-transform: uppercase;">Most
                Popular For Villas</span>
              <h3 class="bento-title">Skimmer Type Pools</h3>
              <p class="bento-sub">Waterline 10–15cm below deck level with built-in surface skimmer units.
                Cost-efficient, low maintenance, and classic aesthetic.</p>
            </div>
          </div>
        </div>

        <!-- 2. Overflow / Deck Level -->
        <div class="bento-card">
          <img src="/images/pool-types/overflow.webp"
            alt="Overflow Deck Level Pools" class="bento-bg-img" decoding="async" loading="lazy">
          <div class="bento-overlay">
            <div class="bento-content">
              <span
                style="color: var(--brand-yellow); font-size: 0.8rem; font-weight: 800; text-transform: uppercase;">Mirror
                Reflection</span>
              <h3 class="bento-title">Deck-Level Overflow Pools</h3>
              <p class="bento-sub">Water level sits perfectly flush with perimeter deck tiles, spilling quietly into
                perimeter channels for a mesmerizing mirror effect.</p>
            </div>
          </div>
        </div>

        <!-- 3. Vanishing / Infinity Edge -->
        <div class="bento-card">
          <img src="/images/infinity-pool.jpg" alt="Infinity Edge Private Pools" class="bento-bg-img" decoding="async" loading="lazy">
          <div class="bento-overlay">
            <div class="bento-content">
              <span
                style="color: var(--brand-yellow); font-size: 0.8rem; font-weight: 800; text-transform: uppercase;">Signature
                Horizon</span>
              <h3 class="bento-title">Vanishing Infinity Edge</h3>
              <p class="bento-sub">Negative edge weir wall merging with garden lawns or horizons. Features balance tanks
                and transparent viewing acrylic panels.</p>
            </div>
          </div>
        </div>

        <!-- 4. Readymade FRP Fiberglass -->
        <div class="bento-card">
          <img src="/images/resort-pool.jpg"
            alt="Readymade FRP Pools" class="bento-bg-img" decoding="async" loading="lazy">
          <div class="bento-overlay">
            <div class="bento-content">
              <span
                style="color: var(--brand-yellow); font-size: 0.8rem; font-weight: 800; text-transform: uppercase;">Rapid
                7-Day Install</span>
              <h3 class="bento-title">Readymade FRP Pools</h3>
              <p class="bento-sub">Factory-manufactured fiberglass reinforced shells with ultra-smooth anti-slip
                gelcoat, built-in steps, and rapid installation.</p>
            </div>
          </div>
        </div>

        <!-- 5. Indoor & Rooftop Pools -->
        <div class="bento-card">
          <img src="/images/rooftop-pool.jpg" alt="Indoor & Rooftop Private Pools" class="bento-bg-img" decoding="async" loading="lazy">
          <div class="bento-overlay">
            <div class="bento-content">
              <span
                style="color: var(--brand-yellow); font-size: 0.8rem; font-weight: 800; text-transform: uppercase;">Private
                Year-Round</span>
              <h3 class="bento-title">Indoor & Rooftop Pools</h3>
              <p class="bento-sub">Climate-controlled indoor plunge pools and cantilevered terrace pools with heat pumps
                and dehumidifiers.</p>
            </div>
          </div>
        </div>

        <!-- 6. Hydrotherapy Jacuzzis -->
        <div class="bento-card">
          <img src="/images/jacuzzi-spa.jpg" alt="Private Jacuzzis" class="bento-bg-img" decoding="async" loading="lazy">
          <div class="bento-overlay">
            <div class="bento-content">
              <span
                style="color: var(--brand-yellow); font-size: 0.8rem; font-weight: 800; text-transform: uppercase;">Wellness
                Hydrotherapy</span>
              <h3 class="bento-title">Private Spas & Jacuzzis</h3>
              <p class="bento-sub">Custom heated hydro-massage spa tubs built into your pool deck with targeted
                therapeutic back and foot jets.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================================================================
     STEP-BY-STEP TURNKEY EXECUTION PROCESS
     =================================================================== -->
  <section class="section has-svg-water-bg">
    <div class="container-wide">
      <div class="section-head">
        <span class="section-tag-gold"><i class="fa-solid fa-list-check"></i> Turnkey Journey</span>
        <h2 class="services-main-title">How We Build Your Private Pool</h2>
        <p
          style="color: var(--text-muted); font-size: 1.12rem; text-align: center; max-width: 700px; margin: -40px auto 50px;">
          A hassle-free 5-stage engineering process managed completely by Bluesky International.
        </p>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr)); gap: 20px;">
        <div
          style="background: var(--bg-card); padding: 30px 24px; border-radius: var(--radius-md); border: 1px solid var(--border-subtle); position: relative;">
          <span
            style="font-family: var(--font-hero); font-size: 2.2rem; font-weight: 900; color: var(--brand-yellow); display: block; margin-bottom: 12px;">01</span>
          <h4 style="font-size: 1.2rem; font-weight: 800; margin-bottom: 8px;">3D Consultation</h4>
          <p style="font-size: 0.9rem; color: var(--text-muted);">Site soil test, plot dimensioning, and photorealistic
            3D architectural renders.</p>
        </div>

        <div
          style="background: var(--bg-card); padding: 30px 24px; border-radius: var(--radius-md); border: 1px solid var(--border-subtle); position: relative;">
          <span
            style="font-family: var(--font-hero); font-size: 2.2rem; font-weight: 900; color: var(--brand-yellow); display: block; margin-bottom: 12px;">02</span>
          <h4 style="font-size: 1.2rem; font-weight: 800; margin-bottom: 8px;">Excavation & RCC</h4>
          <p style="font-size: 0.9rem; color: var(--text-muted);">Precision earthmoving and monolithic RCC structural
            concrete pouring.</p>
        </div>

        <div
          style="background: var(--bg-card); padding: 30px 24px; border-radius: var(--radius-md); border: 1px solid var(--border-subtle); position: relative;">
          <span
            style="font-family: var(--font-hero); font-size: 2.2rem; font-weight: 900; color: var(--brand-yellow); display: block; margin-bottom: 12px;">03</span>
          <h4 style="font-size: 1.2rem; font-weight: 800; margin-bottom: 8px;">Dual Waterproofing</h4>
          <p style="font-size: 0.9rem; color: var(--text-muted);">Polymer-modified crystalline waterproofing with
            72-hour ponding tests.</p>
        </div>

        <div
          style="background: var(--bg-card); padding: 30px 24px; border-radius: var(--radius-md); border: 1px solid var(--border-subtle); position: relative;">
          <span
            style="font-family: var(--font-hero); font-size: 2.2rem; font-weight: 900; color: var(--brand-yellow); display: block; margin-bottom: 12px;">04</span>
          <h4 style="font-size: 1.2rem; font-weight: 800; margin-bottom: 8px;">Tiling & MEP Plant</h4>
          <p style="font-size: 0.9rem; color: var(--text-muted);">Designer glass mosaics, sand filtration battery, LED
            lights & pumps installation.</p>
        </div>

        <div
          style="background: var(--bg-card); padding: 30px 24px; border-radius: var(--radius-md); border: 1px solid var(--border-subtle); position: relative;">
          <span
            style="font-family: var(--font-hero); font-size: 2.2rem; font-weight: 900; color: var(--brand-yellow); display: block; margin-bottom: 12px;">05</span>
          <h4 style="font-size: 1.2rem; font-weight: 800; margin-bottom: 8px;">Handover & Care</h4>
          <p style="font-size: 0.9rem; color: var(--text-muted);">Water chemistry balancing, owner training, warranty
            certificate & handover.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================================================================
     QUOTE / ESTIMATE SECTION WITH SURAT ADDRESS
     =================================================================== -->
  <section class="section has-svg-water-bg" id="quote-form">
    <div class="container">
      <div class="quote-banner">
        <div class="quote-grid">
          <div>
            <span class="section-tag-gold"><i class="fa-solid fa-compass-drafting"></i> Free Private Pool Survey</span>
            <h2
              style="font-family: var(--font-hero); font-size: clamp(2rem, 3.5vw, 2.8rem); font-weight: 900; margin-bottom: 18px; color: #fff;">
              Ready to Build Your Private Villa Pool?
            </h2>
            <p style="color: #cbd5e1; font-size: 1.05rem; margin-bottom: 25px; line-height: 1.6;">
              Speak directly with our senior pool architects. We offer free plot inspection, 3D hydraulic models, and
              transparent itemized quotations.
            </p>

            <div
              style="background: rgba(255, 255, 255, 0.08); padding: 18px 22px; border-radius: 12px; border: 1px solid rgba(255,255,255,0.12); margin-bottom: 25px;">
              <div style="font-weight: 700; color: var(--brand-yellow); margin-bottom: 6px; font-size: 0.95rem;">
                <i class="fa-solid fa-location-dot"></i> Surat Corporate Office:
              </div>
              <div style="color: #f1f5f9; font-size: 0.9rem; line-height: 1.5;">
                A-8, Laxmikant Ashram Rd, Rashi Circle, Bhulabhai Desai Park, Hari Darshan Society, Katargam, Surat,
                Gujarat 395004
              </div>
              <div style="color: var(--brand-yellow); font-size: 0.85rem; margin-top: 6px; font-weight: 600;">
                Over 16 Years of Excellence in Swimming Pool Engineering
              </div>
            </div>
          </div>

          <div class="quote-form-card" id="quote-form">
            <h3 style="font-family: var(--font-hero); font-size: 1.5rem; font-weight: 800; margin-bottom: 8px;">
              Request Private Pool Estimate
            </h3>
            <p style="color: var(--text-muted); font-size: 0.9rem; margin-bottom: 20px;">
              Get a customized quote and free 3D CAD design for your villa or farmhouse swimming pool.
            </p>

            <% if (locals.success_msg && success_msg.length> 0) { %>
              <div
                style="background: #dcfce7; color: #166534; padding: 12px 16px; border-radius: 8px; margin-bottom: 20px; font-size: 0.92rem; font-weight: 600; border: 1px solid #bbf7d0;">
                <i class="fa-solid fa-circle-check"></i>
                <%= success_msg %>
              </div>
              <% } %>

                <% if (locals.error_msg && error_msg.length> 0) { %>
                  <div
                    style="background: #fee2e2; color: #991b1b; padding: 12px 16px; border-radius: 8px; margin-bottom: 20px; font-size: 0.92rem; font-weight: 600; border: 1px solid #fecaca;">
                    <i class="fa-solid fa-triangle-exclamation"></i>
                    <%= error_msg %>
                  </div>
                  <% } %>

                    <form action="/inquiry" method="POST">
                      <div class="form-row">
                        <div class="form-group">
                          <label for="priv-name">Your Name *</label>
                          <input type="text" id="priv-name" name="name" class="form-control" placeholder="Your Name"
                            autocomplete="name" required>
                        </div>
                        <div class="form-group">
                          <label for="priv-phone">Phone / Mobile *</label>
                          <input type="tel" id="priv-phone" name="phone" class="form-control" placeholder="Phone Number"
                            autocomplete="tel" required>
                        </div>
                      </div>

                      <div class="form-row">
                        <div class="form-group">
                          <label for="priv-email">Email Address</label>
                          <input type="email" id="priv-email" name="email" class="form-control"
                            placeholder="Email Address" autocomplete="email">
                        </div>
                        <div class="form-group">
                          <label for="priv-city">City / Location</label>
                          <input type="text" id="priv-city" name="city" class="form-control"
                            placeholder="City / Location" autocomplete="address-level2">
                        </div>
                      </div>

                      <div class="form-row">
                        <div class="form-group">
                          <label for="priv-pool-type">Pool Classification</label>
                          <select id="priv-pool-type" name="poolType" class="form-control">
                            <option value="Luxury Residential Villa Pool" selected>Private Villa Pool (Residential)
                            </option>
                            <option value="Vanishing Edge Infinity Pool">Private Infinity Edge Horizon Pool</option>
                            <option value="Rooftop / Penthouse Pool">Rooftop / Penthouse Sky Pool</option>
                            <option value="Hydrotherapy Jacuzzi & Spa">Private Jacuzzi & Hydro Spa</option>
                            <option value="Pool Renovation & Repair">Pool Renovation, Leak Repair & Retiling</option>
                          </select>
                        </div>
                        <div class="form-group">
                          <label for="priv-dimensions">Approx. Plot / Pool Size</label>
                          <input type="text" id="priv-dimensions" name="poolDimensions" class="form-control"
                            placeholder="Pool or Plot Dimensions">
                        </div>
                      </div>

                      <div class="form-group">
                        <label for="priv-budget">Estimated Budget (Optional)</label>
                        <select id="priv-budget" name="budget" class="form-control">
                          <option value="">Select Estimated Budget (Optional)</option>
                          <option value="₹5L - ₹15L">₹5 Lakhs - ₹15 Lakhs</option>
                          <option value="₹15L - ₹30L">₹15 Lakhs - ₹30 Lakhs</option>
                          <option value="₹30L - ₹60L">₹30 Lakhs - ₹60 Lakhs</option>
                          <option value="₹60L+">₹60 Lakhs+ (Ultra Luxury / Estate)</option>
                          <option value="Need Consultation">Need Site Inspection First</option>
                        </select>
                      </div>

                      <div class="form-group">
                        <label for="priv-message">Project Details / Requirements</label>
                        <textarea id="priv-message" name="message" rows="3" class="form-control"
                          placeholder="Describe your private pool specifications or preferred design..."></textarea>
                      </div>

                      <button type="submit" class="btn btn-yellow"
                        style="width: 100%; padding: 14px; font-size: 1rem; border-radius: var(--radius-sm); font-weight: 700;">
                        <i class="fa-solid fa-paper-plane"></i> Submit Private Pool Inquiry
                      </button>
                    </form>
          </div>
        </div>
      </div>
    </div>
  </section>

  <%- include('layouts/footer') %>