            <img src="/images/resort-pool.jpg" alt="Private Villa Swimming Pool"
              style="width: 100%; height: 500px; object-fit: cover;" decoding="async" loading="lazy">
            <div
              style="position: absolute; bottom: 0; left: 0; right: 0; padding: 25px; background: linear-gradient(180deg, transparent, rgba(6,13,25,0.92)); color: #fff;">
              <span
