<%- include('layouts/header') %>

<!-- Services Hero Section -->
<section class="page-hero-cinematic">
  <div class="page-hero-bg" style="background-image: url('/images/pool-types/vanishing-edge.webp');"></div>
  <div class="page-hero-overlay"></div>

  <div class="container position-relative" style="z-index: 10;">
    <div class="section-tag-luxury mb-3">
      <i class="bi bi-gear-wide-connected"></i> Turnkey Hydraulic & Civil Engineering
    </div>
    
    <h1 class="font-serif text-white display-4 fw-bold mb-3">
      Architectural Pool <span class="text-gradient-gold">Services & Solutions</span>
    </h1>
    
    <p class="luxury-subtext mx-auto mb-4" style="font-size: 1.15rem; color: #E2E8F0 !important; max-width: 820px;">
      From 3D topographical laser CAD modeling and monolithic RCC casting to automated chemical dosing, designer water cascades, and structural leakproofing across Gujarat and nationwide.
    </p>

    <div class="d-flex flex-wrap gap-3 justify-content-center pt-2">
      <a href="#quote-form" class="luxury-cta-btn" style="padding: 13px 32px; font-size: 0.96rem;">
        <i class="bi bi-compass"></i> Request 3D Site Survey
      </a>
      <a href="/pool-types" class="btn btn-outline-light d-inline-flex align-items-center gap-2"
        style="border-radius: var(--radius-pill); padding: 12px 28px; font-weight: 600; border-color: rgba(255,255,255,0.25); background: rgba(15,23,42,0.5); backdrop-filter: blur(10px); color: #FFFFFF;">
        <i class="bi bi-layers"></i> Browse All 9 Formats
      </a>
    </div>
  </div>
</section>

<!-- Quick Anchor Bar -->
<div class="luxury-filter-bar py-3" style="position: sticky; top: 90px; z-index: 100; background: rgba(8, 11, 16, 0.88); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); border-bottom: 1px solid rgba(212, 175, 55, 0.2);">
  <div class="container-wide">
    <div class="d-flex gap-2 overflow-x-auto pb-1 justify-content-start justify-content-md-center text-nowrap" style="scrollbar-width: none;">
      <a href="#swimming-pools" class="luxury-filter-btn active">
        <i class="bi bi-water me-1 text-gold"></i> Turnkey RCC Pools
      </a>
      <a href="#waterfalls" class="luxury-filter-btn">
        <i class="bi bi-droplet-half me-1 text-gold"></i> Waterfalls & Fountains
      </a>
      <a href="#renovation" class="luxury-filter-btn">
        <i class="bi bi-tools me-1 text-gold"></i> Renovation & Leak Repair
      </a>
      <a href="#maintenance" class="luxury-filter-btn">
        <i class="bi bi-shield-check me-1 text-gold"></i> Maintenance & AMC
      </a>
      <a href="/products" class="luxury-filter-btn">
        <i class="bi bi-box-seam me-1 text-gold"></i> Equipment Catalog
      </a>
    </div>
  </div>
</div>

<!-- Detailed Service Sections -->
<section class="section py-5 my-4">
  <div class="container-wide">

    <!-- 1. Turnkey Swimming Pools -->
    <div id="swimming-pools" class="py-5 mb-5" style="scroll-margin-top: 150px;">
      <div class="row g-5 align-items-center">
        <div class="col-lg-6">
          <div class="section-tag-luxury">
            <i class="bi bi-shield-check"></i> 100% Leakproof Monolithic RCC
          </div>
          <h2 class="font-serif text-white display-6 fw-bold mb-3">
            Turnkey Swimming Pools
          </h2>
          <p class="mb-4" style="color: #E2E8F0 !important; font-size: 1.08rem; line-height: 1.75;">
            End-to-end architectural design and civil engineering for residential private villas, boutique resorts, rooftop penthouses, and sports clubs. We oversee soil mechanics survey, heavy Fe-500D rebar cage fabrication, monolithic concrete casting with zero cold joints, and full MEP hydraulic manifold integration.
          </p>

          <div class="d-grid gap-3 mb-4">
            <div class="d-flex align-items-center gap-3">
              <i class="bi bi-check-circle-fill text-gold fs-5 flex-shrink-0"></i>
              <span class="text-white fw-semibold" style="font-size: 0.98rem;">Monolithic RCC casting with dual crystalline waterproofing barrier</span>
            </div>
            <div class="d-flex align-items-center gap-3">
              <i class="bi bi-check-circle-fill text-gold fs-5 flex-shrink-0"></i>
              <span class="text-white fw-semibold" style="font-size: 0.98rem;">Skimmer, Deck-Level Overflow, and Vanishing Edge Infinity horizon options</span>
            </div>
            <div class="d-flex align-items-center gap-3">
              <i class="bi bi-check-circle-fill text-gold fs-5 flex-shrink-0"></i>
              <span class="text-white fw-semibold" style="font-size: 0.98rem;">Turnkey commissioning backed by a written structural leakproof guarantee</span>
            </div>
          </div>

          <!-- Blueprint Specification Chips -->
          <div class="blueprint-spec-grid mb-4">
            <div class="blueprint-spec-item">
              <span class="blueprint-spec-label">Concrete</span>
              <span class="blueprint-spec-val">M-30 / M-35 Grade</span>
            </div>
            <div class="blueprint-spec-item">
              <span class="blueprint-spec-label">Steel Mesh</span>
              <span class="blueprint-spec-val">Fe-500D Dual Grid</span>
            </div>
            <div class="blueprint-spec-item">
              <span class="blueprint-spec-label">Leak Test</span>
              <span class="blueprint-spec-val">72h Hydro-Ponding</span>
            </div>
          </div>

          <a href="/contact#quote-form" class="luxury-cta-btn">
            <i class="bi bi-compass"></i> Get Turnkey Pool Quote
          </a>
        </div>

        <div class="col-lg-6">
          <div class="glass-card overflow-hidden tilt-card-3d p-2">
            <img src="/images/private-pool-hero.webp" alt="Turnkey Swimming Pools" 
                 class="w-100 rounded-4" style="height: 420px; object-fit: cover;" loading="lazy" decoding="async">
          </div>
        </div>
      </div>
    </div>

    <!-- 2. Waterfalls & Fountains -->
    <div id="waterfalls" class="py-5 mb-5 border-top border-secondary border-opacity-25" style="scroll-margin-top: 150px;">
      <div class="row g-5 align-items-center flex-lg-row-reverse">
        <div class="col-lg-6">
          <div class="section-tag-luxury">
            <i class="bi bi-water"></i> Architectural Aquatic Art
          </div>
          <h2 class="font-serif text-white display-6 fw-bold mb-3">
            Waterfalls & Fountains
          </h2>
          <p class="mb-4" style="color: #E2E8F0 !important; font-size: 1.08rem; line-height: 1.75;">
            Transform your estate pool deck and courtyard into a sensory oasis. We engineer marine-grade SS-316 sheer descent rain curtains, illuminated laminar jumping jets, natural granite cascades, and programmable dancing fountains.
          </p>

          <div class="d-grid gap-3 mb-4">
            <div class="d-flex align-items-center gap-3">
              <i class="bi bi-check-circle-fill text-gold fs-5 flex-shrink-0"></i>
              <span class="text-white fw-semibold" style="font-size: 0.98rem;">SS-304 & SS-316 high-grade sheer water blades with warm 3000K LED glow</span>
            </div>
            <div class="d-flex align-items-center gap-3">
              <i class="bi bi-check-circle-fill text-gold fs-5 flex-shrink-0"></i>
              <span class="text-white fw-semibold" style="font-size: 0.98rem;">Whisper-quiet hydraulic booster pumps with multi-pattern control consoles</span>
            </div>
            <div class="d-flex align-items-center gap-3">
              <i class="bi bi-check-circle-fill text-gold fs-5 flex-shrink-0"></i>
              <span class="text-white fw-semibold" style="font-size: 0.98rem;">Seamless integration with imported natural granite, basalt, and slate walls</span>
            </div>
          </div>

          <div class="blueprint-spec-grid mb-4">
            <div class="blueprint-spec-item">
              <span class="blueprint-spec-label">Blade Grade</span>
              <span class="blueprint-spec-val">SS-316 Marine</span>
            </div>
            <div class="blueprint-spec-item">
              <span class="blueprint-spec-label">Hydraulics</span>
              <span class="blueprint-spec-val">Silent Booster</span>
            </div>
            <div class="blueprint-spec-item">
              <span class="blueprint-spec-label">Illumination</span>
              <span class="blueprint-spec-val">RGBW / 3000K Warm</span>
            </div>
          </div>

          <a href="/contact#quote-form" class="luxury-cta-btn">
            <i class="bi bi-stars"></i> Customize Water Feature
          </a>
        </div>

        <div class="col-lg-6">
          <div class="glass-card overflow-hidden tilt-card-3d p-2">
            <img src="/images/pool-types/vanishing-edge.webp" alt="Waterfalls & Fountains" 
                 class="w-100 rounded-4" style="height: 420px; object-fit: cover;" loading="lazy" decoding="async">
          </div>
        </div>
      </div>
    </div>

    <!-- 3. Pool Renovation & Leak Repair -->
    <div id="renovation" class="py-5 mb-5 border-top border-secondary border-opacity-25" style="scroll-margin-top: 150px;">
      <div class="row g-5 align-items-center">
        <div class="col-lg-6">
          <div class="section-tag-luxury">
            <i class="bi bi-tools"></i> Structural Restoration
          </div>
          <h2 class="font-serif text-white display-6 fw-bold mb-3">
            Pool Renovation & Leak Repair
          </h2>
          <p class="mb-4" style="color: #E2E8F0 !important; font-size: 1.08rem; line-height: 1.75;">
            Give your aging swimming pool a 5-star rebirth. Our structural restoration specialists fix active concrete cracks, re-waterproof leaking basins with high-pressure polyurethane injections, replace brittle PVC lines, and install modern Spanish mosaic tiles.
          </p>

          <div class="d-grid gap-3 mb-4">
            <div class="d-flex align-items-center gap-3">
              <i class="bi bi-check-circle-fill text-gold fs-5 flex-shrink-0"></i>
              <span class="text-white fw-semibold" style="font-size: 0.98rem;">High-pressure polyurethane (PU) injection structural crack leak sealing</span>
            </div>
            <div class="d-flex align-items-center gap-3">
              <i class="bi bi-check-circle-fill text-gold fs-5 flex-shrink-0"></i>
              <span class="text-white fw-semibold" style="font-size: 0.98rem;">Complete retiling with designer glass mosaics and chemical epoxy regrouting</span>
            </div>
            <div class="d-flex align-items-center gap-3">
              <i class="bi bi-check-circle-fill text-gold fs-5 flex-shrink-0"></i>
              <span class="text-white fw-semibold" style="font-size: 0.98rem;">Energy-efficient inverter pump retrofits & automated saltwater chlorination</span>
            </div>
          </div>

          <div class="blueprint-spec-grid mb-4">
            <div class="blueprint-spec-item">
              <span class="blueprint-spec-label">Injection</span>
              <span class="blueprint-spec-val">High-Pressure PU</span>
            </div>
            <div class="blueprint-spec-item">
              <span class="blueprint-spec-label">Surfacing</span>
              <span class="blueprint-spec-val">Epoxy Glass Mosaic</span>
            </div>
            <div class="blueprint-spec-item">
              <span class="blueprint-spec-label">Energy</span>
              <span class="blueprint-spec-val">-80% Inverter Pump</span>
            </div>
          </div>

          <a href="/contact#quote-form" class="luxury-cta-btn">
            <i class="bi bi-wrench"></i> Schedule Leak Inspection
          </a>
        </div>

        <div class="col-lg-6">
          <div class="glass-card overflow-hidden tilt-card-3d p-2">
            <img src="/images/resort-pool.webp" alt="Pool Renovation" 
                 class="w-100 rounded-4" style="height: 420px; object-fit: cover;" loading="lazy" decoding="async">
          </div>
        </div>
      </div>
    </div>

    <!-- 4. Maintenance & AMC Care -->
    <div id="maintenance" class="py-5 border-top border-secondary border-opacity-25" style="scroll-margin-top: 150px;">
      <div class="row g-5 align-items-center flex-lg-row-reverse">
        <div class="col-lg-6">
          <div class="section-tag-luxury">
            <i class="bi bi-award"></i> Crystal Water 365 Days
          </div>
          <h2 class="font-serif text-white display-6 fw-bold mb-3">
            Maintenance & AMC Care
          </h2>
          <p class="mb-4" style="color: #E2E8F0 !important; font-size: 1.08rem; line-height: 1.75;">
            Enjoy sparkling, hygienic, algae-free water without lifting a finger. Our Annual Maintenance Contracts (AMC) include routine water chemical testing, automated pH and salt balancing, robotic vacuum floor scrubbing, high-rate filter backwashing, and pump servicing.
          </p>

          <div class="d-grid gap-3 mb-4">
            <div class="d-flex align-items-center gap-3">
              <i class="bi bi-check-circle-fill text-gold fs-5 flex-shrink-0"></i>
              <span class="text-white fw-semibold" style="font-size: 0.98rem;">Weekly or bi-weekly pool chemical testing, pH balancing, and sanitization</span>
            </div>
            <div class="d-flex align-items-center gap-3">
              <i class="bi bi-check-circle-fill text-gold fs-5 flex-shrink-0"></i>
              <span class="text-white fw-semibold" style="font-size: 0.98rem;">Pump strainer basket clearing, valve diagnostics & automated backwash cycles</span>
            </div>
            <div class="d-flex align-items-center gap-3">
              <i class="bi bi-check-circle-fill text-gold fs-5 flex-shrink-0"></i>
              <span class="text-white fw-semibold" style="font-size: 0.98rem;">24/7 priority emergency response for private villa estates and luxury hotels</span>
            </div>
          </div>

          <div class="blueprint-spec-grid mb-4">
            <div class="blueprint-spec-item">
              <span class="blueprint-spec-label">Frequency</span>
              <span class="blueprint-spec-val">Weekly / Bi-Weekly</span>
            </div>
            <div class="blueprint-spec-item">
              <span class="blueprint-spec-label">Water Test</span>
              <span class="blueprint-spec-val">Digital Photometer</span>
            </div>
            <div class="blueprint-spec-item">
              <span class="blueprint-spec-label">Support</span>
              <span class="blueprint-spec-val">24/7 VIP Concierge</span>
            </div>
          </div>

          <a href="/contact#quote-form" class="luxury-cta-btn">
            <i class="bi bi-file-earmark-text"></i> Inquire for AMC Plans
          </a>
        </div>

        <div class="col-lg-6">
          <div class="glass-card overflow-hidden tilt-card-3d p-2">
            <img src="/images/jacuzzi-spa.webp" alt="Maintenance and AMC Care" 
                 class="w-100 rounded-4" style="height: 420px; object-fit: cover;" loading="lazy" decoding="async">
          </div>
        </div>
      </div>
    </div>

  </div>
</section>

<!-- Luxury Consultation & Estimate Section -->
<section class="section py-5 my-4" id="quote-form" style="background: rgba(15, 23, 42, 0.5);">
  <div class="container-wide">
    <div class="row g-5 align-items-center">
      
      <div class="col-lg-5">
        <div class="section-tag-luxury">
          <i class="bi bi-compass"></i> Direct Engineering Consultation
        </div>
        <h2 class="font-serif text-white display-6 fw-bold mb-3">
          Speak with our Senior Pool Architects
        </h2>
        <p class="luxury-subtext mb-4" style="color: #E2E8F0 !important; font-size: 1.08rem; line-height: 1.75;">
          We offer complimentary site surveys across Surat, Gujarat, and nationwide. Get transparent itemized estimates with our 100% monolithic leakproof guarantee.
        </p>

        <div class="glass-card p-4 mb-4">
          <div class="text-gold fw-bold mb-2 small text-uppercase" style="letter-spacing: 0.8px;">
            <i class="bi bi-geo-alt-fill me-1"></i> Surat Studio & Corporate Office:
          </div>
          <p class="text-white mb-2" style="font-size: 0.95rem; line-height: 1.6;">
            <%= typeof settings !== 'undefined' && settings.address ? settings.address : 'A-8, Laxmikant Ashram Rd, Rashi Circle, Bhulabhai Desai Park, Hari Darshan Society, Katargam, Surat, Gujarat 395004' %>
          </p>
          <div class="d-flex align-items-center gap-2 text-muted small">
            <i class="bi bi-clock text-gold me-1"></i> Mon-Sat: 9AM - 8PM
          </div>
        </div>

        <div class="d-flex align-items-center gap-2 text-muted small">
          <i class="bi bi-shield-check text-gold fs-5"></i>
          <span>16+ Years Turnkey Mastery &bull; 720+ Pools Completed</span>
        </div>
      </div>

      <div class="col-lg-7">
        <div class="luxury-form-card">
          <h3 class="font-serif text-white mb-2" style="font-size: 1.6rem;">
            Request Service Estimate
          </h3>
          <p class="small mb-4" style="color: #CBD5E1 !important;">
            Reach out for consultation, 3D design, construction or AMC maintenance.
          </p>

          <form action="/inquiry" method="POST">
            <div class="row g-3">
              <div class="col-md-6">
                <label for="srv-name" class="luxury-label">Your Full Name *</label>
                <input type="text" id="srv-name" name="name" class="luxury-input" placeholder="e.g. Vikramaditya Singhania" required autocomplete="name">
              </div>

              <div class="col-md-6">
                <label for="srv-phone" class="luxury-label">Mobile Number *</label>
                <input type="tel" id="srv-phone" name="phone" class="luxury-input" placeholder="Enter 10-digit mobile number" required autocomplete="tel">
              </div>

              <div class="col-md-6">
                <label for="srv-service" class="luxury-label">Service of Interest</label>
                <select id="srv-service" name="poolType" class="luxury-select">
                  <option value="Turnkey Swimming Pools">Turnkey Swimming Pool Construction</option>
                  <option value="Vanishing Edge Infinity Pool">Vanishing Edge Infinity Horizon Pools</option>
                  <option value="Waterfalls & Fountains">Waterfalls & Fountain Features</option>
                  <option value="Pool Renovation, Leak Repair & Retiling">Pool Renovation & Structural Leak Repair</option>
                  <option value="Annual Maintenance & AMC">Annual Maintenance & Automated Dosing AMC</option>
                </select>
              </div>

              <div class="col-md-6">
                <label for="srv-city" class="luxury-label">City / Project Location *</label>
                <input type="text" id="srv-city" name="city" class="luxury-input" placeholder="Surat, Mumbai, Goa, etc." required autocomplete="address-level2">
              </div>

              <div class="col-12">
                <label for="srv-message" class="luxury-label">Message / Project Specifics</label>
                <textarea id="srv-message" name="message" rows="3" class="luxury-textarea"
                  placeholder="Describe your service requirements, pool dimensions, or property specifics..."></textarea>
              </div>

              <div class="col-12 pt-2">
                <button type="submit" class="luxury-cta-btn w-100 justify-content-center" style="padding: 14px; font-size: 1rem;">
                  <i class="bi bi-send-fill"></i> Submit Service Request
                </button>
              </div>
            </div>
          </form>
        </div>
      </div>

    </div>
  </div>
</section>

<%- include('layouts/footer') %>