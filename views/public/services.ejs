<%- include('layouts/header') %>

  <!-- ===================================================================
     SERVICES HERO SECTION
     =================================================================== -->
  <section class="services-hero-cinematic">
    <!-- Cinematic Dedicated Background Image -->
    <div class="services-hero-bg"></div>

    <!-- Sophisticated Contrast Gradient Overlay -->
    <div class="services-hero-overlay"></div>

    <div class="container-wide" style="position: relative; z-index: 10;">
      <div style="max-width: 900px;">
        <span class="section-tag-gold"
          style="margin-bottom: 20px; display: inline-flex; align-items: center; gap: 8px; background: rgba(245, 158, 11, 0.16); color: #fbbf24; border: 1px solid rgba(245, 158, 11, 0.4); backdrop-filter: blur(14px); box-shadow: 0 4px 20px rgba(245, 158, 11, 0.22); padding: 8px 18px; border-radius: 50px; font-size: 0.84rem; font-weight: 700; letter-spacing: 1px; text-transform: uppercase;">
          <i class="fa-solid fa-water-ladder" style="color: #fbbf24;"></i> 16+ Years Engineering Excellence
        </span>
        <h1
          style="font-family: var(--font-hero); font-size: clamp(2.8rem, 6vw, 4.6rem); font-weight: 900; line-height: 1.05; color: #ffffff; margin-bottom: 20px; text-shadow: 0 4px 24px rgba(0, 0, 0, 0.65);">
          Turnkey Pool <span class="text-glow-gradient">Services & Solutions</span>
        </h1>
        <p
          style="font-size: clamp(1.1rem, 1.8vw, 1.3rem); color: #e2e8f0; font-weight: 500; line-height: 1.7; max-width: 760px; margin-bottom: 30px; text-shadow: 0 2px 14px rgba(0, 0, 0, 0.75);">
          From 3D architectural modeling and monolithic concrete casting to automated chemical dosing, designer water
          curtains, and structural leakproofing.
        </p>

        <div style="display: flex; gap: 14px; flex-wrap: wrap;">
          <a href="#quote-form" class="btn btn-yellow" style="box-shadow: 0 8px 24px rgba(245, 158, 11, 0.42);">
            <i class="fa-solid fa-compass-drafting"></i> Request Free Site Survey
          </a>
          <a href="/pool-types" class="btn btn-glass"
            style="background: rgba(255, 255, 255, 0.14); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); color: #ffffff; border: 1px solid rgba(255, 255, 255, 0.32); box-shadow: 0 6px 20px rgba(0, 0, 0, 0.15);">
            <i class="fa-solid fa-layer-group"></i> Browse Pool Designs
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================================================================
     QUICK ANCHOR BAR
     =================================================================== -->
  <div class="quick-anchor-sticky-bar">
    <div class="container-wide"
      style="overflow-x: auto; white-space: nowrap; -webkit-overflow-scrolling: touch; scrollbar-width: none;">
      <div style="display: inline-flex; gap: 10px; padding: 2px;">
        <a href="#swimming-pools" class="filter-pill"><i class="fa-solid fa-person-swimming"></i> Turnkey RCC Pools</a>
        <a href="#waterfalls" class="filter-pill"><i class="fa-solid fa-water"></i> Waterfalls & Fountains</a>
        <a href="#renovation" class="filter-pill"><i class="fa-solid fa-screwdriver-wrench"></i> Pool Renovation</a>
        <a href="#maintenance" class="filter-pill"><i class="fa-solid fa-hand-holding-droplet"></i> Maintenance &
          AMC</a>
        <a href="/products" class="filter-pill"><i class="fa-solid fa-gears"></i> Equipment Catalog</a>
      </div>
    </div>
  </div>

  <!-- ===================================================================
     DETAILED SERVICE SECTIONS (ANCHORED FOR DIRECT NAVBAR LINKS)
     =================================================================== -->
  <section class="section">
    <div class="container-wide">

      <!-- 1. Turnkey Swimming Pools -->
      <div id="swimming-pools" style="padding-top: 40px; margin-bottom: 80px; scroll-margin-top: 140px;">
        <div class="showcase-row">
          <div>
            <span class="section-tag-gold"><i class="fa-solid fa-shield-halved"></i> 100% Leakproof RCC
              Construction</span>
            <h2 class="dive-heading" style="margin-bottom: 16px;">Turnkey Swimming Pools</h2>
            <p style="font-size: 1.1rem; color: var(--text-muted); line-height: 1.7; margin-bottom: 20px;">
              End-to-end design and civil engineering for residential villas, hotels, farmhouses, and sports academies.
              We handle architectural CAD drawings, structural excavation, shuttering, monolithic concrete casting, and
              full MEP plumbing manifold setup.
            </p>
            <ul style="list-style: none; padding: 0; margin-bottom: 28px; display: grid; gap: 12px;">
              <li style="display: flex; gap: 10px; align-items: center; color: var(--text-main); font-weight: 600;">
                <i class="fa-solid fa-circle-check" style="color: var(--brand-cyan);"></i> Monolithic RCC pouring with
                dual crystalline waterproofing membrane
              </li>
              <li style="display: flex; gap: 10px; align-items: center; color: var(--text-main); font-weight: 600;">
                <i class="fa-solid fa-circle-check" style="color: var(--brand-cyan);"></i> Skimmer, Deck-Level Overflow,
                and Vanishing Infinity Edge options
              </li>
              <li style="display: flex; gap: 10px; align-items: center; color: var(--text-main); font-weight: 600;">
                <i class="fa-solid fa-circle-check" style="color: var(--brand-cyan);"></i> Turnkey handover backed by a
                comprehensive structural leakproof warranty
              </li>
            </ul>
            <a href="/contact#quote-form" class="btn btn-yellow">
              <i class="fa-solid fa-calculator"></i> Get Turnkey Pool Quote
            </a>
          </div>
          <div>
            <div
              style="border-radius: var(--radius-bento); overflow: hidden; box-shadow: 0 20px 45px rgba(0,0,0,0.18); border: 1px solid var(--border-subtle);">
              <img src="/images/private-pool-hero.webp"
                alt="Turnkey Swimming Pools" style="width: 100%; height: 400px; object-fit: cover;" decoding="async" loading="lazy">
            </div>
          </div>
        </div>
      </div>

      <!-- 2. Waterfalls & Fountains -->
      <div id="waterfalls"
        style="padding-top: 40px; margin-bottom: 80px; scroll-margin-top: 140px; border-top: 1px solid var(--border-subtle);">
        <div class="showcase-row reverse">
          <div>
            <div
              style="border-radius: var(--radius-bento); overflow: hidden; box-shadow: 0 20px 45px rgba(0,0,0,0.18); border: 1px solid var(--border-subtle);">
              <img src="/images/pool-types/vanishing-edge.webp"
                alt="Waterfalls & Fountains" style="width: 100%; height: 400px; object-fit: cover;" decoding="async" loading="lazy">
            </div>
          </div>
          <div>
            <span class="section-tag-gold"><i class="fa-solid fa-water"></i> Architectural Water Art</span>
            <h2 class="dive-heading" style="margin-bottom: 16px;">Waterfalls & Fountains</h2>
            <p style="font-size: 1.1rem; color: var(--text-muted); line-height: 1.7; margin-bottom: 20px;">
              Transform your pool deck and courtyard with dynamic water features. We engineer stainless steel sheer
              descent rain curtains, laminar jumping jets, natural rock cascades, and musical dancing fountains.
            </p>
            <ul style="list-style: none; padding: 0; margin-bottom: 28px; display: grid; gap: 12px;">
              <li style="display: flex; gap: 10px; align-items: center; color: var(--text-main); font-weight: 600;">
                <i class="fa-solid fa-circle-check" style="color: var(--brand-cyan);"></i> SS-304 & SS-316 high-grade
                sheer descent water blades with LED illumination
              </li>
              <li style="display: flex; gap: 10px; align-items: center; color: var(--text-main); font-weight: 600;">
                <i class="fa-solid fa-circle-check" style="color: var(--brand-cyan);"></i> Silent hydraulic booster
                pumps with multi-pattern control consoles
              </li>
              <li style="display: flex; gap: 10px; align-items: center; color: var(--text-main); font-weight: 600;">
                <i class="fa-solid fa-circle-check" style="color: var(--brand-cyan);"></i> Custom natural granite and
                slate stonework integration
              </li>
            </ul>
            <a href="/contact#quote-form" class="btn btn-yellow">
              <i class="fa-solid fa-wand-magic-sparkles"></i> Customize Water Feature
            </a>
          </div>
        </div>
      </div>

      <!-- 3. Pool Renovation -->
      <div id="renovation"
        style="padding-top: 40px; margin-bottom: 80px; scroll-margin-top: 140px; border-top: 1px solid var(--border-subtle);">
        <div class="showcase-row">
          <div>
            <span class="section-tag-gold"><i class="fa-solid fa-screwdriver-wrench"></i> Structural Rebirth</span>
            <h2 class="dive-heading" style="margin-bottom: 16px;">Pool Renovation & Leak Repair</h2>
            <p style="font-size: 1.1rem; color: var(--text-muted); line-height: 1.7; margin-bottom: 20px;">
              Give your aging swimming pool a new life. Our structural restoration specialists fix active concrete
              cracks, re-waterproof leaking basins, replace outdated plumbing lines, and install modern Spanish mosaic
              tiles.
            </p>
            <ul style="list-style: none; padding: 0; margin-bottom: 28px; display: grid; gap: 12px;">
              <li style="display: flex; gap: 10px; align-items: center; color: var(--text-main); font-weight: 600;">
                <i class="fa-solid fa-circle-check" style="color: var(--brand-cyan);"></i> High-pressure polyurethane
                (PU) injection crack leak sealing
              </li>
              <li style="display: flex; gap: 10px; align-items: center; color: var(--text-main); font-weight: 600;">
                <i class="fa-solid fa-circle-check" style="color: var(--brand-cyan);"></i> Complete retiling with
                designer glass mosaics and epoxy grout
              </li>
              <li style="display: flex; gap: 10px; align-items: center; color: var(--text-main); font-weight: 600;">
                <i class="fa-solid fa-circle-check" style="color: var(--brand-cyan);"></i> Energy-efficient pump
                retrofit & automated saltwater conversion
              </li>
            </ul>
            <a href="/contact#quote-form" class="btn btn-yellow">
              <i class="fa-solid fa-house-chimney-crack"></i> Schedule Leak Inspection
            </a>
          </div>
          <div>
            <div
              style="border-radius: var(--radius-bento); overflow: hidden; box-shadow: 0 20px 45px rgba(0,0,0,0.18); border: 1px solid var(--border-subtle);">
              <img src="/images/resort-pool.jpg"
                alt="Pool Renovation" style="width: 100%; height: 400px; object-fit: cover;" decoding="async" loading="lazy">
            </div>
          </div>
        </div>
      </div>

      <!-- 4. Maintenance & AMC -->
      <div id="maintenance"
        style="padding-top: 40px; margin-bottom: 60px; scroll-margin-top: 140px; border-top: 1px solid var(--border-subtle);">
        <div class="showcase-row reverse">
          <div>
            <div
              style="border-radius: var(--radius-bento); overflow: hidden; box-shadow: 0 20px 45px rgba(0,0,0,0.18); border: 1px solid var(--border-subtle);">
              <img src="/images/jacuzzi-spa.jpg"
                alt="Maintenance & AMC" style="width: 100%; height: 400px; object-fit: cover;" decoding="async" loading="lazy">
            </div>
          </div>
          <div>
            <span class="section-tag-gold"><i class="fa-solid fa-hand-holding-droplet"></i> Crystal Clear Water 365
              Days</span>
            <h2 class="dive-heading" style="margin-bottom: 16px;">Maintenance & AMC Care</h2>
            <p style="font-size: 1.1rem; color: var(--text-muted); line-height: 1.7; margin-bottom: 20px;">
              Enjoy sparkling, hygienic, algae-free water without lifting a finger. Our Annual Maintenance Contracts
              (AMC) include routine water chemical testing, pH/chlorine balancing, robotic vacuum bottom sweeping, sand
              filter backwashing, and pump servicing.
            </p>
            <ul style="list-style: none; padding: 0; margin-bottom: 28px; display: grid; gap: 12px;">
              <li style="display: flex; gap: 10px; align-items: center; color: var(--text-main); font-weight: 600;">
                <i class="fa-solid fa-circle-check" style="color: var(--brand-cyan);"></i> Weekly or bi-weekly pool
                chemical testing and sanitization
              </li>
              <li style="display: flex; gap: 10px; align-items: center; color: var(--text-main); font-weight: 600;">
                <i class="fa-solid fa-circle-check" style="color: var(--brand-cyan);"></i> Pump basket emptying, valve
                inspections & media backwash cycles
              </li>
              <li style="display: flex; gap: 10px; align-items: center; color: var(--text-main); font-weight: 600;">
                <i class="fa-solid fa-circle-check" style="color: var(--brand-cyan);"></i> 24/7 priority emergency
                support for villa and hotel properties
              </li>
            </ul>
            <a href="/contact#quote-form" class="btn btn-yellow">
              <i class="fa-solid fa-file-signature"></i> Inquire for AMC Plans
            </a>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- ===================================================================
     FREE ESTIMATE SECTION
     =================================================================== -->
  <section class="section" id="quote-form" style="background: var(--bg-card-subtle);">
    <div class="container">
      <div class="quote-banner">
        <div class="quote-grid">
          <div>
            <span class="section-tag-gold"><i class="fa-solid fa-compass-drafting"></i> Free Consultation</span>
            <h2
              style="font-family: var(--font-hero); font-size: clamp(2rem, 3.5vw, 2.8rem); font-weight: 900; margin-bottom: 16px;">
              Speak with our Senior Pool Architects
            </h2>
            <p style="color: var(--text-muted); font-size: 1.05rem; margin-bottom: 25px; line-height: 1.6;">
              We offer complimentary site surveys across Surat, Gujarat, and nationwide. Get itemized transparent
              estimates with zero obligation.
            </p>

            <div
              style="background: var(--bg-card); padding: 18px 22px; border-radius: 12px; border: 1px solid var(--border-subtle); margin-bottom: 25px;">
              <div style="font-weight: 700; color: var(--brand-cyan); margin-bottom: 6px;">
                <i class="fa-solid fa-location-dot"></i> Surat Corporate Office:
              </div>
              <div style="color: var(--text-main); font-size: 0.9rem; line-height: 1.5;">
                A-8, Laxmikant Ashram Rd, Rashi Circle, Bhulabhai Desai Park, Hari Darshan Society, Katargam, Surat,
                Gujarat 395004
              </div>
            </div>
          </div>

          <div class="quote-form-card" id="quote-form">
            <h3 style="font-family: var(--font-hero); font-size: 1.5rem; font-weight: 800; margin-bottom: 8px;">
              Request Service Estimate
            </h3>
            <p style="color: var(--text-muted); font-size: 0.9rem; margin-bottom: 20px;">
              Reach out for consultation, 3D design, construction or AMC maintenance.
            </p>

            <% if (locals.success_msg && success_msg.length> 0) { %>
              <div
                style="background: #dcfce7; color: #166534; padding: 12px 16px; border-radius: 8px; margin-bottom: 20px; font-size: 0.92rem; font-weight: 600; border: 1px solid #bbf7d0;">
                <i class="fa-solid fa-circle-check"></i>
                <%= success_msg %>
              </div>
              <% } %>

                <% if (locals.error_msg && error_msg.length> 0) { %>
                  <div
                    style="background: #fee2e2; color: #991b1b; padding: 12px 16px; border-radius: 8px; margin-bottom: 20px; font-size: 0.92rem; font-weight: 600; border: 1px solid #fecaca;">
                    <i class="fa-solid fa-triangle-exclamation"></i>
                    <%= error_msg %>
                  </div>
                  <% } %>

                    <form action="/inquiry" method="POST">
                      <div class="form-row">
                        <div class="form-group">
                          <label for="srv-name">Your Name *</label>
                          <input type="text" id="srv-name" name="name" class="form-control" placeholder="Your Name"
                            autocomplete="name" required>
                        </div>
                        <div class="form-group">
                          <label for="srv-phone">Phone / Mobile *</label>
                          <input type="tel" id="srv-phone" name="phone" class="form-control" placeholder="Phone Number"
                            autocomplete="tel" required>
                        </div>
                      </div>

                      <div class="form-row">
                        <div class="form-group">
                          <label for="srv-service">Service of Interest</label>
                          <select id="srv-service" name="poolType" class="form-control">
                            <option value="Turnkey Swimming Pools">Turnkey Swimming Pool Construction</option>
                            <option value="Infinity Edge Pools">Vanishing Edge Infinity Pools</option>
                            <option value="Waterfalls & Fountains">Waterfalls & Fountain Features</option>
                            <option value="Pool Renovation & Repair">Pool Renovation & Crack Leak Repair</option>
                            <option value="Maintenance & AMC">Maintenance & Cleaning AMC</option>
                          </select>
                        </div>
                        <div class="form-group">
                          <label for="srv-city">City / Location</label>
                          <input type="text" id="srv-city" name="city" class="form-control"
                            placeholder="City / Location" autocomplete="address-level2">
                        </div>
                      </div>

                      <div class="form-group">
                        <label for="srv-message">Message / Project Specifics</label>
                        <textarea id="srv-message" name="message" rows="3" class="form-control"
                          placeholder="Describe your service requirements or project specifics..."></textarea>
                      </div>

                      <button type="submit" class="btn btn-yellow"
                        style="width: 100%; padding: 14px; font-weight: 700; border-radius: var(--radius-sm);">
                        <i class="fa-solid fa-paper-plane"></i> Submit Service Request
                      </button>
                    </form>
          </div>
        </div>
      </div>
    </div>
  </section>

  <%- include('layouts/footer') %>