<%- include('layouts/header') %>

<!-- Hero Banner: Complimentary 3D Laser Site Survey -->
<section class="page-hero-section py-5 position-relative overflow-hidden" style="background: radial-gradient(circle at 50% 15%, #10233D 0%, #080B10 80%); padding-top: 140px !important;">
  <div class="container-wide text-center position-relative" style="z-index: 2;">
    
    <div class="blueprint-badge blueprint-badge-gold mb-3 d-inline-flex align-items-center gap-2">
      <i class="bi bi-compass"></i> Complimentary Architectural Feasibility
    </div>

    <h1 class="font-serif text-white display-4 fw-bold mb-3" style="letter-spacing: -0.5px;">
      Book a Free 3D Laser Site Survey<br>
      <span class="text-gold">&amp; Architectural Blueprint Estimate</span>
    </h1>

    <p class="text-muted max-w-700 mx-auto mb-4" style="font-size: 1.12rem; line-height: 1.8;">
      Our senior civil engineers visit your estate plot in Surat, Gujarat, or Western India. We inspect soil bearing capacity, conduct precision laser topography surveys, and model photorealistic 3D CAD walkthroughs before casting a single drop of concrete.
    </p>

    <!-- 4-Stat Strip -->
    <div class="luxury-stats-strip my-4">
      <div class="luxury-stat-card">
        <div class="luxury-stat-num">48 Hrs</div>
        <div class="luxury-stat-label">Rapid Site Visit</div>
        <p class="text-muted small mb-0 mt-1">Lead engineer arrives at your plot</p>
      </div>
      <div class="luxury-stat-card">
        <div class="luxury-stat-num">100% Free</div>
        <div class="luxury-stat-label">Laser Topography</div>
        <p class="text-muted small mb-0 mt-1">Precise millimeter grade elevation</p>
      </div>
      <div class="luxury-stat-card">
        <div class="luxury-stat-num">3D CAD</div>
        <div class="luxury-stat-label">Architectural Render</div>
        <p class="text-muted small mb-0 mt-1">Photorealistic lighting & pool visual</p>
      </div>
      <div class="luxury-stat-card">
        <div class="luxury-stat-num">Fixed BOQ</div>
        <div class="luxury-stat-label">Itemized Milestone Cost</div>
        <p class="text-muted small mb-0 mt-1">Zero hidden charges guarantee</p>
      </div>
    </div>

  </div>
</section>

<!-- Main 3D Survey & Consultation Section -->
<section class="section py-5 my-3" id="survey-form">
  <div class="container-wide">
    <div class="row g-5">
      
      <!-- Left Column: Survey Scope & Studio Details -->
      <div class="col-lg-5">
        
        <div class="mb-4">
          <span class="blueprint-badge blueprint-badge-gold mb-2 d-inline-block">The 4-Step Engineering Protocol</span>
          <h2 class="font-serif text-white fs-3 mb-3">What Happens During Your 3D Site Survey?</h2>
          <p class="text-muted small" style="line-height: 1.7;">
            We eliminate trial-and-error civil works by combining aerospace-grade digital laser levelers with hydraulic modeling:
          </p>
        </div>

        <!-- 4 Step Cards -->
        <div class="d-flex flex-column gap-3 mb-4">
          <div class="glass-card p-3 d-flex align-items-start gap-3">
            <div class="stat-icon-wrap flex-shrink-0" style="width: 42px; height: 42px; font-size: 1.1rem; margin-bottom: 0;">
              <i class="bi bi-geo-fill"></i>
            </div>
            <div>
              <strong class="text-white d-block mb-1" style="font-size: 0.95rem;">1. Laser Ground & Sloping Scan</strong>
              <p class="text-muted small mb-0">Millimeter-level laser topography determines natural drainage slopes, soil strata, and boundary setbacks.</p>
            </div>
          </div>

          <div class="glass-card p-3 d-flex align-items-start gap-3">
            <div class="stat-icon-wrap flex-shrink-0" style="width: 42px; height: 42px; font-size: 1.1rem; margin-bottom: 0;">
              <i class="bi bi-water"></i>
            </div>
            <div>
              <strong class="text-white d-block mb-1" style="font-size: 0.95rem;">2. Hydraulic Line & Balance Tank Layout</strong>
              <p class="text-muted small mb-0">Precise pipe routing for main drains, skimmers, filtration pumps, and overflow surge tanks with zero friction loss.</p>
            </div>
          </div>

          <div class="glass-card p-3 d-flex align-items-start gap-3">
            <div class="stat-icon-wrap flex-shrink-0" style="width: 42px; height: 42px; font-size: 1.1rem; margin-bottom: 0;">
              <i class="bi bi-layers-half"></i>
            </div>
            <div>
              <strong class="text-white d-block mb-1" style="font-size: 0.95rem;">3. Monolithic RCC Thickness Engineering</strong>
              <p class="text-muted solid mb-0">Structural steel reinforcement schedule (TMT bars & crystalline waterproofing) designed for 100% leakproof integrity.</p>
            </div>
          </div>

          <div class="glass-card p-3 d-flex align-items-start gap-3">
            <div class="stat-icon-wrap flex-shrink-0" style="width: 42px; height: 42px; font-size: 1.1rem; margin-bottom: 0;">
              <i class="bi bi-file-earmark-spreadsheet"></i>
            </div>
            <div>
              <strong class="text-white d-block mb-1" style="font-size: 0.95rem;">4. Comprehensive Milestone BOQ Estimate</strong>
              <p class="text-muted small mb-0">Written contractual proposal detailing excavation, civil RCC casting, Italian filtration hardware, tiles, and timeline.</p>
            </div>
          </div>
        </div>

        <!-- Studio Address Card -->
        <div class="glass-card p-4 mb-4">
          <div class="text-gold fw-bold mb-2 small text-uppercase" style="letter-spacing: 0.8px;">
            <i class="bi bi-geo-alt-fill me-1"></i> Surat Studio & Corporate Office:
          </div>
          <p class="text-white mb-2" style="font-size: 0.94rem; line-height: 1.6;">
            <%= typeof settings !== 'undefined' && settings.address ? settings.address : 'A-8, Laxmikant Ashram Rd, Rashi Circle, Bhulabhai Desai Park, Hari Darshan Society, Katargam, Surat, Gujarat 395004' %>
          </p>
          <div class="d-flex align-items-center gap-2 small text-muted">
            <i class="bi bi-clock text-gold me-1"></i> Mon-Sat: 9AM - 8PM
          </div>
        </div>

        <!-- Direct WhatsApp Concierge -->
        <div class="p-3 rounded-4 d-flex align-items-center justify-content-between" style="background: rgba(37, 211, 102, 0.12); border: 1px solid rgba(37, 211, 102, 0.35);">
          <div class="d-flex align-items-center gap-3">
            <i class="bi bi-whatsapp text-success fs-3"></i>
            <div>
              <strong class="text-white d-block small">Have Architectural CAD Drawings Ready?</strong>
              <span class="text-muted small">Share plot maps directly with our lead civil architect</span>
            </div>
          </div>
          <a href="https://wa.me/918128920702?text=Hello%20Blue%20Sky,%20I%20would%20like%20to%20schedule%20a%20Free%203D%20Site%20Survey%20for%20my%20swimming%20pool%20project." 
            target="_blank" rel="noopener noreferrer" class="btn btn-success btn-sm px-3 fw-bold rounded-pill text-nowrap">
            WhatsApp
          </a>
        </div>

      </div>

      <!-- Right Column: Priority 3D Survey Request Form -->
      <div class="col-lg-7">
        <div class="luxury-form-card" id="quote-form-box" style="position: sticky; top: 110px;">
          
          <div class="d-flex align-items-center justify-content-between mb-3">
            <span class="blueprint-badge blueprint-badge-gold">Priority Architectural Routing</span>
            <span class="text-muted small"><i class="bi bi-shield-lock-fill text-gold me-1"></i> Strict NDA Confidentiality</span>
          </div>

          <h3 class="font-serif text-white mb-2" style="font-size: 1.65rem;">
            Schedule Your Free 3D Site Survey
          </h3>
          <p class="small mb-4" style="color: #CBD5E1 !important;">
            Fill in your project details below. Our senior civil pool engineer will call you within 2 business hours to confirm site inspection timing.
          </p>

          <form action="/inquiry" method="POST">
            <div class="row g-3">
              
              <div class="col-md-6">
                <label for="survey-name" class="luxury-label">Your Full Name *</label>
                <input type="text" id="survey-name" name="name" class="luxury-input" placeholder="e.g. Vikramaditya Singhania" required autocomplete="name">
              </div>

              <div class="col-md-6">
                <label for="survey-phone" class="luxury-label">Mobile Number / WhatsApp *</label>
                <input type="tel" id="survey-phone" name="phone" class="luxury-input" placeholder="Enter 10-digit mobile number" required autocomplete="tel">
              </div>

              <div class="col-md-6">
                <label for="survey-email" class="luxury-label">Email Address (Optional)</label>
                <input type="email" id="survey-email" name="email" class="luxury-input" placeholder="client@estate.com" autocomplete="email">
              </div>

              <div class="col-md-6">
                <label for="survey-city" class="luxury-label">Plot / Site Location *</label>
                <input type="text" id="survey-city" name="city" class="luxury-input" placeholder="Surat, Navsari, Ahmedabad, Mumbai, etc." required autocomplete="address-level2">
              </div>

              <div class="col-md-6">
                <label for="survey-pool-type" class="luxury-label">Architectural Pool Format</label>
                <select id="survey-pool-type" name="poolType" class="luxury-select">
                  <option value="Vanishing Edge Infinity Pool">Vanishing Edge Horizon Infinity Pool</option>
                  <option value="Luxury Residential Villa Pool">Luxury Residential Villa RCC Pool</option>
                  <option value="Rooftop / Penthouse Sky Pool">Rooftop / Penthouse Cantilevered Sky Pool</option>
                  <option value="Deck-Level Overflow Pool">Deck-Level Overflow Mirror Pool</option>
                  <option value="Commercial & Resort Swimming Pool">Commercial Resort & Club Lagoon</option>
                  <option value="Readymade FRP Fiberglass Pool">Readymade FRP Fiberglass Shell</option>
                  <option value="Hydrotherapy Jacuzzi & Thermal Spa">Hydrotherapy Jacuzzi & Thermal Spa</option>
                  <option value="Pool Renovation, Leak Repair & Retiling">Pool Renovation & Leak Proofing</option>
                  <option value="Annual Maintenance & AMC">Automated Chemical Dosing AMC</option>
                </select>
              </div>

              <div class="col-md-6">
                <label for="survey-dimensions" class="luxury-label">Approximate Size / Plot Area</label>
                <input type="text" id="survey-dimensions" name="poolDimensions" class="luxury-input" placeholder="e.g. 35ft x 18ft (or 800 sq.ft plot)">
              </div>

              <div class="col-12">
                <label for="survey-budget" class="luxury-label">Estimated Investment Tier (Optional)</label>
                <select id="survey-budget" name="budget" class="luxury-select">
                  <option value="">Select Estimated Investment Tier</option>
                  <option value="₹10L - ₹20L">₹10 Lakhs - ₹20 Lakhs (Compact Villa / FRP Shell)</option>
                  <option value="₹20L - ₹40L">₹20 Lakhs - ₹40 Lakhs (Luxury Residential Monolithic RCC)</option>
                  <option value="₹40L - ₹75L">₹40 Lakhs - ₹75 Lakhs (Infinity Horizon / Rooftop Sky Pool)</option>
                  <option value="₹75L+">₹75 Lakhs+ (Ultra-Luxury Estate / 5-Star Resort)</option>
                  <option value="Need Site Survey First">Need Engineer Survey & Recommendation First</option>
                </select>
              </div>

              <div class="col-12">
                <label for="survey-message" class="luxury-label">Site Elevation / Custom Requirements</label>
                <textarea id="survey-message" name="message" rows="3" class="luxury-textarea"
                  placeholder="Share details regarding slope elevation, glass view walls, cascading fountains, submerged sun loungers, or water heating..."></textarea>
              </div>

              <div class="col-12 pt-2">
                <button type="submit" class="luxury-cta-btn w-100 justify-content-center" style="padding: 15px; font-size: 1.02rem;">
                  <i class="bi bi-compass"></i> Request Free 3D Site Survey &amp; Blueprint
                </button>
              </div>

              <div class="col-12 text-center text-muted small mt-2">
                <i class="bi bi-shield-check text-gold me-1"></i> No obligation • 100% Free on-site feasibility report
              </div>

            </div>
          </form>

        </div>
      </div>

    </div>
  </div>
</section>

<%- include('layouts/footer') %>
